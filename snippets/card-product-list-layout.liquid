      {% endif %}
      <template x-if="localStorage.getItem('selectedStore')">
        <div id="x-availability-notice-{{ section.id }}" class="flex items-center flex-wrap gap-1{% unless content_alignment == 'right' %} justify-{{ content_alignment }}{% endunless %} rtl:flex-row-reverse md:rtl:list-layout:flex-row md:list-layout:justify-start{% unless content_alignment == 'right' %} justify-{{ content_alignment }}{% else %} rtl:justify-right{% endunless %}{% if content_alignment == 'right' %} flex-row-reverse rtl:flex-row md:list-layout:flex-row{% endif %}" x-show="$store.xStoreSelector?.canShow('{{ card_product_id }}', [{{ card_product.collections | map: 'id' | join: ', ' }}])">
          {%- liquid 
            assign availabilities = first_variant.store_availabilities
            assign locations = availabilities | map: 'location' | map: 'name' | json
          -%}
          {%- if locations != blank -%}
            {% assign pickup_locations = availabilities | where: 'pick_up_enabled', true | map: 'location' | map: 'name' | json %}
            {% assign pickup_availabilites = availabilities | where: 'pick_up_enabled', true | map: 'available' | json %}
            {%- render 'availability-notice', locations: locations, pickup_locations: pickup_locations, pickup_availabilites: pickup_availabilites -%}
          {%- endif -%}
        </div>
      </template>
      <div class="bottom-card ltr flex flex-wrap justify-{{ content_alignment }} md:list-layout:justify-start rtl:md:list-layout:justify-end mb-2.5 gap-1 empty:hidden"></div>
    </div>
  </div>
  {%- if variant_available and only_default_variant == false -%}
    <div
      id="choose-options-{{ section_id }}-{{ card_product_id }}-{{ block_id }}"
      class="hidden md:block absolute w-full min-h-full h-full left-0 top-0 bg-[rgba(var(--background-color))] z-[15] md:list-layout:w-3/5 list-layout:lg:w-3/4{% if is_rtl %} md:list-layout:right-auto md:list-layout:left-0{% else %} md:list-layout:left-auto md:list-layout:right-0{% endif %}"
      x-show="showOptions"
      x-transition:enter="transition-all ease-in-out duration-300"
      x-transition:enter-start="opacity-0 transform translate-y-full"
      x-transition:enter-end="opacity-100 transform translate-y-0"
      x-transition:leave="transition-all ease-in-out duration-300"
      x-transition:leave-start="opacity-100 transform translate-y-0"
      x-transition:leave-end="opacity-0 transform translate-y-full"
      x-cloak
    >
      <div :class="listLayout ? 'list-layout' : 'grid-layout'" class="choose-options relative w-full min-h-full h-full"></div>
      <div class="icon-loading hidden absolute top-0 left-0 right-0 h-full w-full z-20 bg-[rgba(var(--background-color))]">
        <div
          class="lg:inline-block w-4 h-4 md:w-5 md:h-5 absolute top-[calc(50%-8px)] left-[calc(50%-8px)] md:top-[calc(50%-10px)] md:left-[calc(50%-10px)]">
          {% render 'icon-alls', icon: 'icon-loading' %}
        </div>
      </div>
    </div>
  {%- endif -%}
  {% comment %} Show the product details when card product is in list view {% endcomment %}
  <div
    id="x-product-template-{{ card_product_id }}-{{ section_id }}-{{ product_card_id }}"
    class="grow flex flex-col md:list-layout:block list-layout:lg:w-3/4 md:list-layout:w-3/5 list-layout:md:pl-0 rtl:list-layout:md:pl-5 rtl:list-layout:md:pr-0 text-{{ content_alignment }}{% if is_rtl %} md:list-layout:text-right{% endif %}"
  >
    <div class="card-info hidden md:list-layout:block pt-5 md:list-layout:pt-0 md:list-layout:lg:pt-0{% if card_full_width %} pl-5 pr-5 md:pl-0 md:pr-0{% endif %}">
      <div class="no-collage:mb-2 text-{{ content_alignment }}{% unless is_rtl %} md:list-layout:text-left{% else %} md:list-layout:text-right{% endunless %}">
        {% if show_highlighted_features and settings.highlighted_features_position == "top_card" %}
          {% render 'highlighted-features', card_product: card_product %}
        {% endif %}
        <div class="below-image ltr flex flex-wrap justify-{{ content_alignment }} md:list-layout:justify-start rtl:md:list-layout:justify-end mb-2.5 gap-1 empty:hidden"></div>
        {%- if show_vendor -%}
          <div class="mb-2.5 uppercase tracking-widest {% if mediaGallery %}card-product-vendor-text-{{ block_id }}{% endif %} p-break-words">{{ card_product.vendor }}</div>
        {%- endif -%}
        <p class="card__heading h5 no-collage:mb-2 mb-2.5 leading-tight"{% if card_product.featured_media %} id="title-{{ section_id }}-{{ card_product_id }}"{% endif %}>
          <a href="{{ card_product.url | within: url_collection }}"
            class="x-card-title full-unstyled-link link-product-variant {% if mediaGallery %}card-product-title-text-{{ block_id }}{% endif %} text-[rgba(var(--colors-heading))] hover:text-[rgba(var(--colors-text-link))] cursor-pointer duration-200 p-break-words"
            @click='$store.xCustomerEvent.fire("product_selected", $el)'
            x-customer-event-data="{{ data_for_customer_event | escape }}"
          >
            {{ card_product.title | escape }}
          </a>
        </p>
        {% if show_highlighted_features and settings.highlighted_features_position == "below_title" %}
          {% render 'highlighted-features', card_product: card_product %}
        {% endif %}
        {%- if show_rating -%}
          {% render 'review-product', product: card_product, content_alignment: content_alignment, card_product: true %}
        {%- endif -%}
        <div class="relative">
          <div :class="loadingProductEls === '{{ section_id }}-{{ product_card_id }}' && 'animate-Xpulse-fast'" class="{% if mediaGallery %} card-product-price-text-{{ block_id }} {% endif %}x-card-price flex items-center mb-2.5 flex-wrap gap-1{% unless content_alignment == 'right' %} justify-{{ content_alignment }} rtl:flex-row-reverse md:rtl:list-layout:flex-row md:list-layout:justify-start{% endunless %}{% if content_alignment == 'right' %} flex-row-reverse rtl:flex-row md:list-layout:flex-row{% endif %}">
            {% assign price_id = section_id | append: '-' | append: product_card_id %}
            {% if card_product.options_with_values.size == swatch_count and settings.default_select_available_variant %}
              {% render 'price', product: card_product, use_variant: true, container: 'main-product-price' %}
            {% elsif settings.default_select_available_variant %}
              {% render 'price', priceID: price_id, product: card_product, show_price_range: show_price_range, price_range_once: true %}
            {% else %}
              {% render 'price', priceID: price_id, product: card_product, show_price_range: show_price_range %}
            {% endif %}
            <div class="leading-none next-price empty:hidden flex flex-wrap gap-x-1 gap-y-2"></div>
          </div>
        </div>
        {% if show_highlighted_features and settings.highlighted_features_position == "below_price" %}
          {% render 'highlighted-features', card_product: card_product %}
        {% endif %}
        <template x-if="localStorage.getItem('selectedStore')">
          <div id="x-availability-notice-{{ section.id }}" class="flex items-center flex-wrap gap-1{% unless content_alignment == 'right' %} justify-{{ content_alignment }}{% endunless %} rtl:flex-row-reverse md:rtl:list-layout:flex-row md:list-layout:justify-start{% unless content_alignment == 'right' %} justify-{{ content_alignment }}{% else %} rtl:justify-right{% endunless %}{% if content_alignment == 'right' %} flex-row-reverse rtl:flex-row md:list-layout:flex-row{% endif %}" x-show="$store.xStoreSelector?.canShow('{{ card_product_id }}', [{{ card_product.collections | map: 'id' | join: ', ' }}])">
            {%- liquid 
              assign availabilities = first_variant.store_availabilities
              assign locations = availabilities | map: 'location' | map: 'name' | json
              assign pickup_locations = availabilities | where: 'pick_up_enabled', true | map: 'location' | map: 'name' | json
              assign pickup_availabilites = availabilities | where: 'pick_up_enabled', true | map: 'available' | json
            -%}
            {%- if locations != blank -%}
              {%- render 'availability-notice', locations: locations, pickup_locations: pickup_locations, pickup_availabilites: pickup_availabilites -%}
            {%- endif -%}
          </div>
        </template>
      </div>
    </div>
    {% if show_description and card_product.description != blank %}
      <div class="hidden md:list-layout:block md:list-layout:mt-0 mt-4{% if is_rtl %} md:list-layout:text-right{% else %} md:list-layout:text-left{% endif %}">
        <div class="rte line-clamp-3">
          {{ card_product.description | replace: '<img', '<noimg' | replace: '</img>', '</noimg>' | replace: '<iframe', '<noiframe' | replace: '</iframe>', '</noiframe>' | replace: 'src=', 'nosrc=' | replace: '<h1', '<p class="h2"' | replace: '<h2', '<p class="h2"' | replace: '<h3', '<p class="h3"' | replace: '<h4', '<p class="h4"' | replace: '<h5', '<p class="h5"' | replace: '<h6', '<p class="h6"' }}
        </div>
      </div>
    {% endif %}
    {% unless disable_color_swatch %}
      {%- if swatch_enabled and only_default_variant == false -%}
        <div
          class="x-variants-data hover-option-value x-variants-data-js {% if settings.show_variant_option %}x-variants-separator{% endif %} x-variants-separator-{{ section.id }}-{{ card_product.id }} relative{% if swatch_count > 0 %} pt-3 mt-3{% endif %}"
          x-data='xVariantSelectCard($el,"{{ section_id }}-{{ product_card_id }}", "{{ card_product.id }}", "{{ card_product_url }}", false, false, false, "", "", "", "", "{{ section.id }}")'
          {% for option in card_product.options_with_values %}
            data-option{{ forloop.index }}="{{ option.selected_value | escape }}"
          {% endfor %}  
          data-url="{{ card_product.url }}"
          x-intersect.margin.200px="if (document.getElementById('variant-update-{{ section_id }}-{{ product_card_id }}').innerHTML.trim() == '') $el.classList.add('hidden');"
        >
          <div
            id="current-variant-{{ section_id }}-{{ card_product_id }}-{{ block_id }}"
            class="current-variant hidden"
          >
            {%- if settings.default_select_available_variant or only_default_variant -%}{{ first_variant.id }}{%- endif -%}
          </div>
          <div
            id="variant-update-{{ section_id }}-{{ product_card_id }}"
            class="variant-update-{{ section_id }}-{{ product_card_id }} list-layout:md:text-left rtl:list-layout:md:text-right options-container"
          >
            {% if swatch_count > 0 %}
              {% style %}
                .x-variants-separator.x-variants-separator-{{ section.id }}-{{ card_product.id }}::before {
                  border-top-width: 1px;
                }
              {% endstyle %}
            {% endif %}
            {%- for option in card_product.options_with_values -%}
              {% liquid
                assign name = option.name | append: ',' | prepend: ','
               %}
              {% if swatch_options contains name %}
                {% assign option_index = forloop.index0 %}
                {% liquid 
                  assign quick_add_picker_type = settings.quick_add_picker_type
                  assign color_option_name_list = settings.color_option_name | append: ',' | prepend: ','
                  
                  assign is_color = false 
                  if color_option_name_list contains name and settings.swatches_type == 'color' or settings.swatches_type == 'both_text_and_color'
                    assign is_color = true
                  endif
                  
                  if quick_add_picker_type == 'button' and settings.max_swatch != 0 and option.values.size > settings.max_swatch
                    if is_color == false or is_color and settings.swatch_show_by_default == 0
                      assign quick_add_picker_type = 'dropdown'
                    endif
                  endif
                %}
                {%- if quick_add_picker_type == 'button' -%}
                  <fieldset
                    id="Option-{{ section_id }}-{{ product_card_id }}-{{ forloop.index0 }}"
                    data-option-title="{{ option.name | escape }}"
                    data-option-index="{{ forloop.index0 }}"
                    class="product-form__input pl-0 pt-2.5 quick-view:pb-2 eurus gap-x-2"
                    aria-label="{{ option.name | escape }}"
                    x-data="{activeSwatch: false}"
                    @click.capture="activeSwatch = false"
                    @click.outside="activeSwatch = false"
                  >
                    {% if settings.show_variant_option %}<div class="mb-2">{{ option.name }}</div>{% endif %}
                    <div class="inline-flex flex-wrap ltr items-center{% if is_color %} ml-0.5 mr-0.5 gap-2.5{% else %} gap-1.5{% endif %}{% if collage %} justify-{{ info_alignment }} rtl:justify-{% if info_alignment == 'center' %}center{% elsif info_alignment == 'left' %}right{% else %}left{% endif %}{% else %} justify-{{ settings.info_alignment_card_product }} rtl:justify-{% if settings.info_alignment_card_product == 'center' %}center{% elsif settings.info_alignment_card_product == 'left' %}right{% else %}left{% endif %}{% endif %} md:list-layout:justify-start rtl:md:list-layout:justify-end">
                      {%- liquid
                        assign color_option_values = settings.color_option_values | newline_to_br | strip_newlines | split: '<br />'
                        assign text_option_values = settings.text_option_values | newline_to_br | strip_newlines | split: '<br />'
                        if settings.products_color_swatches_style == 'round' 
                          assign class_swatch = ' rounded-full before:rounded-full'
                        elsif settings.edges_type == 'rounded_corners'
                          assign class_swatch = ' rounded-md overflow-hidden'
                        endif
                        if settings.swatch_show_by_default != 0
                          assign count_value = option.values.size
                          if count_value > settings.swatch_show_by_default
                            assign is_count = true
                            assign count_value = count_value | minus: settings.swatch_show_by_default
                          endif
                        endif

                        assign swatch_natural = false     
                        if settings.products_color_swatches_style == 'natural'
                          assign swatch_natural = true
                        endif
                        assign ratio_image = false

                        assign max_swatch = settings.swatch_show_by_default | minus: 1
                      %}
                      {% if is_color and settings.swatch_show_by_default != 0 %}
                        {% capture enable_count %}
                          <div class="relative inline-flex">
                            <div
                              {% unless disable_quickview %}
                                tabindex="0"
                                @click.prevent='$store.xQuickView && $store.xQuickView.open(); $store.xCustomerEvent.fire("product_selected", $el);'
                                @keydown.enter.prevent='$store.xQuickView && $store.xQuickView.open(); $store.xCustomerEvent.fire("product_selected", $el);'
                                x-on:mouseover="$store.xQuickView && $store.xQuickView.load('{{ card_product_url }}', $el, '{{ section_id }}-{{ card_product_id }}-{{ block_id }}')" 
                                x-on:focus="$store.xQuickView && $store.xQuickView.load('{{ card_product_url }}', $el, '{{ section_id }}-{{ card_product_id }}-{{ block_id }}')" 
                                :class="!$store.xQuickView.enabled ? 'pointer-events-none' : 'cursor-pointer'"
                              {% endunless %}
                              class="swatch-count-{{ settings.swatch_size }} color-watches {{ class_swatch }} flex"
                            >
                              <span class="grow pointer-events-none text-center leading-none content-center">+{{ count_value }}</span>
                            </div>
                          </div>
                        {% endcapture %}
                      {% endif %}
                      {%- for value in option.values -%}
                        <div @click="activeSwatch = {{ forloop.index }}" class="relative inline-flex">
                          {% liquid
                            assign variant_value = value.variant
                            assign preview_image = variant_value.featured_media.preview_image | default: card_product.featured_media
                            unless ratio_image
                              assign ratio_image = 100.0 | divided_by: preview_image.aspect_ratio
                            endunless

                            assign color_custom = ''
                            assign swatch_image = false
                            assign color_value = ''
                            if settings.color_option_values contains value
                              for color_option_value in color_option_values reversed
                                if color_option_value contains value
                                  assign color_option_key_value = color_option_value | split: ':'
                                  assign color_option_key = color_option_key_value | first
                                  if value == color_option_key
                                    assign color_custom = color_option_key
                                    assign option_value = color_option_key_value | last | strip
                                    assign color_value = option_value

                                    if option_value contains '.'
                                      assign swatch_image = true
                                    endif

                                    assign multi_colors = option_value | remove_first: '#' | split: '#'
                                    break
                                  endif
                                endif
                              endfor
                            endif
                          %}
                          {% if preview_image and settings.replace_color_with_variant_images %}
                            {% if settings.color_option_name contains option.name %}
                              {%- style %}
                                .color-watches.variant-{{ product_card_id }}-{{ option.position }}-{{ forloop.index0 }}-{{ card_product_id }}:before {
                                  background-image: var(--bg-image);
                                }
                              {%- endstyle %}
                            {% endif %}
                          {% elsif color_custom != '' %}
                            {%- style %}
                              {% if swatch_image %}
                                [data-swatch="{{ color_custom }}"]:before {
                                  background-image: url({{ color_value | file_img_url: "100x100" }});
                                }
                              {% elsif multi_colors.size == 3 %}
                                [data-swatch="{{ color_custom }}"]:before {
                                  background: linear-gradient(45deg, {{ '#' | append: multi_colors[0] }}, {{ '#' | append: multi_colors[0] }} 33.3%, {{ '#' | append: multi_colors[1] }} 33.3%, {{ '#' | append: multi_colors[1] }} 66.6%, {{ '#' | append: multi_colors[2] }} 66.6%, {{ '#' | append: multi_colors[2] }});
                                }
                              {% elsif multi_colors.size == 2 %}
                                [data-swatch="{{ color_custom }}"]:before {
                                  background: linear-gradient(45deg, {{ '#' | append: multi_colors[0] }}, {{ '#' | append: multi_colors[0] }} 50%, {{ '#' | append: multi_colors[1] }} 50%, {{ '#' | append: multi_colors[1] }});
                                }
                              {% else %}
                                [data-swatch="{{ color_custom }}"]:before {
                                  background: {{ color_value }};
                                }
                              {% endif %}
                            {%- endstyle %}
                          {% endif %}
                          <input 
                            id="{{ section_id }}-{{ product_card_id }}-{{ option.position }}-{{ forloop.index0 }}-{{ card_product_id }}"
                            data-available="{{ value.available }}"
                            data-product-url="{{ card_product.url }}"
                            data-option-value-id="{{ value.id }}"
                            section-id="{{ section_id }}-{{ product_card_id }}"
                            option-pos="{{ option.position }}"
                            forloop="{{ forloop.index0 }}"
                            type="radio"
                            name="{{ option.name }}-{{ product_card_id }}-{{ section_id }}"
                            value="{{ value | escape | replace: '&lt;', '\u003c' | replace: '&gt;', '\u003e' }}"
                            form="{{ product_form_id }}"
                            class="absolute opacity-0 h-1 w-1 input-radio{% unless value.available %} disabled{% endunless %}"
                            aria-label="{{ value | escape }}"
                            @keydown.enter.prevent="$el.click()"
                            @change="setTimeout(() => {  
                              const canLoad = updateProductCard('{{ swatch_count }}', '{{ value.product_url }}');
                              if (canLoad) {
                                loadingProductEls = '{{ section_id }}-{{ product_card_id }}';
                                loadingEls = '{{ section_id }}-{{ product_card_id }}-{{ option.position }}-{{ forloop.index0 }}-{{ card_product_id }}';
                              }
                            }, 0)"
                            {% if settings.default_select_available_variant and value == option.selected_value %}
                              checked
                            {% endif %}
                          >
                          {% if is_color %}
                            <label 
                              :class="activeSwatch == {{ forloop.index }} && 'active-swatch'"
                              class="color-watches hover-option variant-{{ product_card_id }}-{{ option.position }}-{{ forloop.index0 }}-{{ card_product_id }} cursor-pointer block{% if swatch_natural and settings.replace_color_with_variant_images and ratio_image %} color-swatch-natural{% endif %} swatch-{{ settings.swatch_size }} relative{{ class_swatch }}" 
                              for="{{ section_id }}-{{ product_card_id }}-{{ option.position }}-{{ forloop.index0 }}-{{ card_product_id }}" 
                              data-swatch="{{ color_custom }}"
                              data-optionindex="{{ option_index }}"
                              data-optionvalue="{{ value | escape | replace: '&lt;', '\u003c' | replace: '&gt;', '\u003e' }}"
                              data-option-value-id="{{ value.id }}"
                              {% if preview_image == blank or settings.replace_color_with_variant_images == false and color_custom == '' %}
                                {% liquid
                                  if value.swatch.image
                                    assign image_url = value.swatch.image | image_url: width: 50
                                    assign swatch_value = 'url(' | append: image_url | append: ')'
                                  elsif value.swatch.color
                                    assign swatch_value = 'rgb(' | append: value.swatch.color.rgb | append: ')'
                                  else
                                    assign swatch_value = value | split: ' ' | last | handle
                                  endif
                                %}
                                style="background: {{ swatch_value }};"
                              {% elsif swatch_natural and ratio_image %}
                                style="--ratio-image: {{ ratio_image }}%; --bg-image: url('{{ preview_image | image_url: width: 100, height: 100 }}')"
                              {% else %}
                                style="--bg-image: url('{{ preview_image | image_url: width: 100, height: 100 }}')"
                              {% endif %}
                              tabindex="0"
                              @keydown.enter.prevent="$el.click()"
                              data-name="{{ value | escape }}"
                              aria-label="{{ value | escape }}"
                            >
                              {% render 'hover-option-value-card-product', value: value %}
                              <span class="h-full w-full color-watches-disable"></span>
                            </label>
                          {% elsif settings.swatches_type == 'text' or settings.swatches_type == 'both_text_and_color' and settings.text_option_name contains option.name %}
                            {% liquid
                              assign text_custom = blank
                              assign text_value = ''
                              if settings.text_option_values contains value
                                for text_option_value in text_option_values
                                  if text_option_value contains value
                                    assign text_option_key_value = text_option_value | split: ':'
                                    assign text_option_key = text_option_key_value | first

                                    if text_option_key == value
                                      assign text_custom = text_option_key
                                      assign text_value = text_option_key_value | last
                                      break
                                    endif
                                  endif
                                endfor
                              endif
                            %}
                            <label class="flex relative items-center font-medium text-[13px] cursor-pointer{% if settings.info_alignment_card_product == 'right' %} rtl:mr-0{% endif %} pl-3.5 pr-3.5 pt-1.5 pb-1.5 border bg-[rgba(var(--background-color),1)]
                              {% if settings.edges_type == 'rounded_corners' %} rounded-md{% endif %}" 
                              for="{{ section_id }}-{{ product_card_id }}-{{ option.position }}-{{ forloop.index0 }}-{{ card_product_id }}"
                              data-option-value-id="{{ value.id }}"
                              tabindex="0"
                              @keydown.enter.prevent="$el.click()"
                            >
                              <span class="p-break-words">
                                {% if text_custom != blank %}{{ text_value | escape }}{% else %}{{ value | escape }}{% endif %}
                              </span>
                            </label>
                          {% endif %}
                          <script type="application/json" data-option-value-id="{{ value.id }}" data-resource="{{ section_id }}-{{ product_card_id }}-{{ option.position }}-{{ forloop.index0 }}-{{ card_product_id }}">
                            {{ value.variant | json }}
                          </script>
                        </div>
                        {% if is_color and settings.swatch_show_by_default != 0 %}
                          {% liquid
                            if forloop.index > max_swatch
                              if is_count
                                echo enable_count
                              endif
                              break
                            endif
                          %}
                        {% endif %}
                      {%- endfor -%}
                    </div>
                  </fieldset>
                {% else %}
                  <div 
                    data-option-name="{{ option.name | handle }}"
                    data-option-index="{{ forloop.index0 }}"
                    data-option-title="{{ option.name | escape }}"
                  >
                    {% if settings.show_variant_option %}
                      <label class="mt-1 mb-1 font-medium text-left rtl:text-right block" for="Option-{{ section.id }}-{{ forloop.index0 }}">
                        {{ option.name }}
                      </label>
                    {% endif %}
                    <div class="select relative outline-none eurus">
                      <select
                        id="Option-{{ section.id }}-{{ forloop.index0 }}"
                        class="product-form__input w-full pt-2.5 pb-2.5 pl-5 pr-8 rtl:pr-5 rtl:pl-8 mt-2 mb-2 bg-transparent focus:border-current border appearance-none outline-none border-solid focus-visible:outline-none cursor-pointer{% if settings.edges_type == 'rounded_corners' %} !rounded-md{% endif %}"
                        name="{{ option.name }}"
                        form="{{ product_form_id }}"
                        @change="setTimeout(() => {
                          Array.from($el.options).forEach(option => { option.removeAttribute('selected') });
                          $el.options[$el.selectedIndex].setAttribute('selected', 'selected');
                          const canLoad = updateProductCard('{{ swatch_count }}', '{{ card_product.url }}');
                          if (canLoad) {
                            loadingProductEls = '{{ section_id }}-{{ product_card_id }}';
                            loadingEls = '{{ section_id }}-{{ product_card_id }}-{{ option.position }}-{{ forloop.index0 }}-{{ card_product_id }}';
                          }
                        }, 0)"
                      > 
                        {%- liquid
                          assign enable_color_swatches = false
                          if swatch_enabled and settings.swatches_type == 'color' and settings.color_option_name contains option.name
                            assign enable_color_swatches = true
                          endif
                        -%}
                        {% render 'product-variant-options',
                          product: card_product,
                          option: option,
                          option_index: option_index,
                          product_form_id: product_form_id,
                          input_type: 'select',
                          enable_color_swatches: enable_color_swatches
                        %}
                      </select>
                      <div x-cloak x-show="loadingEls === '{{ section_id }}-{{ product_card_id }}-{{ option.position }}-{{ forloop.index0 }}-{{ card_product_id }}'" class="w-4 h-4 absolute top-1/2 right-3 rtl:right-auto rtl:left-3 -translate-y-1/2">
                        <div class="animate-spin w-4 h-4 border-loading"></div>
                      </div>
                      <span x-cloak x-show="loadingEls !== '{{ section_id }}-{{ product_card_id }}-{{ option.position }}-{{ forloop.index0 }}-{{ card_product_id }}'" class="absolute top-1/2 right-4 rtl:right-auto rtl:left-4 -translate-y-1/2 w-2.5 inline-block pointer-events-none">
                        {% render 'icon-alls', icon: 'icon-caret' %}
                      </span>
                    </div>
                  </div>
                {% endif %}
              {% elsif settings.swatches_type == 'both_text_and_color' %}
                {%- assign option_index = forloop.index0 -%}
                <fieldset
                  id="Option-{{ section_id }}-{{ product_card_id }}-{{ forloop.index0 }}"
                  data-option-title="{{ option.name | escape }}"
                  data-option-index="{{ forloop.index0 }}"
                  class="product-form__input eurus hidden"
                  aria-label="{{ option.name | escape }}"
                >
                  <div class="inline-flex flex-wrap justify-left">
                    {%- for value in option.values -%}
                      {% if forloop.first %}
                        <input 
                          id="{{ section_id }}-{{ product_card_id }}-{{ option.position }}-{{ forloop.index0 }}-{{ card_product_id }}"
                          data-available="{{ value.available }}"
                          data-product-url="{{ card_product.url }}"
                          data-option-value-id="{{ value.id }}"
                          section-id="{{ section_id }}-{{ product_card_id }}"
                          option-pos="{{ option.position }}"
                          forloop="{{ forloop.index0 }}"
                          type="radio"
                          name="{{ option.name }}-{{ product_card_id }}-{{ section_id }}"
                          value="{{ value | escape | replace: '&lt;', '\u003c' | replace: '&gt;', '\u003e' }}"
                          form="{{ product_form_id }}"
                          class="absolute opacity-0 h-1 w-1 input-radio"
                          aria-label="{{ value | escape }}"
                          @change="setTimeout(() => { 
                            const canLoad = updateProductCard('{{ swatch_count }}', '{{ card_product.url }}');
                            if (canLoad) {
                              loadingProductEls = '{{ section_id }}-{{ product_card_id }}';
                              loadingEls = '{{ section_id }}-{{ product_card_id }}-{{ option.position }}-{{ forloop.index0 }}-{{ card_product_id }}';
                            }
                          }, 0)"
                          {% if settings.default_select_available_variant %}
                            checked
                          {% endif %}
                        >  
                        <label class="flex relative items-center outline-none font-medium text-[13px] cursor-pointer mr-[5px]{% if settings.info_alignment_card_product == 'right' %} rtl:mr-0 rtl:ml-1.5{% endif %} pl-3.5 pr-3.5 pt-1.5 pb-1.5 border bg-[rgba(var(--background-color),1)]
                          {% if rounded_corner %} rounded-md{% endif %}" for="{{ section_id }}-{{ product_card_id }}-{{ option.position }}-{{ forloop.index0 }}-{{ card_product_id }}"
                          data-option-value-id="{{ value.id }}"
                        >
                          <span class="p-break-words">{{ value | escape }}</span>
                        </label>
                      {% endif %}
                      <script type="application/json" data-option-value-id="{{ value.id }}" data-resource="{{ section_id }}-{{ product_card_id }}-{{ option.position }}-{{ forloop.index0 }}-{{ card_product_id }}">
                        {{ value.variant | json }}
                      </script>
                    {% endfor %}
                  </div>
                </fieldset>
              {% endif %}
            {%- endfor -%}
          </div>
        </div>
      {% else %}
        <div class="hidden" @init-run="document.addEventListener('eurus:cart:items-changed', () => {
          Alpine.store('xUpdateVariantQuanity').updateQuantity('{{ section.id }}', '{{ card_product.url }}');
        });"></div>
        <div
          id="current-variant-{{ section_id }}-{{ card_product_id }}-{{ block_id }}"
          class="current-variant hidden"
        >
          {%- if settings.default_select_available_variant or only_default_variant -%}{{ first_variant.id }}{%- endif -%}
        </div>
      {%- endif -%}
    {% endunless %}
    <div class="bottom-card mt-2.5 hidden md:list-layout:flex card-info ltr flex-wrap justify-{{ content_alignment }} md:list-layout:justify-start rtl:md:list-layout:justify-end gap-1 md:list-layout:empty:hidden"></div>
    {% if show_highlighted_attributes %}
      <div class="card-info x-highlight-icon">
        {% render 'highlight-icon-card-product', card_product: card_product, content_alignment: content_alignment %}
      </div>
    {% endif %}
    {% unless disable_quickview %}
      <template x-if="$store.xQuickView">
        <div class="flex md:list-layout:justify-start md:list-layout:flex-row grow flex-col justify-end gap-3 md:list-layout:mt-4" x-cloak x-show="$store.xQuickView">
          {%- capture b2b_price_hidden -%}
            {%- render 'b2b-price-hidden', product: card_product -%}
          {%- endcapture -%}
          {%- unless settings.hide_cart or b2b_price_hidden contains 'true' -%} 
            <div x-data="xProductCart" class="card-product-list-atc pt-3" x-cloak x-show="$store.xQuickView.show_atc_button" :class="if($store.xQuickView.show_atc_button){ return ($store.xQuickView.btn_atc_bottom ? '' : 'hidden') + ($store.xQuickView.atc_btn_image_desktop ? ' lg:hidden' : ' lg:block')}">
              {% if card_product.options_with_values.size == swatch_count or only_default_variant %}
                {%- assign product_form_id = 'product-form-choose-option' | append: card_product_id | append: index_param -%}
                {%- form 'product', card_product, id: product_form_id, class: 'form h-full', novalidate: 'novalidate', data-type: 'add-to-cart-form', x-ref: 'product_form' -%}
                  <input type="hidden" aria-hidden="true" name="id" value="{{ first_variant.id }}">
                  {% if settings.show_in_cart_items != 'none' %}
                    {% render 'estimate-shipping-cart', product: card_product, message: settings.message_estimate_cart, disable_cart_edt: disable_cart_edt %}
                  {% endif %}
                  {% if can_show_preorder %}
                    <input name="properties[{{ 'general.preorder.name' | t }}]" aria-label="{{ 'general.preorder.name' | t }}" class="hidden" value="{{ message_preorder }}"/>
                  {% endif %}
                  <button
                    type="submit"
                    name="add"
                    {%- if only_default_variant or variant_available == false or swatch_enabled -%}
                      @click.prevent="errorMessage == false && addToCart($event)"
                    {%- else -%}
                      @click.prevent="setTimeout(() => { $store.xQuickView && (showOptions = !showOptions); $store.xQuickView.showChooseOption('{{ section_id }}-{{ card_product_id }}-{{ block_id }}', $el); }, 0)"
                      x-on:mouseover="setTimeout(() => { $store.xQuickView && $store.xQuickView.loadChooseOptions('{{ card_product_url }}', $el, '{{ section_id }}-{{ card_product_id }}-{{ block_id }}', {{ index_param }}); }, 0)"
                    {%- endif -%}
                    x-cloak
                    data-id="{{ section_id }}-{{ card_product_id }}-{{ block_id }}"
                    class="button button--quickview button-solid not-icon leading-normal w-full pt-2.5 pb-2.5 pl-5 pr-5 lg:pt-3 lg:pb-3 h-full z-10 text-[12px] lg:text-[14px] lg:-translate-x-0 disabled:cursor-not-allowed disable-action-btn-animation disabled:opacity-60"
                    {% if insurance_enabled and insurance_default and shipping_insurance %}
                      @init-run.window="loadInsurance('{{ shipping_insurance }}')"
                    {% endif %}
                    {% if insurance_enabled and product_insurance != blank and product_insurance.id == card_product_id %}
                      style="display: none;"
                    {% endif %}
                    :class="[errorMessage && 'opacity-60 cursor-not-allowed', $store.xQuickView.atc_btn_image_desktop ? 'md:hidden md:list-layout:block' : 'md:block', $store.xQuickView.btn_atc_bottom ? 'block' : 'hidden']"
                    {% if variant_available == false %}
                      disabled
                      aria-label="{{ sold_out_text }}"
                    {% elsif only_default_variant or swatch_enabled %}
                      aria-label="{{ atc_text }}"
                    {% else %}
                      aria-label="{{ choose_option_text }}"
                    {% endif %}
                    {% unless settings.default_select_available_variant or only_default_variant %}
                      disabled
                    {% endunless %}
                  >
                    <span :class="{ 'lg:block opacity-0 is-focus-button' : loading, 'hidden' : errorMessage}">
                      {% if settings.default_select_available_variant or only_default_variant %}
                        {%- if variant_available -%}
                          {% liquid
                            assign button_label = choose_option_text
                            if only_default_variant or swatch_enabled
                              assign button_label = atc_text
                              if can_show_preorder
                                assign button_label = 'products.product.pre_order' | t
                                if settings.card_button_preorder != blank
                                  assign button_label = settings.card_button_preorder
                                endif
                              endif
                            endif
                          %}
                          <span class="flex items-center justify-center">
                            {% render 'button-label', button_label: button_label, show_button_style: 'primary' %}
                          </span>
                        {%- else -%}
                          {{ sold_out_text }}
                        {%- endif -%}
                      {% else %}
                        {% liquid
                          assign button_label = atc_text
                        %}
                        <span class="flex items-center justify-center">
                          {% render 'button-label', button_label: button_label, show_button_style: 'primary' %}
                        </span>
                      {% endif %}
                    </span>
                    <div
                      class="flex gap-x-2 items-center justify-center"
                      role="alert"
                      x-cloak
                      x-show="errorMessage"
                    >
                      {{ sold_out_text }}
                    </div>
                    <div class="lg:inline-block w-4 h-4 md:w-5 md:h-5 absolute top-[calc(50%-8px)] left-[calc(50%-8px)] md:top-[calc(50%-10px)] md:left-[calc(50%-10px)]" x-show="loading" x-cloak>
                      {% render 'icon-alls', icon: 'icon-loading' %}
                    </div>
                  </button>
                {%- endform -%}
              {% else %}
                <button
                  type="submit"
                  name="add"
                  @click.prevent="setTimeout(() => { $store.xQuickView && (showOptions = !showOptions); $store.xQuickView.showChooseOption('{{ section_id }}-{{ card_product_id }}-{{ block_id }}', $el); }, 0)"
                  x-on:mouseover="setTimeout(() => { $store.xQuickView && $store.xQuickView.loadChooseOptions('{{ card_product_url }}', $el, '{{ section_id }}-{{ card_product_id }}-{{ block_id }}', {{ index_param }}); }, 0)" 
                  data-id="{{ section_id }}-{{ card_product_id }}-{{ block_id }}"
                  class="button button--quickview button-solid not-icon leading-normal w-full pt-2.5 pb-2.5 lg:pl-5 lg:pr-5 lg:pt-3 lg:pb-3 h-full text-[12px] lg:text-[14px] lg:-translate-x-0 disabled:cursor-not-allowed disabled:opacity-60"
                  :class="[errorMessage && 'opacity-60 cursor-not-allowed', $store.xQuickView.atc_btn_image_desktop ? 'md:hidden md:list-layout:block' : 'md:block', $store.xQuickView.btn_atc_bottom ? 'block' : 'hidden']"
                  aria-label="{{ choose_option_text }}"
                >
                  <span :class="{ 'lg:block opacity-0 is-focus-button' : loading, 'hidden' : errorMessage}">
                    {% assign button_label = choose_option_text %}
                    <span class="flex items-center justify-center">
                      {% render 'button-label', button_label: button_label, show_button_style: 'primary' %}
                    </span>
                  </span>
                  <div class="lg:inline-block w-4 h-4 md:w-5 md:h-5 absolute top-[calc(50%-8px)] left-[calc(50%-8px)] md:top-[calc(50%-10px)] md:left-[calc(50%-10px)]" x-show="loading" x-cloak>
                    {% render 'icon-alls', icon: 'icon-loading' %}
                  </div>
                </button>
              {% endif %} 
            </div>
          {%- endunless -%} 
          <button 
            x-on:mouseover="$store.xQuickView && $store.xQuickView.load('{{ card_product_url }}', $el, '{{ section_id }}-{{ card_product_id }}-{{ block_id }}')" 
            x-on:focus="$store.xQuickView && $store.xQuickView.load('{{ card_product_url }}', $el, '{{ section_id }}-{{ card_product_id }}-{{ block_id }}')" 
            @click.prevent='$store.xQuickView && $store.xQuickView.open(); $store.xCustomerEvent.fire("product_selected", $el);' 
            class="button label-btn-quickview button-solid button--quickview leading-normal none_border pt-2 pl-5 pb-2 pr-5 lg:pt-3 lg:pb-3 not-icon md:list-layout:flex hidden" 
            aria-label="{{ 'products.product.button_quickview' | t }}"
            x-customer-event-data="{{ data_for_customer_event | escape }}"
            x-show="$store.xQuickView.enabled"
          >
            <span class="flex justify-center items-center">
              {% render 'button-label', x_text_quickview: true, show_button_style: 'primary' %}
            </span>
          </button>
        </div>
      </template>
    {% endunless %}
  </div>
</div>
{%- if enable_b2b -%}
{% style %}
  .card-product-b2b-list-view {
    --color-highlight: {{ settings.colors_heading_highlight.red }}, {{ settings.colors_heading_highlight.green }}, {{ settings.colors_heading_highlight.blue }};
  }
  @media (min-width: 768px) {
    .card-product-b2b-list-view .grid-template-columns-product {
      grid-template-columns: calc((100% - 336px) / 5) 1fr;
    }
  }
{% endstyle %}
<div class="hidden list-layout:block">
  <div 
    x-data="xProductCartB2B('{{ section_id }}-{{ card_product_id }}-{{ block_id }}')" 
    id="x-product-cart-{{ section_id }}-{{ card_product_id }}-{{ block_id }}"
    x-intersect.once.margin.200px="addListener(); updateInfoFollowCartQty('{{ section_id }}', '{{ card_product_id }}-{{ block_id }}')"
  >  
    <div class="card-product-b2b-list-view border-solid border-1 border-[rgb(var(--colors-line-and-border))]{% if settings.edges_type == 'rounded_corners' %} rounded-[10px]{% endif %}">
      {%- if card_product != blank -%}
        {%- assign card_view_context = standard_event_context | default: 'collection' -%}
        <s-view-event
          data-view-on-intersect
          data-view-key="card-{{ section_id }}-{{ card_product_id }}-{{ block_id }}-{{ card_product.id }}"
          view-event-trigger="manual"
          view-event-payload='{{ card_product | standard_event_data: "view", context: card_view_context | escape }}'></s-view-event>
      {%- endif -%}
      {% assign product_form_id = 'product-form-' | append: section.id | append: product.id %}
      {%- form 'product', card_product, id: product_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form', x-ref: 'product_form' -%}
        {% if settings.show_in_cart_items != 'none' %}
          <div class="hidden" id="cart-edt-{{ section_id }}">
            {% render 'estimate-shipping-cart', product: product, message: settings.message_estimate_cart, disable_cart_edt: disable_cart_edt %}
          </div>
        {% endif %}
        {% if settings.preorder_show != 'no' %}
          <div class="hidden" id="preorder-{{ section_id }}">
            {% if can_show_preorder %}
              {% liquid  
                assign message_preorder = 'general.preorder.message_preorder' | t
                if settings.message_preorder != blank
                  assign message_preorder = settings.message_preorder
                endif 
              %}
              <input name="properties[{{ 'general.preorder.name' | t }}]" aria-label="{{ 'general.preorder.name' | t }}" class="hidden" value="{{ message_preorder }}"/>
            {% endif %}
          </div>
        {% endif %}
        <div :class="showOptions ? 'md:bg-[rgba(var(--colors-background-secondary))]' : 'bg-[rgba(var(--colors-background))]'" class="card-product-header flex justify-between items-center gap-2 md:gap-7 pt-4 pb-4 pl-4 pr-4 self-stretch {% if settings.edges_type == 'rounded_corners' %} rounded-t-[10px]{% endif %} transition-all duration-300 ease-in"
          {%- if card_product.variants_count > 1 -%}
            x-on:mouseover.once="setTimeout(() => {loadChooseOptionsB2B('{{ card_product_url }}', $el, '{{ section_id }}-{{ card_product_id }}-{{ block_id }}', {{ index_param }}) }, 0)"
          {%- endif -%}
        >
          <div class="flex gap-4 items-center justify-stretch w-full min-w-0">
            <div class="image-product aspect-square relative self-start md:self-center md:w-32 md:h-32 md:min-w-32 min-w-18 w-18 h-18 cursor-zoom-in{% if animation_loading and loading != 'eager' %} animate_transition_card__image{% endif %} overflow-hidden{% if show_rounded_image %} rounded-lg{% endif %} " 
              {% if card_product.featured_media %}@click="zoomMedia = true; $store.xPopup.open = true"{% endif %}
            >
              {% if card_product.featured_media %}
                {% liquid
                  if card_product.featured_media
                    assign featured_media = card_product.featured_media
                    if product_featured_image_mtf != blank and card_product.metafields.custom[product_featured_image_mtf]
                      assign featured_media = card_product.metafields.custom[product_featured_image_mtf]
                    endif
                  endif
                %}
                <picture>
                  <img
                    srcset="{{ featured_media | image_url: width: 225 }} 225w,
                      {{ featured_media | image_url: width: 375 }} 375w,
                      {{ featured_media | image_url: width: 450 }} 450w,
                      {{ featured_media | image_url: width: 750 }} 750w,
                      {{ featured_media | image_url: width: 900 }} 900w,
                      {{ featured_media | image_url: width: 1100 }} 1100w,
                      {{ featured_media | image_url: width: 1500 }} 1500w
                      {% if featured_media.width %},{{ featured_media | image_url }} {{ featured_media.width }}w{% endif %}" 
                    src="{{ featured_media | image_url: width: 1080 }}"
                    sizes="(min-width: 768px) 128px, 64px"
                    alt="{{ featured_media.alt | escape }}"
                    class="w-full h-full object-cover bg-[#c9c9c9] img-thumbnail{% if show_rounded_image %} rounded-lg{% endif %} {% unless product_featured_image_mtf != blank and card_product.metafields.custom[product_featured_image_mtf] %} preview-img{% endunless %} motion-reduce animate-Xpulse skeleton-image image-hover
                    {%- if animation_loading and loading != 'eager' %} animate_transition_image{% endif -%}"
                    {% if settings.enable_lazy_loading_image %}loading="lazy"{% else %}loading="eager"{% endif %}
                    width="{{ featured_media.width }}"
                    height="{{ featured_media.height }}"
                    onload="requestAnimationFrame(() => {
                      {% if animation_loading and loading != 'eager' %}this?.classList.add('active');{% endif -%}
                      this.closest('.skeleton-image')?.classList.remove('animate-Xpulse', 'skeleton-image');
                      setTimeout(() => { this.closest('.animate_transition_card__image')?.classList.add('lazy_active', 'active'); }, 250);
                    })"
                  >
                </picture>
              {% else %}
                <div 
                  class='bg-[#c9c9c9] flex justify-center absolute top-0 left-0 w-full h-full items-center'
                  x-init="$el.closest('.skeleton-image')?.classList.remove('animate-Xpulse', 'skeleton-image')"
                >
                  {%- render 'icon-placeholder', icon: 'icon-product', class: 'w-full h-full' %}
                </div> 
              {% endif %}
            </div>
            <template x-teleport="body">
              <div
                x-show="zoomMedia"
                class="fixed top-0 left-0 bottom-0 right-0 bg-[rgba(var(--background-color),1)] z-[9999] cursor-zoom-out pt-16 pb-16" 
                @click="zoomMedia = false; $store.xPopup.open = false"
                x-transition:enter="transition-all ease-in-out duration-500"
                x-transition:enter-start="opacity-0 transform translate-y-1/3"
                x-transition:enter-end="opacity-100 transform translate-y-0"
                x-transition:leave="transition-all ease-in-out duration-500"
                x-transition:leave-end="opacity-0 transform translate-y-1/3"                
              >
                <div class="flex items-center justify-center h-full">
                  <img
                    srcset="{{ featured_media | image_url: width: 375 }} 375w,
                      {{ featured_media | image_url: width: 450 }} 450w,
                      {{ featured_media | image_url: width: 750 }} 750w,
                      {{ featured_media | image_url: width: 900 }} 900w,
                      {{ featured_media | image_url: width: 1100 }} 1100w,
                      {{ featured_media | image_url: width: 1500 }} 1500w,
                      {{ featured_media | image_url: width: 1780 }} 1780w,
                      {{ featured_media | image_url: width: 2000 }} 2000w,
                      {{ featured_media | image_url: width: 3000}} 3000w
                      {% if featured_media.width %},{{ featured_media | image_url }} {{ featured_media.width }}w{% endif %}" 
                    src="{{ featured_media | image_url: width: 1200 }}"
                    alt="{{ featured_media.alt | escape }}"
                    class="w-full h-full max-w-3xl object-contain"
                    {% if settings.enable_lazy_loading_image %}loading="lazy"{% else %}loading="eager"{% endif %}
                    width="{{ featured_media.width }}"
                    height="{{ featured_media.height }}"
                  >
                </div>
              </div>
            </template>
            <div class="grid{% if card_product.variants_count > 1 %} md:grid-cols-2{% else %} grid-template-columns-product{% endif %} gap-x-2 lg:gap-x-7 gap-y-1 items-start md:items-center grow md:pr-5 pr-0 rtl:md:pr-0 rtl:md:pl-5">
              <div class="product-infor flex flex-col gap-1 items-start">
                <div class="product-title flex gap-3">
                  <p class="card__heading h5 leading-6.5"{% if card_product.featured_media %} id="title-{{ section_id }}-{{ card_product_id }}"{% endif %}>
                    <a href="{{ card_product.url | within: url_collection }}"
                      class="x-card-title full-unstyled-link link-product-variant {% if mediaGallery %}card-product-title-text-{{ block_id }}{% endif %} text-[rgba(var(--colors-heading))] hover:text-[rgba(var(--colors-text-link))] cursor-pointer duration-200 overflow-wrap"
                      @click='$store.xCustomerEvent.fire("product_selected", $el)'
                      x-customer-event-data="{{ data_for_customer_event | escape }}"
                    >
                      {{ card_product.title | escape }}
                    </a> 
                  </p>
                  <div class="inventory-status-{{ section_id }}-{{ card_product_id }}-{{ block_id }}"></div>
                </div>
                {% if card_product.variants_count > 1 %}
                  <div class="product-info flex"> {{ card_product.variants_count }} {{ 'products.product.variants' | t }}</div>
                {% else %}
                  {% if card_product.selected_or_first_available_variant.sku != blank and card_product.variants_count <= 1 %}<div class="mr-2">{{ 'customer.order.sku' | t }}: {{ card_product.selected_or_first_available_variant.sku }}</div>{% endif %}    
                {% endif %}
              </div>
              {% if card_product.variants_count > 1 %} 
                <div class="product-price text-left rtl:text-right md:text-right grow">
                  {% liquid 
                    assign price = card_product.price_min
                    if settings.currency_code_enable 
                     assign price = price | money_with_currency 
                    else 
                     assign price = price | money
                    endif
                  %}
                  <div class="font-semibold leading-6.5 text-[110%]">{{ 'products.product.price.from_price_html' | t: price: price }}</div>
                </div>
              {% else %}
                <input type="hidden" aria-hidden="true" id="update-variant-{{ section.id }}-{{ variant.id }}" name="id" value="{{ variant.id }}">
                {% liquid
                  assign variant = card_product.selected_or_first_available_variant
                  assign cart_qty_variant = 0
                  for item in cart.items
                    if item.variant_id == variant.id
                      assign cart_qty_variant = cart_qty_variant | plus: item.quantity
                    endif
                  endfor
                  assign is_quantity_rule = false
                  if variant.quantity_rule.min > 1 and variant.quantity_rule.max != null and variant.quantity_rule.increment > 1
                    assign is_quantity_rule = true
                  endif
                  assign variant_available = variant.available
                  if cart_qty_variant >= variant.quantity_rule.max
                    assign variant_available = false
                  endif
                  assign low_stock_threshold = settings.low_stock_threshold | round
                  assign show_low_stock_count = settings.show_quantity
                  assign show_in_stock_count = settings.show_quantity
                  if customer.b2b? and settings.b2b_low_stock
                    assign low_stock_threshold = settings.b2b_low_stock_threshold | round
                    assign show_low_stock_count = true
                    assign show_in_stock_count = false
                    if settings.b2b_show_quantity == 'always'
                      assign show_in_stock_count = true
                    endif
                  endif
                  if variant.inventory_management == 'shopify' 
                    if variant.inventory_quantity > 0 
                      if variant.inventory_quantity <= low_stock_threshold
                        assign color_inventory = 'inventory-low-stock-status'
                        if show_low_stock_count
                          assign text_inventory = 'products.product.inventory_low_stock_show_count_b2b' | t: quantity: variant.inventory_quantity
                        else
                          assign text_inventory = 'products.product.inventory_low_stock' | t
                        endif
                      else
                        assign color_inventory = 'inventory-in-stock-status'
                        if show_in_stock_count
                          assign text_inventory = 'products.product.inventory_in_stock_show_count_b2b' | t: quantity: variant.inventory_quantity 
                        else
                          assign text_inventory = 'products.product.inventory_out_of_stock_continue_selling' | t 
                        endif
                      endif 
                    else 
                      assign color_inventory = 'inventory-out-of-stock-status'
                      assign text_inventory = 'products.product.inventory_out_of_stock' | t 
                    endif
                  elsif variant.inventory_management == nil
                    assign color_inventory = 'inventory-in-stock-status'
                    assign text_inventory = 'products.product.inventory_out_of_stock_continue_selling' | t
                  endif 
                  assign is_tracked_inventory = false
                  if variant.available and variant.inventory_management == 'shopify' and variant.inventory_policy != 'continue'
                    assign is_tracked_inventory = true
                  endif
                %} 
                {% if variant.quantity_price_breaks.size > 0 %}
                  {% capture quantity_price_breaks %}
                    [
                      {% for price_break in variant.quantity_price_breaks %}
                        {
                          "minimum_quantity": {{ price_break.minimum_quantity | json }},
                          "price": {{ price_break.price | json }}
                        }{% unless forloop.last %},{% endunless %}
                      {% endfor %}
                    ]
                  {% endcapture %}  
                {% endif %}
                <div id="x-product-template-{{ section.id }}-{{ variant.id }}" 
                  x-data="xQuantitySelectorB2B('{{ variant.id }}', '{{ section.id }}-{{ variant.id }}', {{ variant.quantity_rule.min | default: 0 }}, {{ variant.quantity_rule.max | json }}, {{ is_quantity_rule | json }}, {{ settings.currency_code_enable }}, '{{ shop.money_with_currency_format | escape }}', '{{ shop.money_format | escape }}', {{ quantity_price_breaks | strip | escape | default: '[]' }}, {{ cart_qty_variant }}, 0, {{ is_tracked_inventory }}, {{ variant.inventory_quantity | default: 0 }})"
                  class="md:grid md:grid-cols-4 items-center gap-2 lg:gap-7 self-stretch w-full min-w-0 justify-center flex-wrap md:flex-nowrap"
                >
                  <div class="x-block-inventory-status flex flex-nowrap md:justify-center" id="block-inventory-{{ section.id }}-{{ variant.id }}">         
                    <template x-teleport=".inventory-status-{{ section_id }}-{{ card_product_id }}-{{ block_id }}">
                      <div class="{{ color_inventory }} md:hidden flex items-center text-[80%] whitespace-nowrap{% if settings.edges_type == 'rounded_corners' %} rounded-full{% endif %} bg-[rgba(var(--stock-color),0.25)] text-[rgba(var(--stock-color))]
                        {%- if variant.inventory_management != 'shopify' and  variant.inventory_management != nil %} hidden{% endif -%}"
                      >
                        <div class="pt-1 pb-1 pl-2 pr-2">{{ text_inventory }}</div>
                      </div>
                    </template>
                    <div class="{{ color_inventory }} hidden md:flex items-center text-[80%] whitespace-nowrap{% if settings.edges_type == 'rounded_corners' %} rounded-full{% endif %} bg-[rgba(var(--stock-color),0.25)] text-[rgba(var(--stock-color))]
                      {%- if variant.inventory_management != 'shopify' and  variant.inventory_management != nil %} hidden{% endif -%}"
                    >
                      <div class="pt-1 pb-1 pl-2 pr-2">{{ text_inventory }}</div>
                    </div>
                  </div>
                  <div class="x-block-price pricearea text-center w-full md:w-auto">
                    {%- style -%}
                      .tooltip-quantity-price-breaks {
                        bottom: 100%;
                        left: 50%;
                        transform: translateX(-50%);
                        box-shadow: 0 10px 26px #00000038;
                        transition: .14s
                      }
                    {%- endstyle -%}
                    <div id="price-list-view-b2b-{{ section.id }}-{{ variant.id }}" class="flex items-center justify-start md:justify-center">
                      <div class="target-price hidden">{{ variant.price }}</div>
                      <div class="target-compare-at-price hidden">{{ variant.compare_at_price }}</div>
                      <div class="block self-start md:self-center">
                        {% if variant.compare_at_price %}
                          <s class="cap rtl:inline-block price-compare rtl:leading-tight mr-1 opacity-70">{% if settings.currency_code_enable %}{{ variant.compare_at_price | money_with_currency }}{% else %}{{ variant.compare_at_price | money }}{% endif %}/ea</s>
                        {% endif %}
                        <span class="font-semibold leading-6.5{% if variant.compare_at_price %} price-sale selection:bg-text-[rgb(var(--colors-price-sale),0.2)]{% endif %} text-[110%]"><span class="price-unit-list-view-b2b-{{ section.id }}-{{ variant.id }}">{% if settings.currency_code_enable %}{{ variant.price | money_with_currency }}{% else %}{{ variant.price | money }}{% endif %}</span>/ea</span>
                      </div>
                      {% if variant.quantity_price_breaks.size >= 1 %}
                        <span class="popup-info inline-flex items-center justify-center cursor-pointer relative pl-2 pr-2 pt-2 pb-2" >
                          <span class="w-4 h-4"
                            x-on:mouseover="if (window.innerWidth >= 768) showPopup = true"
                            x-on:mouseleave="if (window.innerWidth >= 768) showPopup = false"
                            @click.prevent="if (window.innerWidth < 768) { showPopup = true; $store.xPopup.open = true }"                     
                          >
                            {% render 'icon-labels-bags', icon: 'tooltip' %}
                          </span>
                          <div x-cloak x-show="showPopup && window.innerWidth >= 768" class="tooltip-quantity-price-breaks min-w-[200px] hidden md:flex absolute border-[rgba(var(--colors-line-and-border))] bg-[rgba(var(--background-color),1)] pt-4 pb-4 pl-4 pr-4{% if settings.edges_type == 'rounded_corners' %} rounded-md{% else %} rounded-none{% endif %} z-20 md:flex-col gap-2.5">
                            <p class="title-table whitespace-nowrap text-[120%] font-medium">{{ 'products.product.volumn_pricing.name' | t }} · {{ variant.title }}</p>
                            <div :class="active == 0 ? 'bg-[rgba(var(--color-highlight),0.25)] text-[rgba(var(--color-highlight))] italic' : ''" class="flex justify-between gap-2.5 pl-2 pr-2 pt-2 pb-2{% if settings.edges_type == 'rounded_corners' %} rounded-md{% else %} rounded-none{% endif %}">
                              <span class="text-nowrap">1-{{ variant.quantity_price_breaks[0].minimum_quantity | minus: 1 }}</span>
                              <span> {% if settings.currency_code_enable %}{{ variant.price | money_with_currency }}{% else %}{{ variant.price | money }}{% endif %}</span>
                            </div>
                            {% for price_break in variant.quantity_price_breaks %}
                              {% liquid
                                assign price_break_qty = price_break.minimum_quantity
                                assign price_break_price = price_break.price
                                assign next_index = forloop.index
                                assign next_price_break_qty = variant.quantity_price_breaks[next_index].minimum_quantity
                              %}
                              <div :class="active == {{ forloop.index }} ? 'bg-[rgba(var(--color-highlight),0.25)] text-[rgba(var(--color-highlight))] italic' : ''" class="flex justify-between gap-2.5 pl-2 pr-2 pt-2 pb-2{% if settings.edges_type == 'rounded_corners' %} rounded-md{% else %} rounded-none{% endif %}">
                                <span>{{ price_break_qty }}{% if next_price_break_qty > 0 %}{{ next_price_break_qty | minus: 1 | prepend: '-' }}{% else %}+{% endif %}</span>
                                <span>{% if settings.currency_code_enable %}{{ price_break_price | money_with_currency }}{% else %}{{ price_break_price | money }}{% endif %}</span>
                              </div>
                            {% endfor %}
                          </div>
                          <div x-cloak x-show="showPopup && window.innerWidth < 768" 
                            class="fixed top-0 right-0 left-0 bottom-0 flex flex-col justify-end md:flex-row md:justify-start bg-[#acacac] bg-opacity-30 z-[60]"
                            @keyup.escape="showPopup = false; $store.xPopup.open = false" x-cloak>
                            <div 
                              class="{% if settings.edges_type == 'rounded_corners' %}md:h-auto md:mt-2.5 md:mb-2.5 md:mr-2.5 md:ml-2.5 md:rounded-[10px]{% else %}md:h-full{% endif %} w-full md:w-96 relative bg-[rgba(var(--background-color))]" 
                              x-show="showPopup && window.innerWidth < 768" 
                              x-cloak 
                              @click.away="showPopup = false; $store.xPopup.open = false"
                              x-transition:enter="transition-all ease-in-out duration-500"
                              x-transition:enter-start="opacity-0 transform translate-y-1/3 md:-translate-x-1/3 md:translate-y-0"
                              x-transition:enter-end="opacity-100 transform translate-y-0 md:translate-x-0 md:translate-y-0"
                              x-transition:leave="transition-all ease-in-out duration-500"
                              x-transition:leave-end="opacity-0 transform translate-y-1/3 md:-translate-x-1/3 md:translate-y-0"
                            >  
                              <button 
                                aria-label="{{ 'accessibility.close' | t }}"
                                class="icon-close-container group-close-btn rounded-full absolute right-2 rtl:right-auto rtl:left-2 top-2 md:top-2 cursor-pointer" 
                                @click.prevent="showPopup = false; $store.xPopup.open = false">
                                {% render 'icon-alls', icon: 'icon-close', animation_class: 'icon-close-animation' %}
                              </button>
                              <div class="md:hidden pb-10 ml-5 mr-5 pt-10">
                                <div class="text-[150%] font-medium pb-2 text-left rtl:text-right">{{ 'products.product.volumn_pricing.name' | t }}</div>
                                <div class="pt-2 text-left rtl:text-right border-t border-solid">
                                <span class="font-medium">{{ product.title }}</span> - <span>{{ variant.title }}</span>
                                </div>
                                {% if variant.sku != blank %}<div class="text-left rtl:text-right pb-2">{{ 'customer.order.sku' | t }}: {{ variant.sku }}</div>{% endif %}
                                <div class="flex justify-between gap-2.5 pl-2 pr-2 pt-2 pb-2 font-bold text-[120%]">
                                  <span>{{ 'products.product.quantity.label' | t }}</span>
                                  <span>{{ 'sections.cart.headings.price' | t }}</span>
                                </div>
                                <div :class="active == 0 ? 'bg-[rgba(var(--color-highlight),0.2)] font-bold' : ''" class="flex text-[120%] justify-between gap-2.5 pl-2 pr-2 pt-2 pb-2{% if settings.edges_type == 'rounded_corners' %} rounded-md{% else %} rounded-none{% endif %}">
                                  <span class="text-nowrap">1-{{ variant.quantity_price_breaks[0].minimum_quantity | minus: 1 }}</span>
                                  <span> {% if settings.currency_code_enable %}{{ variant.price | money_with_currency }}{% else %}{{ variant.price | money }}{% endif %}</span>
                                </div>
                                {% for price_break in variant.quantity_price_breaks %}
                                  {% liquid
                                    assign price_break_qty = price_break.minimum_quantity
                                    assign price_break_price = price_break.price
                                    assign next_index = forloop.index
                                    assign next_price_break_qty = variant.quantity_price_breaks[next_index].minimum_quantity
                                  %}
                                  <div :class="active == {{ forloop.index }} ? 'bg-[rgba(var(--color-highlight),0.2)] font-bold' : ''" class="flex text-[120%] justify-between gap-2.5 pl-2 pr-2 pt-2 pb-2{% if settings.edges_type == 'rounded_corners' %} rounded-md{% else %} rounded-none{% endif %}">
                                    <span>{{ price_break_qty }}{% if next_price_break_qty > 0 %}{{ next_price_break_qty | minus: 1 | prepend: '-' }}{% else %}+{% endif %}</span>
                                    <span>{% if settings.currency_code_enable %}{{ price_break_price | money_with_currency }}{% else %}{{ price_break_price | money }}{% endif %}</span>
                                  </div>
                                {% endfor %}
                              </div>
                            </div>
                          </div>
                        </span>
                      {% endif %}
                    </div>
                  </div>
                  {%- unless settings.hide_cart -%}
                    <div class="x-block-quantity-selector w-full md:w-auto mt-2 md:mt-0 flex md:justify-center{% if variant.quantity_price_breaks.size > 0 %} mb-5{% endif %}{% if settings.edges_type == 'rounded_corners' %} corners-app{% endif %}">
                      <div id="atc-quantity-{{ section.id }}-{{ variant.id }}" class="inline-flex w-fit">
                        <div class="inline-flex relative w-fit border border-solid items-center{% if variant_available == false %} opacity-50{% endif %} bg-[rgba(var(--background-color),1)]{% if settings.buttons_type == 'rounded_corners' or settings.buttons_type == 'mixed' %} rounded-md{% elsif settings.buttons_type == 'rounded' %} rounded-full{% endif %}"
                          x-intersect.once.margin.200px="initQtyChangeEvent('Quantity-atc-{{ section.id }}-{{ variant.id }}'); updatePrice()"
                          :class="(errMin || errIncrement || errMax || errInventory) && 'border-[rgba(var(--color-error))]'"
                        >
                          <button class="cursor-pointer w-10 pt-2.5 pb-2.5 md:pt-3.5 md:pb-3.5 bg-transparent pl-3.5 pr-3.5 select-none" name="minus" aria-label="{{ 'accessibility.decrease_quantity' | t }}" @click.prevent="minus({{ variant.quantity_rule.increment | default: 0 }}, true)" {% if variant_available == false %} disabled{% endif %}>
                            {% render 'icon-alls', icon: 'icon-minus' %}
                          </button>
                          <input class="{% if variant_available == false %}cursor-not-allowed{% endif %} outer-spin-button hide-spin-input focus:outline-none w-8 md:w-10 pt-2 pb-2 md:pt-2.5 md:pb-2.5 text-center bg-transparent"
                            type="number"
                            name="quantity"
                            id="Quantity-atc-{{ section.id }}-{{ variant.id }}"
                            aria-label="{{ 'products.product.quantity.label' | t }}"
                            min="0"
                            {% if variant.quantity_rule.max != null %}
                              max="{{ variant.quantity_rule.max }}"
                            {% endif %}
                            step="{{ variant.quantity_rule.increment | default: 0 }}"
                            value="0"
                            x-model="qty"
                            x-on:blur="invalid($el, {{ variant.quantity_rule.increment | default: 0 }}, true)"
                            {% if variant_available == false %} readonly{% endif %}
                          >
                          <button class="cursor-pointer w-10 pt-2.5 pb-2.5 md:pt-3.5 md:pb-3.5 bg-transparent pr-3.5 pl-3.5 select-none" name="plus" @click.prevent="plus({{ variant.quantity_rule.increment | default: 0 }}, true)" aria-label="{{ 'accessibility.increase_quantity' | t }}" {% if variant_available == false %} disabled{% endif %}>
                            {% render 'icon-alls', icon: 'icon-plus' %}
                          </button>
                          {% if variant.quantity_price_breaks.size > 0 %}
                            <div class="quantity-rules absolute w-full text-center text-[85%] top-[calc(100%+4px)] left-0 whitespace-nowrap" x-show="!errMin && !errIncrement && !errMax && !errInventory">
                              {% if variant.quantity_rule.min != null %}
                                {{ 'products.product.quantity.min' | t }}: {{ variant.quantity_rule.min }}
                              {% endif %}
                              {% if variant.quantity_rule.increment != null and variant.quantity_rule.increment > 1 %}
                                · {{ 'products.product.quantity.multiples' | t }}: {{ variant.quantity_rule.increment }}
                              {% endif %}
                              {% if variant.quantity_rule.max != null %}
                                · {{ 'products.product.quantity.max' | t }}: {{ variant.quantity_rule.max }}
                              {% endif %}
                            </div>
                          {% endif %}
                          <div class="quantity-err font-bold absolute w-full text-center text-[85%] text-[rgba(var(--color-error))] top-[calc(100%+4px)] left-0">
                            <span x-cloak class="quantity-err-min whitespace-nowrap" x-show="errMin">{{ 'products.product.quantity.err_min' | t: quantity: variant.quantity_rule.min }}</span>
                            <span x-cloak class="quantity-err-increment whitespace-nowrap" x-show="errIncrement">{{ 'products.product.quantity.err_increment' | t: quantity: variant.quantity_rule.increment }}</span>
                            {% assign only_left = variant.quantity_rule.max | minus: cart_qty_variant %}
                            <span x-cloak class="quantity-err-max whitespace-nowrap" x-show="errMax">{{ 'products.product.quantity.err_max' | t: quantity: only_left }}</span>
                            <span x-cloak class="quantity-err-inventory whitespace-nowrap" x-show="errInventory">{{ 'products.product.quantity.err_max' | t: quantity: variant.inventory_quantity }}</span>
                          </div>
                          <a class="underline absolute left-[calc(100%+12px)] rtl:right-[calc(100%+12px)] leading-normal{% if variant_available %} cursor-pointer{% else %} cursor-not-allowed{% endif %}" @click="if({{ variant_available }}){ validateQty(0, 1, true)}else return" @keydown.enter="if({{ variant_available }}){ validateQty(0, 1, true)}else return" @keydown.space.prevent="if({{ variant_available }}){ validateQty(0, 1, true)}else return" role="button" tabindex="0">
                            {{ 'products.product.clear_qty' | t }}
                          </a>
                        </div>
                      </div>
                    </div>
                    <div class="x-block-total-price hidden md:block overflow-hidden justify-self-end">
                      <div id="total-price-{{ section.id }}-{{ variant.id }}" class="overflow-auto hide-scrollbar total-variant-price text-right rtl:text-left leading-6.5 text-[110%]">–</div>
                    </div>
                  {%- endunless -%}
                </div>
              {% endif %}
            </div>
          </div>
          {% if card_product.variants_count > 1 %}
            <button class="text-center border-solid border-1 border-[rgb(var(--colors-text))] leading-normal w-8 h-8 md:w-12 md:h-12 lg:-translate-x-0 cursor-pointer flex items-center self-start md:self-center pt-1.5 pb-1.5 pl-2 pr-2 md:pt-2.5 md:pb-2.5 md:pl-4 md:pr-4 rounded-full"
              @click.prevent="setTimeout(() => { showOptions = !showOptions; }, 0)"
              x-on:mouseover.once ="setTimeout(() => {loadChooseOptionsB2B('{{ card_product_url }}', $el, '{{ section_id }}-{{ card_product_id }}-{{ block_id }}', {{ index_param }}) }, 0)"
            >
              <span class="h-4 w-4 inline-block duration-300" :class="showOptions ? 'rotate-180':'rotate-0'">{% render 'icon-alls', icon: 'icon-caret' %}</span>
            </button>
          {% endif %}
        </div>
        {%- if only_default_variant == false -%}
          <div
            id="choose-options-b2b-{{ section_id }}-{{ card_product_id }}-{{ block_id }}"
            class="card-product-body md:bg-[rgba(var(--colors-background-secondary))] relative"
            x-show="showOptions"
            x-collapse.duration.300ms
            @transitionend.self="if ($event.propertyName === 'height' && showOptions) $el.style.overflow = ''"
            x-cloak
          >
            <div class="choose-options relative w-full pl-4 pr-4 flex flex-col md:gap-1"></div>
            <div class="icon-loading hidden relative bg-[rgba(var(--colors-background))] pt-5 pb-5 ml-4 mr-4 {% if settings.edges_type == 'rounded_corners' %} md:rounded-[10px]{% endif %}">
              <div class="lg:inline-block w-4 h-4 md:w-5 md:h-5 absolute top-[calc(50%-8px)] left-[calc(50%-8px)] md:top-[calc(50%-10px)] md:left-[calc(50%-10px)] z-20">
                {% render 'icon-alls', icon: 'icon-loading' %}
              </div>
            </div>
          </div>
        {%- endif -%}
        <div id="x-block-cart-product-info-{{ section_id }}-{{ card_product_id }}-{{ block_id }}" class="flex flex-wrap md:justify-end justify-between items-center gap-x-7 gap-y-2 pl-4 pr-4 pt-4 pb-4 bg-[rgba(var(--colors-background-secondary))]{% if settings.edges_type == 'rounded_corners' %} rounded-b-[10px]{% endif %}">
          {% liquid
            assign cart_qty = 0
            for item in cart.items
              if item.product_id == card_product.id
                assign cart_qty = cart_qty | plus: item.quantity
              endif
            endfor
          %}
          <div class="hidden md:flex items-center gap-x-2 text-left rtl:text-right p-break-words mb-2 mt-2 pl-4 pr-4 pt-3 pb-3 bg-[rgba(var(--color-error),0.2)]{% if settings.edges_type == 'rounded_corners' %} rounded-md{% endif %}" role="alert" x-cloak x-show="errorMessage" @click.away="errorMessage=false">
            <div class="flex">
              <span class="w-4 h-4">{% render 'icon-alls', icon: 'icon-error' %}</span>
            </div>
            <span class="error_message ml-2 pt-0.5" x-ref="error_message"></span>
          </div>
          {% if cart_qty > 0 %}
            <div class="flex items-center pt-2 pb-2 pl-3 pr-3 w-full md:w-auto gap-2 bg-[rgba(var(--color-success),0.2)] text-[rgba(var(--color-success))]{% if show_rounded_image %} rounded-md{% endif %}">
              <div class="w-5 h-5">
                {% render 'icon-labels-bags', icon: 'check-mark' %}
              </div>
              <div>{{ 'products.product.added_n_to_cart' | t: quantity: cart_qty }}</div>
            </div>
          {% endif %}
          <div class="total-price-product font-bold leading-6.5 text-[110%]"><span class="hidden md:inline-block">{{ 'products.product.price.total_price' | t }}: </span> <span id="x-block-sum-price-product-{{ section_id }}-{{ card_product.id }}-{{ block_id }}">{% if settings.currency_code_enable %}{{ 0 | money_with_currency }}{% else %}{{ 0 | money }}{% endif %}</span></div>
          <button
            id="x-atc-button-{{ section_id }}-{{ card_product.id }}-{{ block_id }}"
            role="button"
            name="add"
            type="submit"
            @click.prevent="hasErrVariant == false && hasQty && errorMessage == false && addToCart($event)"
            :class="(hasErrVariant || !hasQty || errorMessage) && 'opacity-60 cursor-not-allowed'"
            class="relative choose_option_atc h-full not-icon add_to_cart_button button--quickview button button-solid disable-action-btn-animation disabled:opacity-60 disabled:cursor-not-allowed duration-200 text-[12px] lg:text-[14px] lg:pl-10 lg:pr-10 pl-6 pr-6 pt-3 pb-3 list-layout:w-auto"
            x-intersect.once.margin.200px="Alpine.store('xCartHelper').validateCart(); listenVariantErr('{{ card_product_id }}');"
            {% if settings.enable_shipping_insurance and settings.shipping_insurance_added_by_default and shipping_insurance %}
              @init-run.window="loadInsurance('{{ shipping_insurance }}')"
            {% endif %}
            {% if settings.enable_shipping_insurance and settings.product_shipping_insurance != blank and settings.product_shipping_insurance.id == product.id %}
              style="display: none;"
            {% endif %}
            :disabled="hasErrVariant || !hasQty || {{ card_product.available | json }} === false"
          >
            <span class="x-atc-text" :class="{ 'opacity-0 is-focus-button' : loading}">
                {% liquid
                  assign button_label = 'products.product.add_to_cart' | t
                %}
                <span class="flex items-center justify-center">
                  {% render 'button-label', button_label: button_label , show_button_style: 'primary' %}
                </span>
            </span>
            <div class="lg:inline-block w-4 h-4 md:w-5 md:h-5 absolute top-[calc(50%-8px)] left-[calc(50%-8px)] md:top-[calc(50%-10px)] md:left-[calc(50%-10px)]" x-show="loading" x-cloak>
              {% render 'icon-alls', icon: 'icon-loading' %}
            </div>
          </button>
        </div>
      {% endform %}
    </div>
    <script src="{{ 'product-grid-b2b.js' | asset_url }}" defer></script>
  </div>
</div>
{%- endif -%}