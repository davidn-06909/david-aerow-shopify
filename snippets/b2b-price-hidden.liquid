{% doc %}
  Outputs `true` when the price of a product must be hidden from the current visitor, and nothing
  otherwise, so callers can capture the output and test it.

  The price is hidden when `b2b_enable_price_visibility` is on, the visitor is not approved (see the
  `b2b-customer-approved` snippet) and the product falls into `b2b_price_visibility_scope`. Use it to
  hide anything that would leak the price, such as add to cart buttons.

  @param {object} product - The product to test

  @example
  {%- capture b2b_price_hidden -%}
    {%- render 'b2b-price-hidden', product: product -%}
  {%- endcapture -%}
  {%- unless b2b_price_hidden contains 'true' -%}
    {%- comment -%} buy buttons {%- endcomment -%}
  {%- endunless -%}
{% enddoc %}
{%- if settings.b2b_enable_price_visibility and customer -%}
  {%- capture b2b_approved -%}
    {%- render 'b2b-customer-approved' -%}
  {%- endcapture -%}
{%- endif -%}
{%- liquid
  assign gate_price = false

  if settings.b2b_enable_price_visibility and product != blank and b2b_approved == blank
    case settings.b2b_price_visibility_scope
      when 'collections'
        for product_collection in product.collections
          assign collection_match = settings.b2b_price_visibility_collections | where: 'id', product_collection.id
          if collection_match.size > 0
            assign gate_price = true
            break
          endif
        endfor
      when 'products'
        assign product_match = settings.b2b_price_visibility_products | where: 'id', product.id
        if product_match.size > 0
          assign gate_price = true
        endif
      else
        assign gate_price = true
    endcase
  endif

  if gate_price
    echo 'true'
  endif
-%}
