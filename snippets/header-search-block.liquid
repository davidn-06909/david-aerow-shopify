<a
  {% if trigger_id != blank %}id="{{ trigger_id }}"{% endif %}
  href="{{ routes.search_url }}"
  class="flex items-center cursor-pointer justify-center link focus-inset bg-none"
  data-search-open
  aria-label="{{ 'accessibility.search' | t }}"
  aria-haspopup="dialog"
  aria-controls="AtelierSearch-{{ section.id }}"
  aria-expanded="false"
  @click.prevent="$dispatch('atelier-search:open', { trigger: $el })"
>
  <span class="w-11 h-10 pl-3 pr-3 pt-2.5 pb-2">{% render 'icon-alls', icon: 'icon-search', animation_class: 'icon-animation' %}</span>
</a>
