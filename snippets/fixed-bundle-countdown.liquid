{% doc %}
  Renders the countdown bar displayed above the product list of the fixed bundle section.

  @param countdown_block {block} The countdown block of the fixed bundle section.
  @param text_position {string} Resolved unit label position - below or aside.
  @param keep_countdown {boolean} Whether the timer stays visible at 00:00:00 once ended instead of being hidden.
  @param show_end_message {boolean} Whether the expiration message is rendered next to or in place of the heading and text once ended.
  @param countdown_ended {boolean} Whether the end date has already passed when the page is rendered.
  @param countdown_heading_rem {number} Desktop heading size in rem, derived from the block text size. Mobile is 0.6 of it.
  @param countdown_text_rem {number} Desktop label size in rem, derived from the block text size. Mobile is 0.9 of it.
  @param overlay {boolean} Whether the bar is stacked and pinned over the bottom of the bundle image instead of laid out as a full-width band.
  @param overlay_radius_md {string} Bottom corner radius of the overlay bar from 768px up, matched to the radius of the image behind it. Defaults to the mobile 0.375rem.
  @param heading_alignment {string} Text and item alignment.
  @param rtl_alignment {string} Text alignment for right-to-left languages.
{% enddoc %}

{%- liquid
  assign units = 'days,hours,mins,secs' | split: ','
  assign separator = countdown_block.settings.separator

  assign show_text_column = false
  if show_end_message
    assign show_text_column = true
  elsif countdown_ended == false and countdown_block.settings.heading != blank
    assign show_text_column = true
  elsif countdown_ended == false and countdown_block.settings.text != blank
    assign show_text_column = true
  endif
-%}

{% style %}
  .countdown-bar-{{ countdown_block.id }} {
    {% if countdown_block.settings.countdown_background_color.alpha != 0.0 %}
      background-color: rgba({{ countdown_block.settings.countdown_background_color.red }}, {{ countdown_block.settings.countdown_background_color.green }}, {{ countdown_block.settings.countdown_background_color.blue }}, {{ countdown_block.settings.bg_opacity }}%);
    {% endif %}
    {% unless countdown_block.settings.countdown_text_color.alpha == 0.0 %}
      color: {{ countdown_block.settings.countdown_text_color }};
    {% endunless %}
    {%- if overlay and settings.edges_type == 'rounded_corners' -%}
      border-bottom-left-radius: 0.375rem;
      border-bottom-right-radius: 0.375rem;
    {%- endif -%}
  }
  .dark .countdown-bar-{{ countdown_block.id }} {
    {% if countdown_block.settings.countdown_background_color_dark.alpha != 0.0 %}
      background-color: rgba({{ countdown_block.settings.countdown_background_color_dark.red }}, {{ countdown_block.settings.countdown_background_color_dark.green }}, {{ countdown_block.settings.countdown_background_color_dark.blue }}, {{ countdown_block.settings.bg_opacity }}%);
    {% else %}
      background-color: transparent;
    {% endif %}
    {% unless countdown_block.settings.countdown_text_color_dark.alpha == 0.0 %}
      color: {{ countdown_block.settings.countdown_text_color_dark }};
    {% else %}
      color: rgba(var(--colors-text));
    {% endunless %}
  }
  .countdown-box-{{ countdown_block.id }} {
    {% if countdown_block.settings.timer_background_color.alpha != 0.0 %}
      background-color: rgba({{ countdown_block.settings.timer_background_color.red }}, {{ countdown_block.settings.timer_background_color.green }}, {{ countdown_block.settings.timer_background_color.blue }}, {{ countdown_block.settings.timer_bg_opacity }}%);
    {% endif %}
    {% unless countdown_block.settings.border_style == 'none' %}
      border-width: 1px;
      border-style: {{ countdown_block.settings.border_style }};
    {% endunless %}
    {% unless countdown_block.settings.countdown_text_color.alpha == 0.0 %}
      color: {{ countdown_block.settings.countdown_text_color }};
      border-color: {{ countdown_block.settings.countdown_text_color }};
    {% endunless %}
    {%- if text_position == 'aside' -%}
      width: 80px;
    {%- else -%}
      width: 64px;
    {%- endif -%}
    height: 64px;
  }
  .dark .countdown-box-{{ countdown_block.id }} {
    {% if countdown_block.settings.timer_background_color_dark.alpha != 0.0 %}
      background-color: rgba({{ countdown_block.settings.timer_background_color_dark.red }}, {{ countdown_block.settings.timer_background_color_dark.green }}, {{ countdown_block.settings.timer_background_color_dark.blue }}, {{ countdown_block.settings.timer_bg_opacity }}%);
    {% else %}
      background-color: transparent;
    {% endif %}
    {% unless countdown_block.settings.countdown_text_color_dark.alpha == 0.0 %}
      color: {{ countdown_block.settings.countdown_text_color_dark }};
      border-color: {{ countdown_block.settings.countdown_text_color_dark }};
    {% else %}
      color: rgba(var(--colors-text));
      border-color: rgba(var(--colors-text));
    {% endunless %}
  }
  .countdown-divider-{{ countdown_block.id }} {
    background-color: currentColor;
    opacity: 0.25;
  }
  .countdown-time-{{ countdown_block.id }} {
    {% unless countdown_block.settings.countdown_time_color.alpha == 0.0 %}
      color: {{ countdown_block.settings.countdown_time_color }};
    {% endunless %}
  }
  .dark .countdown-time-{{ countdown_block.id }} {
    {% unless countdown_block.settings.countdown_time_color_dark.alpha == 0.0 %}
      color: {{ countdown_block.settings.countdown_time_color_dark }};
    {% endunless %}
  }
  .countdown-heading-{{ countdown_block.id }} {
    font-size: {{ countdown_heading_rem | times: 0.6 }}rem;
  }
  .countdown-label-{{ countdown_block.id }} {
    font-size: {{ countdown_text_rem | times: 0.9 }}rem;
  }
  @media (min-width: 768px) {
    .countdown-heading-{{ countdown_block.id }} {
      font-size: {{ countdown_heading_rem }}rem;
    }
    .countdown-label-{{ countdown_block.id }} {
      font-size: {{ countdown_text_rem }}rem;
    }
    {%- if overlay and settings.edges_type == 'rounded_corners' -%}
      .countdown-bar-{{ countdown_block.id }} {
        border-bottom-left-radius: {{ overlay_radius_md | default: '0.375rem' }};
        border-bottom-right-radius: {{ overlay_radius_md | default: '0.375rem' }};
      }
    {%- endif -%}
    .countdown-box-{{ countdown_block.id }} {
      {%- if countdown_block.settings.timer_style == 'round' -%}
        {%- if overlay -%}
          width: 96px;
          height: 96px;
        {%- else -%}
          width: 100px;
          height: 100px;
        {%- endif -%}
      {%- elsif text_position == 'aside' -%}
        width: 120px;
        height: 80px;
      {%- else -%}
        width: 80px;
        height: 80px;
      {%- endif -%}
    }
  }
{% endstyle %}
<div class="fixed-bundle-countdown-header countdown-bar-{{ countdown_block.id }} flex flex-col items-center{% if overlay %} justify-center gap-4 pt-4 pb-4 pl-4 pr-4 absolute bottom-0 left-0 w-full{% else %} md:flex-row justify-evenly gap-5 pt-5 pb-5 pl-5 pr-5 md:pt-7 md:pb-7 md:pl-10 md:pr-10 mb-4 md:mb-14{% if settings.edges_type == 'rounded_corners' %} rounded-md{% endif %}{% endif %}">
  {%- if show_text_column -%}
    <div class="flex flex-col w-full md:w-fit items-{{ heading_alignment }} text-{{ heading_alignment }} rtl:text-{{ rtl_alignment }}">
      {% if countdown_ended == false %}
        {%- if countdown_block.settings.heading != blank -%}
          <p x-show="!ended" class="countdown-heading-{{ countdown_block.id }} text-[rgba(var(--colors-heading))] font-semibold leading-tight">
            {{- countdown_block.settings.heading | escape | newline_to_br -}}
          </p>
        {%- endif -%}
        {%- if countdown_block.settings.text != blank -%}
          <p x-show="!ended" class="countdown-label-{{ countdown_block.id }} text-[rgba(var(--colors-text))] mt-1">
            {{- countdown_block.settings.text | escape | newline_to_br -}}
          </p>
        {%- endif -%}
      {% endif %}
      {%- if show_end_message -%}
        <div {% unless countdown_ended %}x-show="ended" x-cloak {% endunless %}class="countdown-label-{{ countdown_block.id }} rte{% unless countdown_ended %} mt-1{% endunless %}">
          {{ countdown_block.settings.end_message }}
        </div>
      {%- endif -%}
    </div>
    {%- unless overlay and countdown_ended -%}
      <span x-show="!ended" x-cloak class="countdown-divider-{{ countdown_block.id }} hidden md:block w-px self-stretch" aria-hidden="true"></span>
    {%- endunless -%}
  {%- endif -%}
  {%- unless countdown_ended and keep_countdown == false -%}
    <div
      {% unless keep_countdown %}x-show="!ended"{% endunless %}
      class="flex max-w-full items-center justify-center rtl:flex-row-reverse gap-2 md:gap-4"
    >
      {%- for unit in units -%}
        {%- if forloop.index0 > 0 -%}
          {%- if separator == 'colon' -%}
            <span class="countdown-time-{{ countdown_block.id }} h2 leading-none" aria-hidden="true">:</span>
          {%- elsif separator == 'line_vertical' -%}
            <span class="countdown-divider-{{ countdown_block.id }} w-px h-8 md:h-10" aria-hidden="true"></span>
          {%- endif -%}
        {%- endif -%}
        <div class="countdown-box-{{ countdown_block.id }} flex justify-center{% if text_position == 'aside' %} flex-row items-center{% else %} flex-col items-center{% endif %}{% if countdown_block.settings.timer_style == 'round' %} rounded-full{% elsif settings.edges_type == 'rounded_corners' %} rounded-[10px]{% endif %}">
          <span
            class="countdown-time-{{ countdown_block.id }} h2 leading-none"
            {%- unless countdown_ended %} x-text="countdownLoading ? textLoad : String({{ unit }}).padStart(2, '0')"{% endunless -%}
          >{% if countdown_ended %}00{% endif %}</span>
          <span class="countdown-label-{{ countdown_block.id }}{% if text_position == 'aside' %} -translate-y-2 ml-0.5{% else %} mt-1{% endif %}">
            {%- assign unit_label = 'sections.flash-sale.' | append: unit -%}
            {{- unit_label | t -}}
          </span>
        </div>
      {%- endfor -%}
    </div>
  {%- endunless -%}
</div>
