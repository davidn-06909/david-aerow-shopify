{%- liquid
  assign image_alt = alt | default: image.alt | default: ''
  assign responsive_url = false
  if image_url contains '.myshopify.com/cdn/shop/' or image_url contains 'cdn.shopify.com/'
    assign responsive_url = true
    assign image_url = image_url | split: '&width=' | first | split: '?width=' | first
    assign separator = '?'
    if image_url contains '?'
      assign separator = '&'
    endif
    assign widths = '180,300,400,500,600,800,1000,1200,1600,1800' | split: ','
  endif
-%}
{%- if image != blank -%}
  {{ image | image_url: width: 1800 | image_tag: widths: '180, 300, 400, 500, 600, 800, 1000, 1200, 1600, 1800', sizes: sizes, loading: loading, class: 'atelier-consultation__image', alt: image_alt }}
{%- elsif image_url != blank -%}
  <img
    class="atelier-consultation__image"
    {% if responsive_url %}
      src="{{ image_url | escape }}{{ separator }}width=1000"
      srcset="{% for width in widths %}{{ image_url | escape }}{{ separator }}width={{ width }} {{ width }}w{% unless forloop.last %}, {% endunless %}{% endfor %}"
      sizes="{{ sizes }}"
    {% else %}
      src="{{ image_url | escape }}"
    {% endif %}
    width="1000" height="1500" alt="{{ image_alt | escape }}" loading="{{ loading }}" decoding="async"
  >
{%- else -%}
  {{ 'image' | placeholder_svg_tag: 'atelier-consultation__image atelier-consultation__placeholder' }}
{%- endif -%}
