{%- liquid
  assign mobile_image = mobile_image | default: image
  assign image_alt = image.alt | default: label
-%}
<picture>
  {%- if mobile_image != blank and mobile_image != image -%}
    <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 400 }} 400w, {{ mobile_image | image_url: width: 600 }} 600w, {{ mobile_image | image_url: width: 800 }} 800w" sizes="100vw">
  {%- endif -%}
  {%- if image != blank -%}
    {{ image | image_url: width: 2200 | image_tag: widths: '400, 600, 800, 1000, 1200, 1500, 1800, 2200', sizes: '(min-width: 990px) 55vw, 100vw', loading: loading, alt: image_alt }}
  {%- elsif image_url != blank -%}
    <img src="{{ image_url | escape }}" width="2200" height="1467" loading="{{ loading }}" alt="{{ label | escape }}" draggable="false">
  {%- elsif mobile_image != blank -%}
    {{ mobile_image | image_url: width: 2200 | image_tag: widths: '400, 600, 800, 1000, 1200, 1500, 1800, 2200', sizes: '(min-width: 990px) 55vw, 100vw', loading: loading, alt: image_alt }}
  {%- else -%}
    {{ 'image' | placeholder_svg_tag: 'atelier-comparison__placeholder' }}
  {%- endif -%}
</picture>
