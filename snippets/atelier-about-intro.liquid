{% render 'atelier-about-style', section: section %}
<div id="atelier-about-{{ section.id }}" class="atelier-about atelier-about--intro">
  <div class="atelier-about__page atelier-about__reading">
    {% if section.settings.show_breadcrumbs %}
      <nav aria-label="{{ 'accessibility.breadcrumb' | t | escape }}" class="atelier-about__breadcrumbs">
        <ol role="list">
          <li><a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a></li>
          <li><span aria-current="page">{{ section.settings.atelier_heading | default: page.title | escape }}</span></li>
        </ol>
      </nav>
    {% endif %}
    <header class="atelier-about__intro-head">
      {% if section.settings.atelier_eyebrow != blank %}<p class="atelier-about__eyebrow">{{ section.settings.atelier_eyebrow | escape }}</p>{% endif %}
      {% if section.settings.show_heading %}<h1 class="atelier-about__display">{{ section.settings.atelier_heading | default: page.title | escape }}</h1>{% endif %}
    </header>
    <div class="atelier-about__rte">{{ section.settings.atelier_text | default: page.content }}</div>
  </div>
</div>
