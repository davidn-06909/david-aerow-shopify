{%- liquid
  assign card_image = image | default: card_collection.featured_image
  assign image_loading = 'lazy'
  if index <= section.settings.columns_desktop
    assign image_loading = 'eager'
  endif
  assign desktop_width = 100.0 | divided_by: section.settings.columns_desktop
  assign mobile_width = 100.0 | divided_by: section.settings.columns_mobile
  assign desktop_gaps = section.settings.columns_desktop | minus: 1 | times: 26
  assign maximum_width = 1648 | minus: desktop_gaps | divided_by: section.settings.columns_desktop
-%}
{%- capture image_sizes -%}(min-width: 1720px) {{ maximum_width }}px, (min-width: 990px) {{ desktop_width }}vw, {{ mobile_width }}vw{%- endcapture -%}

<a class="atelier-collections__card" href="{{ card_collection.url }}">
  <span class="atelier-collections__media atelier-collections__media--{{ section.settings.image_ratio | replace: '/', '-' }}{% if card_image == blank %} atelier-collections__media--placeholder{% endif %}">
    {% if card_image != blank %}
      {{ card_image | image_url: width: 2200 | image_tag:
        widths: '200, 300, 400, 500, 600, 800, 1000, 1200, 1500, 1800, 2200',
        sizes: image_sizes,
        loading: image_loading,
        alt: card_collection.title,
        class: 'atelier-collections__image'
      }}
    {% else %}
      <span class="atelier-collections__placeholder" aria-hidden="true">{{ 'image' | placeholder_svg_tag }}</span>
    {% endif %}
  </span>
  <span class="atelier-collections__body-text">
    <span class="atelier-collections__name">{{ card_collection.title | escape }}</span>
    {% if section.settings.show_item_count %}
      <span class="atelier-collections__count">{{ 'sections.atelier_collection.pieces' | t: count: card_collection.all_products_count }}</span>
    {% endif %}
  </span>
</a>
