{%- liquid
  assign heading_font = section.settings.atelier_heading_font
  assign body_font = section.settings.atelier_body_font
  assign accent_font = body_font | font_modify: 'style', 'italic'
-%}
{% style %}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ accent_font | font_face: font_display: 'swap' }}
  #atelier-about-{{ section.id }} {
    --about-heading-font: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --about-heading-weight: {{ heading_font.weight }};
    --about-body-font: {{ body_font.family }}, {{ body_font.fallback_families }};
    --about-body-weight: {{ body_font.weight }};
    --about-background: {{ section.settings.atelier_background }};
    --about-color: {{ section.settings.atelier_color }};
    --about-soft: {{ section.settings.atelier_soft }};
    --about-top: {{ section.settings.padding_top }}px;
    --about-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}
