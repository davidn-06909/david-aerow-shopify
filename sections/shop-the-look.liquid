          <button class="splide__arrow splide__arrow--prev button-arrow lg:absolute top-1/2 -left-14 rtl:-right-14 rtl:left-auto rtl:rotate-180 lg:-mt-6 z-10 w-11 h-11 border border-solid lg:border-none rounded-full pt-3 pb-3 pr-3 pl-3 cursor-pointer after:text-[20px] duration-200 hover:opacity-100 disabled:cursor-not-allowed transition-all ease-in-out disabled:opacity-30" aria-label="{{ 'accessibility.previous_slide' | t }}">
            {% render 'icon-labels-bags', icon: 'chevron-left' %}
          </button>
          <button class="splide__arrow splide__arrow--next button-arrow lg:absolute top-1/2 -right-14 rtl:-left-14 rtl:right-auto rtl:rotate-180 lg:-mt-6 z-10 w-11 h-11 border border-solid lg:border-none rounded-full pt-3 pb-3 pr-3 pl-3 cursor-pointer after:text-[20px] duration-200 hover:opacity-100 disabled:cursor-not-allowed transition-all ease-in-out disabled:opacity-30" aria-label="{{ 'accessibility.next_slide' | t }}">
            {% render 'icon-labels-bags', icon: 'chevron-right' %}
          </button>
        </div>
        <div class="splide__track h-full w-full{% if section.blocks.size > 1 %} md:cursor-grab{% endif %}">
          <div class="splide__list flex w-full h-full translate-x-0">
            {% for block in section.blocks %}
              {% if block.settings.heading != blank or block.settings.text != blank %}
                {% capture block_heading_text %}
                  <div class="x-block-shop-the-look{% if block.type == 'media_with_text' %}-media{% endif %}-content-{{ block.id }} flex flex-col text-{{ block.settings.content_alignment }} rtl:text-{% if block.settings.content_alignment == 'center' %}center{% elsif block.settings.content_alignment == 'left' %}right{% else %}left{% endif %}">
                    {% if block.settings.heading != blank %}
                      <div class="h3 w-full font-medium font-shop-the-look-{{ section.id }}">{{ block.settings.heading }}</div>
                    {% endif %}
                    {% if block.settings.text != blank %}
                      <div class="rte w-full text-[rgba(var(--colors-text))]">{{ block.settings.text }}</div>
                    {% endif %}
                  </div>
                {% endcapture %}
              {% else %}
                {% assign block_heading_text = '' %}
              {% endif %}
              {%- case block.type -%}
                {% when 'look' %}
                  {% liquid
                    assign index_param = section.index | append: forloop.index 
                  %}
                  {% if block.settings.products == blank or block.settings.products.count == 1 %}
                    {% if block.settings.products != blank %}
                      {% assign card_product = block.settings.products | first %}
                    {% else %}
                      {% assign card_product = block.settings.product %}
                    {% endif %}
                    <div x-slide-index="{{ forloop.index0 }}" class="splide__slide x-splide-slide{% if card_product != blank %} overflow-x-hidden overflow-y-auto{% else %} md:overflow-y-hidden overflow-y-auto{% endif %} scrollbar-body card-shop-the-look-{{ section.id }} md:self-center w-full h-full flex-shrink-0 relative card-shop-look-product-{{ section.settings.desktop_size }} mr-16 rtl:mr-0 rtl:ml-16 flex flex-col gap-4 md:gap-5 max-h-[400px] md:max-h-[unset]">
                      {{ block_heading_text }}
                      {% render 'card-product-shop-the-look',
                        section_id: section.id,
                        block_id: block.id,
                        card_product_id: card_product.id,
                        product_card_id: forloop.index,
                        card_product: card_product,
                        ratio: ratio,
                        disable_quickview: disable_quickview,
                        index: forloop.index,
                        index_param: index_param,
                        animation_loading: true,
                        show_price_range: true,
                        is_rtl: is_rtl,
                        loading: loading,
                        show_vendor: section.settings.show_vendor,
                        show_highlighted_features: section.settings.show_highlighted_features,
                        show_highlighted_attributes: section.settings.show_highlighted_attributes,
                        show_rating: section.settings.show_rating,
                        media_aspect_ratio: section.settings.image_ratio,
                        full_width: section.settings.full_width,
                        info_alignment: section.settings.info_alignment
                      %}
                    </div>
                  {% else %}
                    <div x-slide-index="{{ forloop.index0 }}" class="splide__slide x-splide-slide x-products-list-container-{{ block.id }} overflow-y-auto scrollbar-body card-shop-the-look-{{ section.id }} md:self-center w-full h-full flex-shrink-0 relative card-shop-look-product-{{ section.settings.desktop_size }} mr-16 rtl:mr-0 rtl:ml-16 flex flex-col gap-4 md:gap-5 max-h-[400px] md:max-h-[unset]">
                      {{ block_heading_text }}
                      <div 
                        class="x-shop-the-look-products-{{ block.id }} flex flex-col{% if section.settings.image_alignment != 'layered' %} is-active{% endif %}" 
                        {% if section.settings.image_alignment == 'layered' %}
                          x-intersect.once="() => {
                            const mq = window.matchMedia('(max-width: 767px)'); 
                            const toggleActive = () => $el.classList.toggle('is-active', mq.matches); 
                            toggleActive(); 
                            mq.addEventListener('change', toggleActive);
                          }"
                        {% endif %}
                      >
                        {% for product in block.settings.products %}
                          {% if product.has_only_default_variant == false and product.available %}
                            {% assign has_add_all_variant = true %}
                            {% assign has_add_all_modal = true %}
                          {% endif %}
                          {% render 'mini-card-product-shop-the-look', standard_event_context: 'collection', 
                            card_product: product, 
                            content_alignment: block.settings.content_alignment,
                            disable_quickview: disable_quickview, 
                            show_vendor: section.settings.show_vendor,
                            show_highlighted_features: section.settings.show_highlighted_features,
                            show_highlighted_attributes: section.settings.show_highlighted_attributes,
                            show_rating: section.settings.show_rating,
                            image_ratio: section.settings.image_ratio,
                            forloop: forloop 
                          %}
                        {% endfor %}
                      </div>
                      {% assign cant_add_all = block.settings.products | has: 'available', false %}
                      {%- if settings.b2b_enable_price_visibility and cant_add_all == false -%}
                        {%- for stl_product in block.settings.products -%}
                          {%- capture stl_b2b_price_hidden -%}
                            {%- render 'b2b-price-hidden', product: stl_product -%}
                          {%- endcapture -%}
                          {%- if stl_b2b_price_hidden contains 'true' -%}
                            {%- assign cant_add_all = true -%}
                            {%- break -%}
                          {%- endif -%}
                        {%- endfor -%}
                      {%- endif -%}
                      {% if block.settings.products != blank and block.settings.products.count > 1 %}
                        <button {% if cant_add_all %}disabled :class="{ 'disable-btn-animation': true }"{% endif %} {% if has_add_all_variant %}@click.prevent="openVariantContainer('{{ block.id }}')" @mouseover="injectCardproduct('{{ block.id }}')" @focus="injectCardproduct('{{ block.id }}')"{% else %}@click.prevent="handleAddToCart($el, '.x-products-list-container-{{ block.id }}', '.x-shop-the-look-products-{{ block.id }}.is-active .product-form', '{{ settings.name_edt | default: "Note" }}')"{% endif %} class="button--{{ section.id }} button button-solid button--quickview w-full pt-3 pb-3 pl-8 pr-8 z-[15] disabled:cursor-not-allowed disabled:opacity-60">
                          {% assign button_label = 'products.product.add_all_to_cart' | t %}
                          <span :class="{ 'lg:block opacity-0 is-focus-button' : loading }">
                            <span class="flex items-center justify-center gap-3 rtl:flex-row-reverse">
                              {% render 'button-label', button_label: button_label, show_button_style: 'primary' %}
                            </span>
                          </span>
                          <div class="lg:inline-block w-4 h-4 md:w-5 md:h-5 absolute top-[calc(50%-8px)] left-[calc(50%-8px)] md:top-[calc(50%-10px)] md:left-[calc(50%-10px)]" x-show="loading" x-cloak>
                            {% render 'icon-alls', icon: 'icon-loading' %}
                          </div>
                        </button>
                      {% endif %}
                    </div>
                  {% endif %}
                {% when 'media_with_text' %}
                  {% liquid 
                    assign video_type = blank
                    assign cover_img = block.settings.image | default: blank
                    assign video_alt = block.settings.video_alt_text
                    if block.settings.video != null 
                      assign video_type = 'video_select'
                    elsif block.settings.video_url
                      assign video_type = block.settings.video_url.type
                      assign video_id = block.settings.video_url.id
                    endif 

                    assign icon_size = block.settings.icon_size

                    assign show_icon = false
                    unless video_type != blank or block.settings.image != blank
                      assign show_icon = true
                    endunless 
                  %}
                  <div x-slide-index="{{ forloop.index0 }}" class="splide__slide x-splide-slide flex overflow-y-auto scrollbar-body card-shop-the-look-{{ section.id }} card-shop-look-product-{{ section.settings.desktop_size }} mr-16 rtl:mr-0 rtl:ml-16 max-h-[400px] md:max-h-[unset]">
                    <div class="md:self-center flex{% if show_icon %}{% if block.settings.icon_position == "above" %} flex-col{% else %} flex-row{% endif %}{% else %} flex-col{% endif %} gap-x-4 md:gap-y-5 gap-y-4 w-full h-fit items-center flex-shrink-0 relative">
                      <div class="x-block-shop-the-look-media-{{ block.id }}{% unless show_icon %} w-full{% endunless %} ml-auto mr-auto{% if show_icon == false and block.settings.media_layout == 'second' %} order-last{% endif %}">
                        {% if video_type != blank %}
                          <div class="relative external-video h-full w-full rounded-none overflow-hidden{% if block.settings.enable_video_autoplay %} video-hero{% endif %} hover:h-full{% if settings.edges_type == 'rounded_corners' %} rounded-[10px]{% endif %}" 
                            x-intersect:leave="$store.xVideo.pause($el)"
                            {% if block.settings.enable_video_autoplay %}
                              @click.stop="$store.xVideo.togglePlay($el, $event)"
                              {% if video_type == 'video_select' %}x-intersect="$store.xVideo.play($el)"{% endif %}
                              {% if video_type == 'youtube' or video_type == 'vimeo' %}
                                x-intersect.once="$store.xVideo.externalLoad($el, '{{ video_type }}', '{{ video_id }}', false, '{{ video_alt }}')"
                                x-intersect="$store.xVideo.play($el)"
                              {% endif %}
                            {% else %}
                              {% if video_type == 'video_select' %}@click.prevent="$store.xVideo.mp4Thumbnail($el, $event)"{% endif %}
                              {% if video_type == 'youtube' or video_type == 'vimeo' %}@click.prevent="$store.xVideo.externalLoad($el, '{{ video_type }}', '{{ video_id }}', false, '{{ video_alt }}')"{% endif %}
                            {% endif %}
                            style="{% if block.settings.media_ratio == 'auto' %}padding-bottom: 56.25%;{% else %}padding-bottom: calc((1 / ({{ block.settings.media_ratio }}) * 100%));{% endif %}"
                          >
                            {%- render 'media-video', 
                              enable_video_autoplay: block.settings.enable_video_autoplay,
                              video_type: video_type,
                              video_id: video_id,
                              video_alt: video_alt,
                              video: block.settings.video,
                              cover_image: cover_img,
                              show_sound_control: block.settings.show_sound_control,
                              show_hero: show_hero
                            -%}
                          </div>
                        {% else %}
                          {% if block.settings.image != blank %}
                            <div class="w-full overflow-hidden h-auto{% if settings.edges_type == 'rounded_corners' %} rounded-[10px]{% endif %}">
                              <img
                                class="h-full w-full object-cover animate_transition_slide__image animate-Xpulse skeleton-image"
                                srcset="{{ block.settings.image | image_url: width: 450 }} 450w,
                                {{ block.settings.image | image_url: width: 750 }} 750w,
                                {{ block.settings.image | image_url: width: 900 }} 900w,
                                {{ block.settings.image | image_url: width: 1100 }} 1100w,
                                {{ block.settings.image | image_url: width: 1500 }} 1500w,
                                {{ block.settings.image | image_url }} {{ block.settings.image.width }}w"
                                src="{{ block.settings.image | image_url: width: 1500 }}"
                                alt="{{ block.settings.image.alt | escape }}"
                                {% if show_hero %}
                                  loading="eager"
                                  fetchpriority="high"
                                  decoding="sync"
                                {% else %}
                                  loading="{{ loading }}"
                                {% endif %} 
                                onload="requestAnimationFrame(() => { this.closest('.skeleton-image')?.classList.remove('animate-Xpulse', 'skeleton-image'); this.closest('.animate_transition_slide__image')?.classList.add('active'); });"
                                sizes="(min-width: 1024px){% if section.settings.full_width %} 50vw{% else %} {{ settings.page_width | divided_by: 2 }}px{% endif %}, (min-width: 768px) 50vw, 100vw"
                                width="{{ block.settings.image.width }}"
                                height="{{ block.settings.image.height }}"
                                style="object-position: {{ block.settings.image.presentation.focal_point }}; aspect-ratio: {{ block.settings.media_ratio }};"
                              >
                            </div>
                          {% else %}
                            {%- unless block.settings.icon == "none" -%}
                              {%- style -%}
                                .size-icon-{{ block.id }} {
                                  width: {{ icon_size }}px;
                                  height: {{ icon_size }}px;
                                }
                              {%- endstyle -%}
                              {% unless block.settings.custom_icon == blank and block.settings.another_icon == blank and block.settings.icon == 'another_icon' and block.settings.custom_image == blank %}
                                <div class="flex{% if block.settings.icon_position == "above" %} w-full justify-{{ block.settings.content_alignment }}{% else %} w-fit{% endif %}">
                                  <span class="inline-block color-icon--{{ block.id }} size-icon-{{ block.id }} {% if block.settings.icon_position == "above" %}content-alignment-{{ block.id }}{% endif %} flex-shrink-0">
                                    {% if block.settings.custom_image != blank %}
                                      {% # theme-check-disable ImgLazyLoading %}
                                      <img 
                                        src="{{ block.settings.custom_image | image_url: width: block.settings.icon_size }}"
                                        alt="{{ block.settings.custom_image.alt | escape }}"
                                        loading="{{ loading }}"
                                        width="{{ block.settings.custom_image.width }}"
                                        height="{{ block.settings.custom_image.height }}"
                                        style="object-position: {{ block.settings.custom_image.presentation.focal_point }}"
                                        class="object-cover size-icon-{{ block.id }} corner--{{ block.id }}"
                                      >
                                      {% # theme-check-enable ImgLazyLoading %}
                                    {% else %}
                                      {% if block.settings.custom_icon == blank %}
                                        {% if block.settings.another_icon != blank and block.settings.icon == 'another_icon' %}
                                          {% render 'icon-new-alls', icon: block.settings.another_icon %}
                                        {% else %}
                                          {% render 'icon-labels-bags', icon: block.settings.icon %}
                                        {% endif %}
                                      {% else %}
                                        {{ block.settings.custom_icon }}
                                      {% endif %}
                                    {% endif %}
                                  </span>
                                </div>
                              {%- endunless -%}
                            {%- endunless -%}
                          {% endif %}
                        {% endif %}
                      </div>
                      {{ block_heading_text }}
                    </div>
                  </div>
                {% when 'collection_with_text' %}
                  {% if block.settings.show_text_overlay and block.settings.collection_title_color.alpha != 0.0 or block.settings.collection_text_color.alpha != 0.0 %}
                    {% style %}
                      .x-shop-the-look-card-collection-{{ block.id }} {
                        {% if block.settings.collection_text_color.alpha != 0.0 %}
                          --colors-text: {{ block.settings.collection_text_color.red }}, {{ block.settings.collection_text_color.green }}, {{ block.settings.collection_text_color.blue }};
                        {% endif %}
                        {% if block.settings.collection_title_color.alpha != 0.0 %}
                          --colors-heading: {{ block.settings.collection_title_color.red }}, {{ block.settings.collection_title_color.green }}, {{ block.settings.collection_title_color.blue }};
                        {% endif %}
                      }
                    {% endstyle %}
                  {% endif %}
                  <div x-slide-index="{{ forloop.index0 }}" class="splide__slide x-splide-slide overflow-y-auto scrollbar-body card-shop-the-look-{{ section.id }} md:self-center w-full h-full flex-shrink-0 relative card-shop-look-product-{{ section.settings.desktop_size }} mr-16 rtl:mr-0 rtl:ml-16 flex flex-col gap-4 md:gap-5 max-h-[400px] md:max-h-[unset]">
                    {{ block_heading_text }}
                    <div class="x-shop-the-look-card-collection-{{ block.id }}">
                      {% render 'card-collection-shop-the-look',
                        card_collection: block.settings.collection,
                        desktop_size: section.settings.desktop_size,
                        ratio: block.settings.image_ratio,
                        block: block,
                        image: block.settings.image,
                        text_overlay: block.settings.show_text_overlay,
                        title_size: block.settings.collection_title_size,
                        text_size: block.settings.collection_text_size,
                        content_alignment: block.settings.content_alignment,
                        content_position: block.settings.collection_content_position,
                        image_overlay_opacity: block.settings.image_overlay_opacity,
                        collection_metafield: block.settings.collection_metafield,
                        show_item_count: block.settings.show_item_count
                      %}
                    </div>
                  </div>
              {%- endcase -%}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
  {% if has_add_all_modal %}
    {% liquid 
      assign ratio = 100
      case settings.product_image_ratio
        when 'portrait'
          assign ratio = 150
        when 'landscape'
          assign ratio = 75
        when 'wide'
          assign ratio = 56.25
        when '3/4'
          assign ratio = 133
      endcase

      assign message_preorder = 'general.preorder.message_preorder' | t
      if settings.message_preorder != blank
        assign message_preorder = settings.message_preorder
      endif 

      unless settings.applied_products_preorder == blank and settings.applied_collections_preorder == blank
        assign list_product = settings.applied_products_preorder | map: 'id'
        assign list_collection = settings.applied_collections_preorder | map: 'id'
      endunless
    %}
    <div x-cloak x-show="showModal" class="x-stl-product-variant-modal-{{ section.id }} flex items-end md:items-center fixed top-0 left-0 right-0 bottom-0 z-[90]">
      <div class="x-overlay absolute top-0 left-0 right-0 bottom-0 bg-[#acacac] bg-opacity-30"></div>
      <div 
        x-show="showModal"
        x-transition:enter="transition-all ease-in-out duration-500"
        x-transition:enter-start="opacity-0 transform translate-y-1/3"
        x-transition:enter-end="opacity-100 transform translate-y-0"
        x-transition:leave="transition-all ease-in-out duration-500"
        x-transition:leave-end="opacity-0 transform translate-y-1/3"
        class="product-variant-modal w-full ml-auto mr-auto pl-0 pr-0 md:pl-5 md:pr-5 lg:pl-16 lg:pr-16 lg:ml-auto lg:mr-auto z-10"
      >
        <div
          @click.away="closeVariantContainer()" 
          class="flex flex-col md:h-auto gap-6 bg-[rgba(var(--background-color))] shadow-popup pt-5 pl-10 pr-10 pb-10{% if settings.edges_type == 'rounded_corners' %} rounded-t-[10px] md:rounded-[10px]{% endif %}"
        >
          <div class="flex justify-between items-center">
            <p class="h3 leading-tight p-break-words w-[calc(100%-40px)] font-semibold">{{ 'quiz.select_options' | t }}</p>
            <button aria-label="{{ 'accessibility.close' | t }}" id="QuickViewClose" class="w-fit z-10 group-close-btn icon-close-container rounded-full" @click.prevent="closeVariantContainer()">
              {% render 'icon-alls', icon: 'icon-close', animation_class: 'icon-close-animation' %}
            </button>
          </div>
          {% style %}
            #variant-container-{{ section.id }} .card-product {
              width: calc(80% + max(0%, (2 - var(--product-num)) * 20%));
            }
            
            #variant-container-{{ section.id }} .card-product:not(:last-child) {
              {% if is_rtl %}
                margin-left: 16px;
              {% else %}
                margin-right: 16px;
              {% endif %}
            }
            .splide-progress-bar-{{ section.id }} {
              width: calc(100% / var(--product-num));
            }
            @media (min-width: 768px) {
              .x-stl-product-variant-modal-{{ section.id }} .product-variant-modal {
                --col-num: min(var(--product-num), 3);
                max-width: calc(var(--col-num) * (25% + 16px) + 208px / var(--col-num) - 16px);
              }
              #variant-container-{{ section.id }} .card-product {
                width: calc((100%  - 16px * (var(--col-num) - 1)) / var(--col-num));
              }
              .splide-progress-bar-{{ section.id }} {
                width: calc(300% / var(--product-num));
              }
            }
            @media (min-width: 1536px) {
              .x-stl-product-variant-modal-{{ section.id }} .product-variant-modal {
                max-width: calc(var(--col-num) * (20% + 16px) + 208px / var(--col-num) - 16px);
              }
            }
          {% endstyle %}
          <div 
            id="variant-splide-{{ section.id }}"
            class="x-splide splide w-full visible overflow-hidden"
            x-data-slider="{{ section.id }}"
            x-init='document.addEventListener("eurus:{{ section.id }}:splide-ready", () => {
              $store.xSplide.load($el, {
                "speed": 1000,
                "pagination": false, 
                "mediaQuery": "min",
                "updateOnMove": "true",
                "progressBar": "4",
                "progressBarHeader": "true",
                "omitEnd": "true",
                {%- if is_rtl %} 
                  "direction": "rtl",
                {%- endif %}
                "autoWidth": "true",
                "perMove": 1,
                "breakpoints": {
                  300: {
                    "focus": "center",
                  },
                  768: {
                    "focus": 0,
                  }
                },
                "events": [
                  {
                    "event": "overflow",
                    "callback": (isOverflow) => {
                      $el.splide.options = {
                        arrows: isOverflow,
                        drag: isOverflow
                      } 
                    }
                  }
                ]
              })
            }, { once: true })'
          >
            <div class="splide__arrows items-center justify-center gap-3 w-full order-2 hidden md:flex">
              <button 
                class="splide__arrow splide__arrow--prev button-arrow pt-3 pb-3 pl-3 pr-3 rounded-full border md:border-0 border-solid z-10 w-11 h-11 after:text-[20px] rtl:rotate-180 opacity-100 disabled:cursor-not-allowed disabled:opacity-30 md:block md:absolute md:top-1/2 md:-mt-6 rtl:md:left-auto rtl:md:right-0 md:left-0 md:duration-200 md:opacity-60 hover:opacity-100 md:transition-all md:ease-in-out md:-translate-x-full rtl:md:translate-x-full"
                aria-label="{{ 'accessibility.previous_slide' | t }}"
              >
                <span class="hidden">{{ 'accessibility.previous_slide' | t }}</span>
                {% render 'icon-labels-bags', icon: 'chevron-left' %}
              </button>
              <button 
                class="splide__arrow splide__arrow--next button-arrow pt-3 pb-3 pl-3 pr-3 rounded-full border md:border-0 border-solid z-10 w-11 h-11 after:text-[20px] rtl:rotate-180 opacity-100 disabled:cursor-not-allowed disabled:opacity-30 md:block md:absolute md:top-1/2 md:-mt-6 rtl:md:right-auto rtl:md:left-0 md:right-0 md:duration-200 md:opacity-60 hover:opacity-100 md:transition-all md:ease-in-out md:translate-x-full rtl:md:-translate-x-full"
                aria-label="{{ 'accessibility.next_slide' | t }}"
              >
                <span class="hidden">{{ 'accessibility.next_slide' | t }}</span>
                {% render 'icon-labels-bags', icon: 'chevron-right' %}
              </button>
            </div>
            <div :class="productNum > 3 && 'md:cursor-grab'" class="splide__track w-full lg:pl-0 lg:pr-0">
              <div 
                id="variant-container-{{ section.id }}" 
                x-intersect.full="$el.closest('.splide')?.splide?.refresh()"
                class="splide__list relative md:flex md:w-full flex w-full max-h-[80vh] scrollbar-body md:h-auto"
              >
                {% for block in section.blocks %}
                  {% if block.type == 'look' and block.settings.products != blank and block.settings.products.count > 1 %}
                    {% assign products_with_variant = block.settings.products | where: 'has_only_default_variant', false %}
                    {% if products_with_variant.size > 0 %}
                      <template id="card-products-template-{{ block.id }}">
                        {% for product_with_variant in products_with_variant %}
                          {% liquid
                            assign can_show_preorder = false
                            if settings.preorder_show == 'yes' or settings.preorder_show == 'on_backordered' and product.selected_or_first_available_variant.inventory_policy == 'continue' and product.selected_or_first_available_variant.inventory_quantity < 1 and product.selected_or_first_available_variant.inventory_management != nil
                              if settings.applied_products_preorder == blank and settings.applied_collections_preorder == blank
                                assign can_show_preorder = true
                              else 
                                if list_product contains product.id
                                  assign can_show_preorder = true
                                else
                                  for col in product.collections
                                    if list_collection contains col.id
                                      assign can_show_preorder = true
                                      break
                                    endif
                                  endfor
                                endif
                              endif
                            endif 
                            assign disable_cart_edt = false
                            if product.gift_card? or can_show_preorder and settings.hide_when_pre_order
                              assign disable_cart_edt = true
                            endif
                          %}
                          {% render 'card-product-quiz', 
                            card_product: product_with_variant,
                            section_id: section.id,
                            product_card_id: product_with_variant.id,
                            index: forloop.index,
                            loading: loading,
                            is_rtl: is_rtl,
                            media_aspect_ratio: section.settings.image_ratio,
                            data_for_customer_event: data_for_customer_event,
                            can_show_preorder: can_show_preorder,
                            message_preorder: message_preorder,
                            disable_cart_edt: disable_cart_edt
                          %}
                        {% endfor %}
                      </template>
                    {% endif %}
                  {% endif %}
                {% endfor %}
              </div>
            </div>
            <div :class="productNum > 1 ? ( productNum > 3 ? 'flex' : 'flex md:hidden' ) : 'hidden'" class="splide-progress-container-{{ section.id }} items-center w-full gap-5 mt-2.5 md:mt-5">
              <div class="splide-progress inline-block grow rounded-md">
                <div class="splide-progress-bar-{{ section.id }} splide-progress-bar rounded-md"></div>
              </div>
            </div>
          </div>
          {% assign button_label = 'products.product.add_all_to_cart' | t %}
          <button id="variant-popup-add-all-{{ section.id }}" x-intersect="checkSelectedVariants($el)" @click="handleAddToCart($el, '.x-container-shop-the-look' , `.x-shop-the-look-products-${showModalBlock}.is-active .product-form, #variant-container-{{ section.id }} .card-product form`, '{{ settings.name_edt | default: "Note" }}')" class="button button-solid relative w-full disabled:cursor-not-allowed disabled:opacity-30 cursor-pointer pt-3 pb-3 pl-6 pr-6 leading-normal text-center font-semibold">
            <span :class="loading && 'invisible'">
              {% render 'button-label', button_label: button_label, show_button_style: 'primary' %}
            </span>
            <div x-show="loading" class="w-4 h-4 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
              {% render 'icon-alls', icon: 'icon-loading' %}
            </div>
          </button>
        </div>
      </div>
    </div>
  {% endif %}
</div>
<script src="{{ 'product-list.js' | asset_url }}" defer></script>
{% if section.settings.image_alignment == 'layered' %}
  <script src="{{ 'tooltips-position.js' | asset_url }}" defer></script> 
{% endif %}
