{%- liquid
  assign url_collection = collection
  if settings.disable_collection_context_url
    assign url_collection = nil
  endif
-%}
{% style %}
  .labe-stl .x-badge-text {
    padding-left: 1rem;
    padding-right: 1rem;
    padding-top: 0.25rem;
    padding-bottom: 0.25rem;
  }
  .labe-stl img {
    height: 3rem;
    width: auto;
    -o-object-fit: contain;
    object-fit: contain;
  }
  .labe-stl .icon-label {
    height: calc(var(--base-font-size-mobile) * 1.2);
    width: calc(var(--base-font-size-mobile) * 1.2);
  }
  .labe-stl .x-badge-container {
    text-align: start;
  }
  .labe-stl .label-img {
    width: 100%;
  }
  @media (min-width: 1024px) {
    .card-shop-look-product-small {
      padding-left: 3rem;
      padding-right: 3rem;
      padding-top: 1rem;
    }
  }
  @media (min-width: 1280px) {
    .card-shop-look-product-small {
      padding-left: 5rem;
      padding-right: 5rem;
      padding-top: 4rem;
    }
  }
  @media (min-width: 1536px) {
    .card-shop-look-product-small {
      padding-left: 9rem;
      padding-right: 9rem;
    }
  }
  @media (min-width: 1024px) {
    .card-shop-look-product-medium {
      padding-left: 2rem;
      padding-right: 2rem;
      padding-top: 1.5rem;
    }
  }
  @media (min-width: 1280px) {
    .card-shop-look-product-medium {
      padding-left: 5rem;
      padding-right: 5rem;
      padding-top: 3rem;
    }
  }
{% endstyle %}
{% liquid 
  assign heading_base_size = settings.heading_base_size | times: 0.0225
  assign heading_size = section.settings.heading_size | times: 0.01 | times: heading_base_size
  assign image_url_mobile = section.settings.image_mobile | default: section.settings.image_desktop
  assign disable_quickview = true
  if section.settings.show_quickview
    assign disable_quickview = false
  endif
  if settings.lang_direction contains request.locale.iso_code
    assign is_rtl = true
  else
    assign is_rtl = false
  endif
  if settings.enable_lazy_loading_image
    assign loading = 'lazy'
  else
    assign loading = 'eager'
  endif

  if section.settings.product_card_edges == 'rounded_corners' or section.settings.product_card_edges == 'adapt' and settings.edges_type == 'rounded_corners'
    assign rounded_corner = true
  else
    assign rounded_corner = false
  endif
  assign media_aspect_ratio = section.settings.image_ratio

  assign ratio = 100
  case media_aspect_ratio
    when "portrait"
      assign ratio = 150
    when "landscape"
      assign ratio = 75
    when "wide"
      assign ratio = 56.25
    when "3/4"
      assign ratio = 133
  endcase
  assign show_hero = section.settings.show_hero
  if section.index <= 2 
    assign show_hero = true
  endif
%} 
{%- style -%} 
  @media (max-width: 767px) {
    .card-shop-the-look-{{ section.id }} {
      padding-left: 20px;
      padding-right: 20px;
    }
  }
  .font-shop-the-look-{{ section.id }} {
    font-size: {{ heading_base_size | times: 0.5 }}rem;
  }

  @media (min-width: 768px) {
    .font-shop-the-look-{{ section.id }} {
      font-size: {{ heading_base_size | times: 0.65 }}rem;
    }
  }
  .layered-shadow-{{ section.id }} {
    box-shadow: 0px 0px 68px 0px rgba(0, 0, 0, 0.15);
  }
  .tooltips-flip-down {
    --tw-translate-y: 0;
    transform-origin: top center;
  }
  .tooltips-flip-up {
    --tw-translate-y: calc(-100% + 64px);
    transform-origin: bottom center;
  }
  .heading-{{ section.id }} {
    font-size: {{ heading_size | times: 0.6 }}rem;
  }
  {%- if image_url_mobile != blank -%} 
    .image-{{ section.id }} {
      object-position: {{ image_url_mobile.presentation.focal_point }}
    }
  {%- endif -%}
  {% if section.settings.mobile_height == 'natural' %}
    @media (max-width: 768px) {
      .shop-the-look-image-{{ section.id }} {
        {% if section.settings.image_mobile != blank or section.settings.image_desktop != blank %}
          height: auto;
        {% else %}
          height: 400px;
        {% endif %}
      }
      .shop-the-look-image-{{ section.id }}::before {
        content: '';
        height: 0;
        padding-bottom: {{ 1 | divided_by: image_url_mobile.aspect_ratio | times: 100 }}%;
        display: block;
      }
    }
  {% endif %}
  @media (min-width: 767px) {
    .heading-{{ section.id }} {
      font-size: {{ heading_size }}rem;
    }
    {%- if section.settings.image_desktop != blank -%} 
      .image-{{ section.id }} {
        object-position: {{ section.settings.image_desktop.presentation.focal_point }}
      }
    {%- endif -%}
    {% if section.settings.desktop_height == 'natural' %}
      .shop-the-look-image-{{ section.id }} {
        {% if section.settings.image_desktop != blank %}
          height: auto;
        {% else %}
          height: 750px;
        {% endif %}
      }
      .shop-the-look-image-{{ section.id }}::before {
        content: '';
        height: 0;
        padding-bottom: {{ 1 | divided_by: section.settings.image_desktop.aspect_ratio | times: 100 }}%;
        display: block;
      }
    {% endif %}
  }
  {%- if section.settings.show_rating -%}
    .text-rating-size-{{ section.id }} {
      font-size: {{ settings.text_base_size | times: 0.007 }}rem;
    }
  {% endif %}
  .section-padding-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media (min-width: 768px) { 
    .section-padding-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if section.settings.show_section_divider or section.settings.show_section_divider_mobile -%}
  {% render 'section-divider' %}
{%- endif -%}

<div x-data="xProductsList('{{ section.id }}')" class="x-container-shop-the-look {% if section.index == 1 %}preload-image {% endif %}ltr section-padding-{{ section.id }}">
  {%- if section.settings.subheading != blank or section.settings.heading != blank or section.settings.text != blank -%}
    <div class="x-block-shop-the-look-header empty:hidden mb-6 text-{{ section.settings.heading_alignment }} rtl:text-{% if section.settings.heading_alignment == 'center' %}center{% elsif section.settings.heading_alignment == 'left' %}right{% else %}left{% endif %}
      {%- if section.settings.full_width_mobile %} pr-0 pl-0{% else %} pr-5 pl-5{% endif -%}
      {% if section.settings.full_width %}{% if section.settings.padding_full_width %} md:pl-5 md:pr-5{% endif %}{% else %} x-pgw page-width md:pl-5 md:pr-5{% endif %}"
    >
      <div class="mb-5 md:mb-9 pb-2">
        {%- if section.settings.subheading != blank -%}
          <div class="mb-1.5{% unless settings.disable_heading_animation %} overflow-hidden{% endunless %}"{% unless settings.disable_heading_animation %} x-intersect.once="$el.querySelector('.anm-move-up')?.classList.add('active-anm-heading')"{% endunless %}>
            <p class="rte{% unless settings.disable_heading_animation %} anm-move-up{% endunless %}">{{ section.settings.subheading }}</p>
          </div>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          {% render 'heading-highlight',
            headingId: section.id,
            heading: section.settings.heading,
            highlight_type: section.settings.highlight_type,
            class: 'h2 block leading-tight p-break-words',
            heading_tag: section.settings.heading_tag,
            animation_heading: true
          %}
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte mt-2">{{ section.settings.text }}</div>
        {% endif %}  
      </div>  
    </div>
  {% endif %}
  <div class="flex flex-wrap relative items-center{% if section.settings.image_alignment == "right" %} md:flex-row-reverse rtl:md:flex-row{% endif %}{% if section.settings.image_alignment == "left" %} md:flex-row rtl:md:flex-row-reverse{% endif %}{% if section.settings.full_width %}{% if section.settings.padding_full_width %} md:pl-5 md:pr-5{% endif %}{% else %} x-pgw page-width pl-0 pr-0 md:pl-5 md:pr-5{% endif %}">
    <div 
      class="w-full{% unless section.settings.image_alignment == "layered" %}{% if section.settings.desktop_size != 'large' %} md:w-[55%]{% else %} md:w-3/5{% endif %}{% endunless %}{% unless section.settings.full_width_mobile %} pl-5 pr-5 md:pl-0 md:pr-0{% endunless %}"
    >
      <div 
        id="x-hotspot-{{ section.id }}" 
        class="shop-the-look-image shop-the-look-image-{{ section.id }} w-full relative h-[{{ section.settings.mobile_height }}] md:h-[{{ section.settings.desktop_height }}]"
        {% if section.settings.image_alignment == 'layered' %} 
          x-data="{ active : -1 }"
          @click.stop="active = -1"
          @click.away.stop="active = -1"
          x-intersect.once="$el.classList.remove('bg-[#c9c9c9]'); document.addEventListener('eurus:cart:items-changed', () => { active = -1 })"
        {% else %}
          x-intersect.once="$el.classList.remove('bg-[#c9c9c9]')"
        {% endif %}
      >
        {% # theme-check-disable ImgLazyLoading %}
        {% if section.settings.image_desktop != blank %}
          <picture class="block absolute top-0 md:static h-full w-full overflow-hidden{% if section.settings.full_width %} md:rounded-none{% else %}{% if settings.edges_type == 'rounded_corners' %} md:rounded-[10px]{% endif %}{% endif %}{% unless section.settings.full_width_mobile %}{% if settings.edges_type == 'rounded_corners' %} rounded-[10px]{% endif %}{% endunless %}">
            <source 
              srcset="{{ image_url_mobile | image_url: width: 375 }} 375w,
              {{ image_url_mobile | image_url: width: 450 }} 450w,
              {{ image_url_mobile | image_url: width: 750 }} 750w,
              {{ image_url_mobile | image_url: width: 900 }} 900w" 
              media="(max-width: 767px)" 
              size="{% unless section.settings.full_width_mobile %}calc(100vw - 2.5rem){% else %}100vw{% endunless %}"
            />
            <img
              class="image-{{ section.id }} animate_transition_slide__image h-full w-full absolute top-0 left-0 object-cover animate-Xpulse skeleton-image
                {%- unless section.settings.desktop_height == 'natural' %} md:relative{% endunless -%}
                {%- if section.settings.image_mobile != blank and request.design_mode %} hidden md:block{% endif -%}
                {% if section.settings.full_width %} md:rounded-none{% else %}{% if settings.edges_type == 'rounded_corners' %} md:rounded-[10px]{% endif %}{% endif %}{% unless section.settings.full_width_mobile %}{% if settings.edges_type == 'rounded_corners' %} rounded-[10px]{% endif %}{% endunless %}
              "
              srcset="{{ section.settings.image_desktop | image_url: width: 750 }} 750w,
              {{ section.settings.image_desktop | image_url: width: 900 }} 900w,
              {{ section.settings.image_desktop | image_url: width: 1100 }} 1100w,
              {{ section.settings.image_desktop | image_url: width: 1500 }} 1500w,
              {{ section.settings.image_desktop | image_url: width: 1780 }} 1780w,
              {{ section.settings.image_desktop | image_url: width: 2000 }} 2000w,
              {{ section.settings.image_desktop | image_url: width: 3000 }} 3000w,
              {{ section.settings.image_desktop | image_url: width: 3840 }} 3840w"
              src="{{ section.settings.image_desktop | image_url: width: 1080 }}"
              alt="{{ section.settings.image_desktop.alt | escape }}"
              {% if show_hero %}
                loading="eager"
                fetchpriority="high"
                decoding="sync"
              {% else %}
                loading="{{ loading }}"
              {% endif %}
              onload="requestAnimationFrame(() => { this.closest('.skeleton-image')?.classList.remove('animate-Xpulse', 'skeleton-image'); this.closest('.animate_transition_slide__image')?.classList.add('active'); })"
              sizes="{% unless section.settings.full_width %}(min-width: {{ settings.page_width }}px) {% if section.settings.image_alignment == 'layered' %}{{ settings.page_width }}px{% else %}{{ settings.page_width | times: 0.6 }}px{% endif %}, {% endunless %}(min-width: 768px) {% if section.settings.image_alignment == 'layered' %}100vw{% else %}60vw{% endif %}, {% unless section.settings.full_width_mobile %}calc(100vw - 2.5rem){% else %}100vw{% endunless %}"
              width="{{ section.settings.image_desktop.width }}"
              height="{{ section.settings.image_desktop.height }}"
            />
          </picture>
        {% else %}
          <div class="w-full h-full absolute {% unless section.settings.desktop_height == 'natural' %}md:relative{% endunless %} top-0 left-0 bg-[#c9c9c9] text-[#acacac] {% if section.settings.image_mobile != blank %} hidden{% endif %} md:block mr-auto ml-auto">
            {%- render 'icon-placeholder', icon: 'icon-collection', class: 'w-full h-full' %}
          </div>
        {% endif %}
        {%- if section.settings.image_mobile != blank and request.design_mode or section.settings.image_desktop == blank -%}
          <img
            srcset="{{ section.settings.image_mobile | image_url: width: 375 }} 375w,
            {{ section.settings.image_mobile | image_url: width: 450 }} 450w,
            {{ section.settings.image_mobile | image_url: width: 750 }} 750w,
            {{ section.settings.image_mobile | image_url: width: 900 }} 900w,
            {{ section.settings.image_mobile | image_url: width: 1100 }} 1100w,
            {{ section.settings.image_mobile | image_url: width: 1500 }} 1500w"
            sizes="100vw"
            src="{{ section.settings.image_mobile | image_url: width: 750 }}"
            alt="{{ section.settings.image_mobile.alt | escape }}"
            class="object-cover absolute top-0 left-0 h-full w-full animate_transition_slide__image animate-Xpulse skeleton-image{% if section.settings.image_mobile != blank %} md:hidden{% endif %}
            {% if section.settings.full_width %} md:rounded-none{% else %}{% if settings.edges_type == 'rounded_corners' %} md:rounded-[10px]{% endif %}{% endif %}{% unless section.settings.full_width_mobile %}{% if settings.edges_type == 'rounded_corners' %} rounded-[10px]{% endif %}{% endunless %}"
            {% if show_hero %}
              loading="eager"
              fetchpriority="high"
              decoding="sync"
            {% else %}
              loading="{{ loading }}"
            {% endif %}
            onload="requestAnimationFrame(() => { this.closest('.skeleton-image')?.classList.remove('animate-Xpulse', 'skeleton-image'); this.closest('.animate_transition_slide__image')?.classList.add('active'); });"
            width="{{ section.settings.image_mobile.width }}"
            height="{{ section.settings.image_mobile.height }}"
            style="object-position: {{ section.settings.image_mobile.presentation.focal_point }}"
          />  
        {%- endif %}
        {% # theme-check-enable ImgLazyLoading %}
        {% for block in section.blocks %}
          {% assign hotspot_desktop_horizontal = block.settings.hotspot_desktop_horizontal %}
          {% assign hotspot_desktop_vertical = block.settings.hotspot_desktop_vertical %}
          {% if block.settings.heading != blank or block.settings.text != blank %}
            {% capture block_heading_text %}
              <div class="x-block-shop-the-look{% if block.type == 'media_with_text' %}-media{% endif %}-content-{{ block.id }} flex flex-col text-{{ block.settings.content_alignment }} rtl:text-{% if block.settings.content_alignment == 'center' %}center{% elsif block.settings.content_alignment == 'left' %}right{% else %}left{% endif %}">
                {% if block.settings.heading != blank %}
                  <div class="h3 w-full font-medium font-shop-the-look-{{ section.id }}">{{ block.settings.heading }}</div>
                {% endif %}
                {% if block.settings.text != blank %}
                  <div class="rte w-full text-[rgba(var(--colors-text))]">{{ block.settings.text }}</div>
                {% endif %}
              </div>
            {% endcapture %}
          {% else %}
            {% assign block_heading_text = blank %}
          {% endif %}
          {% style %}
            .hotspot-{{ block.id }} {
              left:{{ block.settings.hotspot_mobile_horizontal }}%;
              top:{{ block.settings.hotspot_mobile_vertical }}%;
              transform: translate(-{{ block.settings.hotspot_mobile_horizontal }}%,-{{ block.settings.hotspot_mobile_vertical }}%);
              {% unless block.settings.color_hotspot.alpha == 0.0 %}
                --colors-background: {{ block.settings.color_hotspot.red }}, {{ block.settings.color_hotspot.green }}, {{ block.settings.color_hotspot.blue }};
              {% endunless %}
            }
            @media (min-width: 767px) {
              .hotspot-{{ block.id }} {
                left:{{ hotspot_desktop_horizontal }}%;
                top:{{ hotspot_desktop_vertical }}%;
                transform: translate(-{{ hotspot_desktop_horizontal }}%,-{{ hotspot_desktop_vertical }}%);
              }
            }
            {% if section.settings.image_alignment == 'layered' %}
              .tooltip-content {
                transform: translate(var(--tw-translate-x), var(--tw-translate-y)) rotate(var(--tw-rotate)) skewX(var(--tw-skew-x)) skewY(var(--tw-skew-y)) scaleX(var(--tw-scale-x)) scaleY(var(--tw-scale-y));
              }
              .tooltip-content > div {
                max-height: 50vh;
              }
            {% endif %}
          {% endstyle %}
          {% liquid 
            if block.type == 'look'
              assign card_product = blank
              if block.settings.products != blank and block.settings.products.count == 1
                assign card_product = block.settings.products | first
              elsif block.settings.product != blank and block.settings.products == blank
                assign card_product = block.settings.product
              endif
            endif
          %}
          <button
            index="{{ forloop.index }}" 
            class="opacity-0 absolute pt-5 pb-5 pl-5 pr-5 md:pt-6 md:pb-6 md:pl-6 md:pr-6 x-hotspot hotspot-{{ block.id }} text-[rgba(var(--colors-background))] hotspot-color-{{ section.id }} group"
            {% if section.settings.image_alignment == 'layered' %} x-effect="active == {{ forloop.index }} && window.matchMedia('(min-width: 768px)').matches && window.EurusReportCardViews && window.EurusReportCardViews($el)" :class="active == {{ forloop.index }} && 'md:z-[60] z-40'" @click.stop="active = {{ forloop.index }}"{% endif %}
            aria-label="{{ 'accessibility.hotspot' | t }}" {{ block.shopify_attributes }}
            x-intersect.once="$el.classList.add('opacity-100')"
          >
            {% if section.settings.image_alignment == 'layered' %}           
              {%- case block.type -%}
                {% when 'look' %}
                  <div class="spot-{{ block.id }} flex w-3 h-3 md:h-4 md:w-4 relative"
                    @click.stop="active == {{ forloop.index }} ? active = -1 : active = {{ forloop.index }}"
                    x-intersect:leave.threshold.99="(active == {{ forloop.index }}) && (active = -1)"
                  >
                    <div class="duration-300 ease-in-out" :class="active == {{ forloop.index }} && 'active-hotspot:scale-[1.8] scale-[1.8]'">
                      <span class="animate-[pingHotspot_2s_ease-in-out_infinite] absolute inline-flex h-full w-full rounded-full bg-[rgba(var(--colors-background),0.2)]"></span>
                      <span class="relative inline-flex rounded-full h-3 w-3 md:h-4 md:w-4 duration-300 bg-[rgba(var(--colors-background))]"></span>
                    </div>
                  </div>
                  <div 
                    x-data="xTooltips()"
                    x-ref="tooltips" 
                    x-intersect.once="handleTooltipsPosition()"
                    class="hidden pointer-events-none md:flex absolute top-0{% if hotspot_desktop_horizontal >= 50 %} left-0 -translate-x-full{% else %} left-[calc(100%-1rem)]{% endif %} tooltips-{{ block.id }} min-w-[22.5rem] cursor-default transition-[opacity,visibility,transform] duration-300 ease-in-out" :class="active == {{ forloop.index }} ? 'visible opacity-100 scale-100' : 'invisible opacity-0 scale-110'" 
                    x-cloak
                  > 
                    {% if block.settings.products == blank or block.settings.products.count == 1 %}
                        {%- capture data_for_customer_event -%}
                          {
                            "product": {
                              "title": "{{ card_product.title | escape }}",
                              "listName": "{{ collection.title | default: '' | escape }}",
                              "sku": "{{ card_product.id }}",
                              "currencyCode": "{{ cart.currency.iso_code }}",
                              "price": {{ card_product.price }},
                              "vendor": "{{ card_product.vendor }}"
                            }
                          }
                        {%- endcapture %}
                        <div class="pointer-events-auto tooltip-content{% if hotspot_desktop_horizontal >= 50 %} order-0{% else %} order-2{% endif %} transition-transform duration-300 ease-in-out layered-shadow-{{ section.id }} min-w-[22.5rem]  bg-[rgba(var(--background-color),1)] pl-4 pr-4 pt-4 pb-4
                          {%- if rounded_corner %} rounded-xl{% endif -%}
                          {%- if hotspot_desktop_vertical < 50 -%}
                            {%- if hotspot_desktop_horizontal < 6 %} rounded-tl-none{% endif -%}
                            {%- if hotspot_desktop_horizontal > 94 %} rounded-tr-none{% endif -%}
                          {%- else -%}
                            {%- if hotspot_desktop_horizontal < 6 %} rounded-bl-none{% endif -%}
                            {%- if hotspot_desktop_horizontal > 94 %} rounded-br-none{% endif -%}
                          {%- endif -%}"
                        >
                          {{ block_heading_text }}
                          <div class="flex gap-4">
                            {%- if card_product != blank -%}
                              <s-view-event
                                data-view-on-reveal
                                view-event-trigger="manual"
                                view-event-payload='{{ card_product | standard_event_data: "view", context: "collection" | escape }}'></s-view-event>
                            {%- endif -%}
                            <div class="w-2/5 max-w-[5.25rem]">
                              <a 
                                href="{{ card_product.url }}"
                                aria-label="{{ card_product.title | escape }}" 
                                class="block disable-effect h-full"
                                @click='$store.xCustomerEvent.fire("product_selected", $el)'
                                x-customer-event-data="{{ data_for_customer_event | escape }}"
                              >
                                <div class="w-full relative overflow-hidden{% unless media_aspect_ratio == "natural" %} pb-[{{ ratio }}%]{% else %}{% unless card_product.featured_media %} pb-[100%]{% endunless %}{% if card_product.featured_media.media_type == "model" or card_product.featured_media == blank %} pb-[100%]{% endif %}{% endunless %}{% if settings.edges_type == 'rounded_corners' %} rounded-[10px]{% endif %}"
                                  {% if media_aspect_ratio == "natural" and card_product.featured_media and card_product.featured_media.media_type != "model" %} 
                                    style="height:0; padding-bottom: {{ 100.0 | divided_by: card_product.featured_media.aspect_ratio }}%;"
                                  {% endif %}
                                >
                                  {%- if card_product.featured_media -%}
                                    {% # theme-check-disable ImgLazyLoading %}
                                    <img
                                      srcset="{{ card_product.featured_media | image_url: width: 225 }} 225w,
                                        {{ card_product.featured_media | image_url: width: 375 }} 375w,
                                        {{ card_product.featured_media | image_url: width: 450 }} 450w,
                                        {{ card_product.featured_media | image_url: width: 750 }} 750w,
                                        {{ card_product.featured_media | image_url: width: 900 }} 900w,
                                        {{ card_product.featured_media | image_url: width: 1100 }} 1100w,
                                        {{ card_product.featured_media | image_url: width: 1500 }} 1500w,
                                        {{ card_product.featured_media | image_url: width: card_product.featured_media.width }} {{ card_product.featured_media.width }}w" 
                                      src="{{ card_product.featured_media | image_url: width: 1080 }}"
                                      sizes="{% unless section.settings.full_width %}(min-width: {{ settings.page_width }}px) {{ settings.page_width | times: 0.4 }}px, {% endunless %}(min-width: 767px) 40vw, calc(50vw - 50px))"
                                      alt="{{ card_product.featured_media.alt | split: "#" | first | escape }}"
                                      class="motion-reduce object-cover w-full h-full absolute top-0 right-0 animate-Xpulse skeleton-image"
                                      loading="{{ loading }}"
                                      onload="requestAnimationFrame(() => { this.closest('.skeleton-image')?.classList.remove('animate-Xpulse', 'skeleton-image'); });"
                                      width="{{ card_product.featured_media.width }}"
                                      height="{{ card_product.featured_media.height }}"
                                    >
                                    {% # theme-check-enable ImgLazyLoading %}
                                  {%- else -%} 
                                    {%- render 'icon-placeholder', icon: 'icon-product', class: 'w-full h-full bg-[#c9c9c9] absolute top-0 right-0' %}
                                  {%- endif -%}
                                </div>
                              </a>
                            </div>
