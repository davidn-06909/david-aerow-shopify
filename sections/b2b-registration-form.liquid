{% style %}
  .contact-date-time::-webkit-datetime-edit {opacity: 0}
  .contact-date-time.focus-input::-webkit-datetime-edit {-webkit-transition: 200ms;transition: 200ms;opacity: 1}
  .contact-date-time.focus-input+.label-date, .contact-date-time:focus+.label-date, .rtl .contact-date-time+.label-date {font-size: .75rem;line-height: 1rem;top: .75rem}
  .contact-date-time.focus-input, .contact-date-time:focus, .rtl .contact-date-time {padding-top: 1.25rem;padding-bottom: .5rem}
  @supports (-moz-appearance: none){
    .contact-date-time.input-date-time+.label-date {font-size: .75rem;line-height: 1rem;top: .75rem}
    .contact-date-time.input-date-time {padding-top: 1.25rem;padding-bottom: .5rem}}
{% endstyle %}
{% liquid
  assign heading_size = section.settings.heading_size | times: settings.heading_base_size | times: 0.000225
  assign form_id = 'B2bRegistrationForm-' | append: section.id
  if settings.lang_direction contains request.locale.iso_code
    assign is_rtl = true
  else
    assign is_rtl = false
  endif
  #set padding left and right when set up background color light or dark
  if section.settings.full_width_mobile
    assign padding_bg = 'pr-5 pl-5'
  else
    if section.settings.background_color_light.alpha != 0.0
      if section.settings.background_color_dark.alpha != 0.0
        assign padding_bg = 'pr-5 pl-5'
      else
        assign padding_bg = 'pr-5 pl-5 dark:pr-0 dark:pl-0'
      endif
    else
      if section.settings.background_color_dark.alpha != 0.0
        assign padding_bg = 'dark:pr-5 pl-5'
      endif
    endif
  endif
%}
{%- style -%}
  .section-padding-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media (min-width: 768px) {
    .section-padding-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
  #shopify-section-{{ section.id }} {
    {% if section.settings.background_color_light.alpha == 0.0 %}
      background: transparent;
      --background-color: {{ settings.colors_background.red }}, {{ settings.colors_background.green }}, {{ settings.colors_background.blue }};
    {% else %}
      background: {{ section.settings.background_color_light }};
      --background-color: {{ section.settings.background_color_light.red }}, {{ section.settings.background_color_light.green }}, {{ section.settings.background_color_light.blue }};
    {% endif %}
  }
  .dark #shopify-section-{{ section.id }} {
    {% if section.settings.background_color_dark.alpha == 0.0 %}
      background: transparent;
      --background-color: {{ settings.colors_dark_background.red }}, {{ settings.colors_dark_background.green }}, {{ settings.colors_dark_background.blue }};
    {% else %}
      background: {{ section.settings.background_color_dark }};
      --background-color: {{ section.settings.background_color_dark.red }}, {{ section.settings.background_color_dark.green }}, {{ section.settings.background_color_dark.blue }};
    {% endif %}
  }
{%- endstyle -%}
{%- if section.settings.heading != blank -%}
  {%- style -%}
    .heading-{{ section.id }} { font-size: {{ heading_size | times: 0.6 }}rem; }
    @media screen and (min-width: 1025px) {
      .heading-{{ section.id }} {
        font-size: {{ heading_size }}rem;
      }
    }
  {%- endstyle -%}
{%- endif -%}
<div class="x-container-b2b-registration-form x-container-b2b-registration-form-{{ section.id }}{% if section.settings.full_width %} contact-full-width md:pl-0 md:pr-0{% else %} x-pgw page-width{% endif %}{% if section.settings.full_width_mobile %} full-width-mobile{% else %} pr-5 pl-5{% endif %} mr-auto ml-auto section-padding-{{ section.id }}">
  <div class="b2b-registration-form b2b-registration-form-{{ section.id }} min-w-4 w-full mr-auto ml-auto md:pl-5 md:pr-5 max-w-[{{ settings.page_width | divided_by: 2 }}px] {{ padding_bg }}{% if is_rtl %} rtl{% endif -%}
    {%- unless section.settings.full_width_mobile %}{% if settings.edges_type == 'rounded_corners' %} rounded-[10px]{% endif %}{% endunless -%}
    {%- if section.settings.full_width %} md:rounded-none{% else %}{% if settings.edges_type == 'rounded_corners' %} md:rounded-[10px]{% endif %}{% endif %}"
  >
    <div class="heading-form empty:hidden text-{{ section.settings.heading_alignment }} rtl:text-{% if section.settings.heading_alignment == 'center' %}center{% elsif section.settings.heading_alignment == 'left' %}right{% else %}left{% endif %}{% if section.settings.heading != blank or section.settings.text != blank %} mb-6 md:mb-8{% endif %}">
      {%- if section.settings.heading != blank -%}
        {% render 'heading-highlight',
          headingId: section.id,
          heading: section.settings.heading,
          highlight_type: section.settings.highlight_type,
          class: 'h2 block leading-tight p-break-words',
          heading_tag: section.settings.heading_tag,
          animation_heading: true
        %}
      {%- endif -%}
      {% if section.settings.text != blank %}
        <div class="rte mt-2 lg:mt-4">
          {{ section.settings.text }}
        </div>
      {% endif %}
    </div>
    {%- form 'contact', id: form_id, class: 'eurus' -%}
      {%- if section.settings.redirect != blank -%}
        <input type="hidden" name="return_to" value="{{ section.settings.redirect }}">
      {%- endif -%}
      {%- if form.posted_successfully? -%}
        <div class="flex items-center pl-4 pr-4 pt-3.5 pb-3.5 mb-3 bg-[rgba(var(--color-success),0.2)] selection:bg-[rgba(var(--color-success),0.4)] focus:outline-none" tabindex="-1" autofocus role="alert" aria-live="polite">
          <span class="text-[rgba(var(--color-success))] w-5 mr-2">
            {%- render 'icon-alls', icon: 'icon-success' %}
          </span>
          {%- if section.settings.success_message != blank -%}
            <div class="rte leading-tight flex-1 p-break-words">{{ section.settings.success_message }}</div>
          {%- else -%}
            {{ 'templates.contact.form.post_success' | t }}
          {%- endif -%}
        </div>
      {%- elsif form.errors -%}
        <div class="flex items-start pl-4 pr-4 pt-3 pb-3 mb-3 bg-[rgba(var(--color-error),0.2)] selection:bg-[rgba(var(--color-error),0.4)]" tabindex="-1" autofocus role="alert" aria-live="polite">
          <span class="text-[rgba(var(--color-error))] inline-block w-5 mr-2 shrink-0">{% render 'icon-alls', icon: 'icon-error' %}</span>
          <span class="flex-1 leading-tight p-break-words">
            {%- for field in form.errors -%}
              {%- if field == 'form' -%}
                {{ form.errors.messages[field] }}
              {%- else -%}
                {{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}
              {%- endif -%}
              {%- unless forloop.last %}<br>{% endunless -%}
            {%- endfor -%}
          </span>
        </div>
      {%- endif -%}
      {%- unless form.posted_successfully? -%}
        <input type="hidden" aria-hidden="true" name="contact[Form type]" value="[B2B Registration]" />
        <div class="b2b-registration-form__fields">
          {%- for block in section.blocks -%}
            {% liquid
              assign field_id = 'B2bRegistrationForm-' | append: section.id | append: '-' | append: block.id
              assign field_label = block.settings.heading
              if field_label == blank
                assign field_label = block.type | replace: '_', ' ' | capitalize
              endif
              assign is_required = false
              if block.type == 'company_name' or block.type == 'contact_person' or block.type == 'email'
                assign is_required = true
              endif
              assign options = null
              if block.type == 'role'
                assign options = block.settings.options | append: '' | split: ';'
              endif
            %}
            {%- case block.type -%}
              {%- when 'company_name', 'branch', 'address', 'tax_number', 'contact_person', 'phone', 'email' -%}
                <div class="mb-3 lg:mb-4 flex-1 relative" {{ block.shopify_attributes }}>
                  <input
                    {% if block.type == 'email' -%}
                      type="email"
                      autocomplete="email"
                      autocapitalize="off"
                      autocorrect="off"
                      value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                      name="contact[email]"
                    {%- elsif block.type == 'phone' -%}
                      type="tel"
                      autocomplete="tel"
                      value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                      name="contact[{{ field_label }}]"
                    {%- else -%}
                      type="text"
                      {% if block.type == 'company_name' %}autocomplete="organization"{% elsif block.type == 'contact_person' %}autocomplete="name"{% elsif block.type == 'address' %}autocomplete="street-address"{% endif %}
                      name="contact[{{ field_label }}]"
                    {%- endif %}
                    id="{{ field_id }}"
                    class="w-full pl-5 pr-5 lg:pl-6 lg:pr-6 pt-5 pb-1 md:pt-5 md:pb-2 border focus:outline-none focus:border-current input bg-transparent placeholder:opacity-0{% if settings.edges_type == 'rounded_corners' %} !rounded-md{% endif %}"
                    placeholder="{{ field_label | escape }}"
                    {% if is_required %}
                      required
                      aria-required="true"
                    {% endif %}
                  >
                  <label
                    class="duration-150 leading-tight absolute top-1/2{% if is_rtl %} right-5 lg:right-6{% else %} left-5 lg:left-6{% endif %} -translate-y-1/2 input_focus:text-xs input_focus:top-3 input_not_empty:top-3 input_not_empty:text-xs"
                    for="{{ field_id }}"
                  >
                    {{- field_label }}
                    {% if is_required %}
                      <span aria-hidden="true">*</span>
                    {%- endif %}
                  </label>
                </div>
              {%- when 'role' -%}
                {%- if options.size > 0 -%}
                  <div class="mb-3 lg:mb-4 relative" {{ block.shopify_attributes }}>
                    <select
                      id="{{ field_id }}"
                      class="w-full pt-3 pb-3 pl-5 md:pt-4 md:pb-3.5 lg:pl-6 pr-8 rtl:pl-8 rtl:lg:pr-6 border focus:outline-none focus:border-current relative cursor-pointer bg-transparent{% if settings.edges_type == 'rounded_corners' %} !rounded-md{% endif %}"
                      name="contact[{{ field_label }}]"
                      aria-label="{{ field_label | escape }}"
                    >
                      <option class="pt-2.5 pb-2.5 pl-2 pr-2 bg-[rgba(var(--background-color))]" value="">
                        {{- field_label -}}
                      </option>
                      {%- for option in options -%}
                        <option class="pt-2.5 pb-2.5 pl-2 pr-10 whitespace-normal cursor-pointer bg-[rgba(var(--background-color))]" value="{{ option }}">
                          {{- option -}}
                        </option>
                      {%- endfor -%}
                    </select>
                    <span class="absolute top-1/2 -translate-y-1/2 w-2.5 right-4 rtl:left-4 rtl:right-auto cursor-pointer pointer-events-none">{% render 'icon-alls', icon: 'icon-caret' %}</span>
                  </div>
                {%- endif -%}
              {%- when 'additional_information' -%}
                <div class="mb-2 md:mb-3 relative" {{ block.shopify_attributes }}>
                  <textarea
                    id="{{ field_id }}"
                    class="w-full pl-5 pr-5 lg:pl-6 lg:pr-6 pt-5 pb-1 md:pt-5 md:pb-2 border focus:outline-none focus:border-current input bg-transparent placeholder:opacity-0{% if settings.edges_type == 'rounded_corners' %} !rounded-md{% endif %}"
                    rows="4"
                    name="contact[{{ field_label }}]"
                    placeholder="{{ field_label | escape }}"
                  ></textarea>
                  <label
                    class="duration-150 absolute top-3 md:top-4{% if is_rtl %} right-5 lg:right-6{% else %} left-5 lg:left-6{% endif %} input_focus:text-xs input_focus:top-1 input_not_empty:top-1 input_not_empty:text-xs"
                    for="{{ field_id }}"
                  >
                    {{- field_label -}}
                  </label>
                </div>
              {%- when 'form_item' -%}
                {% liquid
                  assign item_options = null
                  unless block.settings.type_field == 'text'
                    assign item_options = block.settings.options | append: '' | split: ';'
                  endunless
                %}
                <div class="mb-3 lg:mb-4 relative" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank or block.settings.mark_as_required -%}
                    <label
                      class="pb-2 pt-3 block{% if block.settings.type_field == 'dropdown' or block.settings.type_field == 'text' or block.settings.type_field == 'date' or block.settings.type_field == 'time' %} hidden{% endif %}"
                      for="{{ field_id }}"
                    >
                      {{- block.settings.heading }}
                      {% if block.settings.mark_as_required %}
                        <span aria-hidden="true">*</span>
                      {%- endif %}
                    </label>
                  {%- endif -%}
                  {%- if block.settings.type_field == 'text' -%}
                    <input
                      type="text"
                      id="{{ field_id }}"
                      class="w-full pl-5 pr-5 lg:pl-6 lg:pr-6 pt-5 pb-1 md:pt-5 md:pb-2 border focus:outline-none focus:border-current input bg-transparent placeholder:opacity-0{% if settings.edges_type == 'rounded_corners' %} !rounded-md{% endif %}"
                      name="contact[{{ field_label }}]"
                      value=""
                      placeholder="{{ field_label | escape }}"
                      {% if block.settings.mark_as_required %}
                        required
                      {% endif %}
                    >
                    <label
                      class="duration-150 absolute top-1/2{% if is_rtl %} right-5 lg:right-6{% else %} left-5 lg:left-6{% endif %} -translate-y-1/2 input_focus:text-xs input_focus:top-3 input_not_empty:top-3 input_not_empty:text-xs"
                      for="{{ field_id }}"
                    >
                      {{- block.settings.heading }}
                      {% if block.settings.mark_as_required %}
                        <span aria-hidden="true">*</span>
                      {%- endif %}
                    </label>
                  {%- elsif block.settings.type_field == 'date' -%}
                    <input
                      type="date"
                      id="{{ field_id }}"
                      class="w-full pl-5 pr-5 min-h-[49px] input-date-time cursor-pointer contact-date-time lg:pl-6 lg:pr-6 pb-3.5 pt-3.5 border focus:outline-none focus:border-current input bg-transparent placeholder:opacity-0{% if settings.edges_type == 'rounded_corners' %} !rounded-md{% endif %}"
                      name="contact[{{ field_label }}]"
                      value=""
                      {% if block.settings.mark_as_required %}
                        required
                      {% endif %}
                      @focus="$el.classList.add('focus-input')"
                      {% unless block.settings.heading != blank %}aria-label="{{ field_label | escape }}"{% endunless %}
                    />
                    <label
                      class="label-date duration-150 absolute top-1/2{% if is_rtl %} right-5 lg:right-6{% else %} left-5 lg:left-6{% endif %} -translate-y-1/2"
                      for="{{ field_id }}"
                    >
                      {{- block.settings.heading }}
                      {% if block.settings.mark_as_required %}
                        <span aria-hidden="true">*</span>
                      {%- endif %}
                    </label>
                  {%- elsif block.settings.type_field == 'time' -%}
                    <input
                      type="time"
                      id="{{ field_id }}"
                      class="w-full pl-5 pr-5 min-h-[49px] input-date-time cursor-pointer contact-date-time lg:pl-6 lg:pr-6 pb-3.5 pt-3.5 border focus:outline-none focus:border-current input bg-transparent placeholder:opacity-0{% if settings.edges_type == 'rounded_corners' %} !rounded-md{% endif %}"
                      name="contact[{{ field_label }}]"
                      value=""
                      {% if block.settings.mark_as_required %}
                        required
                      {% endif %}
                      @focus="$el.classList.add('focus-input')"
                      {% unless block.settings.heading != blank %}aria-label="{{ field_label | escape }}"{% endunless %}
                    />
                    <label
                      class="label-date duration-150 absolute top-1/2{% if is_rtl %} right-5 lg:right-6{% else %} left-5 lg:left-6{% endif %} -translate-y-1/2"
                      for="{{ field_id }}"
                    >
                      {{- block.settings.heading }}
                      {% if block.settings.mark_as_required %}
                        <span aria-hidden="true">*</span>
                      {%- endif %}
                    </label>
                  {%- elsif item_options.size > 0 -%}
                    {%- if block.settings.type_field == 'dropdown' -%}
                      <div class="relative">
                        <select
                          id="{{ field_id }}"
                          class="w-full pt-3 pb-3 pl-5 md:pt-4 md:pb-3.5 lg:pl-6 pr-8 rtl:pl-8 rtl:lg:pr-6 border focus:outline-none focus:border-current relative cursor-pointer bg-transparent{% if settings.edges_type == 'rounded_corners' %} !rounded-md{% endif %}"
                          name="contact[{{ field_label }}]"
                          {% if block.settings.mark_as_required %}
                            required
                          {% endif %}
                        >
                          <option class="pt-2.5 pb-2.5 pl-2 pr-2 bg-[rgba(var(--background-color))]" value="">
                            {{- block.settings.heading }}
                            {% if block.settings.mark_as_required %}
                              <span aria-hidden="true">*</span>
                            {%- endif %}
                          </option>
                          {%- for option in item_options -%}
                            <option class="pt-2.5 pb-2.5 pl-2 pr-10 whitespace-normal cursor-pointer bg-[rgba(var(--background-color))]" value="{{ option }}">
                              {{- option -}}
                            </option>
                          {%- endfor -%}
                        </select>
                        <span class="absolute top-1/2 -translate-y-1/2 w-2.5 right-4 rtl:left-4 rtl:right-auto cursor-pointer pointer-events-none">{% render 'icon-alls', icon: 'icon-caret' %}</span>
                      </div>
                    {%- elsif block.settings.type_field == 'radio' -%}
                      <div class="grid md:grid-cols-2 gap-x-7">
                        {%- for option in item_options -%}
                          <div class="flex items-center mt-1.5 mb-1.5 cursor-pointer">
                            <input
                              type="radio"
                              id="{{ field_id }}-{{ forloop.index }}"
                              name="contact[{{ field_label }}]"
                              value="{{ option }}"
                              class="radio-checked relative h-4 w-4 mr-2 rtl:mr-0 rtl:ml-2 border focus:outline-none rounded-full cursor-pointer"
                              {% if block.settings.mark_as_required -%}
                                required
                              {%- endif %}
                              {% if forloop.index == 1 %}
                                checked
                              {% endif -%}
                            >
                            <label for="{{ field_id }}-{{ forloop.index }}" class="flex-1 cursor-pointer bg-transparent">
                              {{ option }}
                            </label>
                            <br>
                          </div>
                        {%- endfor -%}
                      </div>
                    {%- elsif block.settings.type_field == 'checkbox' -%}
                      <div
                        x-data="{
                          data: [],
                          checkEmpty() {
                            const element = this.$el.closest('.multi-select').querySelector('.content').value;
                            const checkboxes = this.$el.closest('.multi-select').getElementsByClassName('checkbox');
                            if (!element) {
                              for (let i = 0; i < checkboxes.length; i++) {
                                checkboxes[i].setAttribute('required', '');
                              }
                            } else {
                              for (let i = 0; i < checkboxes.length; i++) {
                                checkboxes[i].removeAttribute('required');
                              }
                            }
                          }
                        }"
                        class="multi-select grid md:grid-cols-2 gap-x-7"
                      >
                        {%- for option in item_options -%}
                          <div class="flex items-center mt-1.5 mb-1.5">
                            <input
                              type="checkbox"
                              id="{{ field_id }}-{{ forloop.index }}"
                              class="checkbox checkbox-checked mr-2 rtl:mr-0 rtl:ml-2 h-4 w-4 border checked:border-[rgba(var(--colors-text-link))] checked:bg-[rgba(var(--colors-text-link))] relative cursor-pointer{% if settings.edges_type == 'rounded_corners' %} rounded{% else %} rounded-none{% endif %}"
                              value="{{ option }}"
                              x-model="data"
                              {% if block.settings.mark_as_required %}
                                x-on:change="checkEmpty()" required
                              {% endif %}
                            >
                            <label for="{{ field_id }}-{{ forloop.index }}" class="flex-1 cursor-pointer">{{ option }}</label><br>
                          </div>
                        {%- endfor -%}
                        <input
                          type="text"
                          class="content hidden"
                          value=""
                          name="contact[{{ field_label }}]"
                          x-model="data.join('; ')"
                        >
                      </div>
                    {%- endif -%}
                  {%- endif -%}
                </div>
            {%- endcase -%}
          {%- endfor -%}
        </div>
        <div class="mt-3.5 md:mt-5{% if section.settings.button_alignment == 'center' %} text-center{% elsif section.settings.button_alignment == 'left' %} text-left rtl:text-right{% else %} text-right rtl:text-left{% endif %}">
          <button type="submit" class="button button-solid leading-normal pl-8 pr-8 lg:pl-11 lg:pr-11 pt-2.5 pb-2.5 lg:pt-3 lg:pb-3 cursor-pointer empty:hidden pointer-events-auto">
            {%- if section.settings.button_label != blank -%}
              {% assign button_label = section.settings.button_label %}
            {%- else -%}
              {% assign button_label = 'templates.contact.form.send' | t %}
            {%- endif -%}
            {% render 'button-label', button_label: button_label, show_button_style: 'primary' %}
          </button>
        </div>
      {%- endunless -%}
    {%- endform -%}
  </div>
</div>
{% schema %}
{
  "name": "t:sections.b2b-registration-form.name",
  "tag": "section",
  "class": "section section-b2b-registration-form x-section",
  "disabled_on": {
    "groups": [
      "header",
      "footer",
      "aside"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:sections.collection-list.blocks.promotion_block.settings.content.label"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "B2B Registration",
      "label": "t:sections.all.text.heading",
      "info": "t:settings_schema.typography.settings.heading_highlight_type.info"
    },
    {
      "type": "select",
      "id": "highlight_type",
      "default": "underline",
      "label": "t:settings_schema.typography.settings.heading_highlight_type.label",
      "options": [
        {
          "value": "underline",
          "label": "t:settings_schema.typography.settings.heading_highlight_type.option__1.label"
        },
        {
          "value": "font_highlight",
          "label": "t:settings_schema.typography.settings.heading_highlight_type.option__3.label"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 50,
      "max": 200,
      "unit": "%",
      "step": 10,
      "default": 100,
      "label": "t:sections.all.text.heading_size"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "default": "h2",
      "label": "t:sections.all.text.heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "p",
          "label": "p"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "default": "center",
      "label": "t:sections.all.text.heading_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.content_alignment.options__3.label"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.all.text.text"
    },
    {
      "type": "color",
      "id": "background_color_light",
      "default": "rgba(0,0,0,0)",
      "label": "t:sections.all.background.background_color_light"
    },
    {
