{%- liquid
  assign current_level_index = 0
  assign current_level_minimum = -1
  if customer
    for block in section.blocks
      assign minimum_spend = block.settings.minimum_spend | times: 100
      if customer.total_spent >= minimum_spend and minimum_spend > current_level_minimum
        assign current_level_index = forloop.index
        assign current_level_minimum = minimum_spend
        assign current_level_name = block.settings.heading
      endif
    endfor
  endif
-%}

{%- style -%}
  #AtelierMembership-{{ section.id }} {
    --membership-background: {{ section.settings.background_color_light }};
    --membership-text: {{ section.settings.text_color }};
    --membership-soft: {{ section.settings.soft_color }};
    --membership-accent: {{ section.settings.accent_color }};
    --membership-padding-top: {{ section.settings.padding_top }}px;
    --membership-padding-bottom: {{ section.settings.padding_bottom }}px;
    --membership-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --membership-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  }
{%- endstyle -%}

<div id="AtelierMembership-{{ section.id }}" class="atelier-membership">
  <div class="atelier-membership__page">
    <header class="atelier-membership__head">
      {% if section.settings.eyebrow != blank %}
        <span class="atelier-membership__eyebrow">{{ section.settings.eyebrow | escape }}</span>
      {% endif %}
      <h1 class="atelier-membership__title">{{ section.settings.heading | escape }}</h1>
    </header>

    <div class="atelier-membership__card">
      {% if customer %}
        <p class="atelier-membership__guest-title">{{ 'atelier_membership.welcome' | t: name: customer.first_name | escape }}</p>
        <dl class="atelier-membership__facts">
          {% if current_level_index > 0 %}
            <div>
              <dt>{{ 'atelier_membership.your_level' | t }}</dt>
              <dd>{{ current_level_name | escape }}</dd>
            </div>
          {% endif %}
          <div>
            <dt>{{ 'atelier_membership.lifetime_purchases' | t }}</dt>
            <dd>{{ customer.total_spent | money }}</dd>
          </div>
        </dl>
        <a class="atelier-membership__button" href="{{ routes.account_url }}"><span>{{ 'atelier_membership.view_account' | t }}</span></a>
      {% else %}
        {% if section.settings.guest_heading != blank %}
          <p class="atelier-membership__guest-title">{{ section.settings.guest_heading | escape }}</p>
        {% endif %}
        {% if section.settings.text != blank %}
          <p class="atelier-membership__guest-text">{{ section.settings.text | escape }}</p>
        {% endif %}
        <div class="atelier-membership__actions">
          <a class="atelier-membership__button" href="{{ routes.account_login_url }}"><span>{{ 'atelier_membership.sign_in' | t }}</span></a>
          <span class="atelier-membership__new">
            {{ 'atelier_membership.new_here' | t }}
            <a class="atelier-membership__account-link" href="{{ routes.account_register_url }}">{{ 'atelier_membership.create_account' | t }}</a>
          </span>
        </div>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="atelier-membership__levels">
        <h2 class="atelier-membership__subheading">{{ section.settings.levels_heading | escape }}</h2>
        <ol class="atelier-membership__level-list" role="list">
          {% for block in section.blocks %}
            {%- liquid
              assign minimum_amount = block.settings.minimum_spend | times: 100 | money
              assign perks = block.settings.perks | newline_to_br | split: '<br />'
            -%}
            <li class="atelier-membership__level-item{% if forloop.index == current_level_index %} atelier-membership__level-item--current{% endif %}" {{ block.shopify_attributes }}>
              <div class="atelier-membership__level-head">
                <h3 class="atelier-membership__level-title">{{ block.settings.heading | escape }}</h3>
                {% if forloop.index == current_level_index %}
                  <span class="atelier-membership__you">{{ 'atelier_membership.your_level' | t }}</span>
                {% endif %}
              </div>
              <span class="atelier-membership__level-from">{{ 'atelier_membership.from_amount' | t: amount: minimum_amount }}</span>
              {% if block.settings.perks != blank %}
                <ul class="atelier-membership__perks" role="list">
                  {% for perk in perks %}
                    {% assign perk_text = perk | strip %}
                    {% if perk_text != blank %}<li>{{ perk_text | escape }}</li>{% endif %}
                  {% endfor %}
                </ul>
              {% endif %}
            </li>
          {% endfor %}
        </ol>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:atelier_membership.name",
  "tag": "section",
  "class": "section-atelier-membership",
  "disabled_on": { "groups": ["header", "footer", "aside"] },
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "t:sections.atelier_story_index.eyebrow", "default": "t:atelier_membership.eyebrow_default" },
    { "type": "text", "id": "heading", "label": "t:sections.all.text.heading", "default": "t:atelier_membership.heading_default" },
    { "type": "text", "id": "guest_heading", "label": "t:atelier_membership.guest_heading", "default": "t:atelier_membership.guest_heading_default" },
    { "type": "textarea", "id": "text", "label": "t:sections.atelier_story_index.text", "default": "t:atelier_membership.text_default" },
    { "type": "text", "id": "levels_heading", "label": "t:atelier_membership.levels_heading", "default": "t:atelier_membership.levels_heading_default" },
    { "type": "color", "id": "background_color_light", "label": "t:sections.atelier_story_index.background_color", "default": "#0B0E28" },
    { "type": "color", "id": "text_color", "label": "t:sections.atelier_story_index.text_color", "default": "#F2F6FB" },
    { "type": "color", "id": "soft_color", "label": "t:sections.atelier_story_index.soft_color", "default": "#A9C3E2" },
    { "type": "color", "id": "accent_color", "label": "t:atelier_footer.accent_color", "default": "#6E9BFF" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 2, "unit": "px", "label": "t:sections.all.padding.padding_top", "default": 92 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 2, "unit": "px", "label": "t:sections.all.padding.padding_bottom", "default": 92 },
    { "type": "range", "id": "padding_top_mobile", "min": 0, "max": 100, "step": 1, "unit": "px", "label": "t:atelier_membership.padding_top_mobile", "default": 55 },
    { "type": "range", "id": "padding_bottom_mobile", "min": 0, "max": 100, "step": 1, "unit": "px", "label": "t:atelier_membership.padding_bottom_mobile", "default": 55 }
  ],
  "blocks": [
    {
      "type": "level", "name": "t:atelier_membership.level", "limit": 4,
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.all.text.heading", "default": "t:atelier_membership.member_default" },
        { "type": "number", "id": "minimum_spend", "label": "t:atelier_membership.minimum_spend", "info": "t:atelier_membership.minimum_spend_info", "default": 0 },
        { "type": "textarea", "id": "perks", "label": "t:atelier_membership.perks", "info": "t:atelier_membership.perks_info", "default": "t:atelier_membership.perks_default" }
      ]
    }
  ],
  "presets": [{ "name": "t:atelier_membership.name", "blocks": [{ "type": "level" }] }]
}
{% endschema %}
