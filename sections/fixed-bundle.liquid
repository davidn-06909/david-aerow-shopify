            if section.settings.apply_discount_once_per_order
              assign saving = discount_value | times: 100
              if saving > selling_subtotal
                assign saving = selling_subtotal
              endif
            else
              assign saving = fixed_item_saving
            endif
          endif
          assign saving = saving | plus: subtotal_discount
          assign total = subtotal | minus: saving
          if total < 0
            assign total = 0
          endif

          assign can_add_bundle = can_add_all
          if section.settings.oos_behavior == 'partial'
            assign can_add_bundle = has_available
          endif

          unless has_product and can_add_bundle
            assign atc_label = sold_out_label
          endunless
        -%}
        <div 
          x-data="xFixedBundle('{{ section.id }}', {% if settings.currency_code_enable %}'{{ shop.money_with_currency_format | escape }}'{% else %}'{{ shop.money_format | escape }}'{% endif %}, {{ discount_value }}, '{{ section.settings.unit }}', {{ section.settings.apply_discount_once_per_order }}, '{{ section.settings.oos_behavior }}', '{{ section.settings.atc_label | replace: "'", "\'" }}', {{ bundle_qty }}, '{{ sold_out_label_js }}')" 
          class="fb-summary flex flex-col mt-auto border-t border-solid sticky bottom-0 md:relative pt-4 pb-4 pl-4 pr-4 md:pt-5 md:pb-0 md:pl-0 md:pr-0 gap-4"
        >
          {%- unless b2b_bundle_blocked -%}
          <div class="flex flex-wrap items-center md:justify-between gap-3 justify-{{ heading_alignment }}">
            <div class="hidden md:flex flex-wrap items-center gap-3">
              <span class="fb-total-label text-[120%] font-semibold">{{ 'sections.cart.total' | t }}</span>
            </div>
            <div class="fb-prices flex flex-wrap items-center gap-2.5">
              <div class="flex flex-wrap items-baseline gap-2">
                <span class="fb-total-label md:hidden text-[120%] font-semibold">{{ 'sections.cart.total' | t }}:</span>
                <span class="fb-total font-semibold">{{ total | money }}</span>
                {%- if saving > 0 -%}
                  <span class="fb-was">{{ subtotal | money }}</span>
                {%- endif -%}
              </div>
              {%- if saving > 0 -%}
                <span class="fb-save bg-[rgba(var(--colors-button))] text-[rgba(var(--colors-button-text))] rounded-full font-bold pt-1 pb-1 pl-3 pr-3">
                  {%- if section.settings.unit == 'percentage' -%}
                    {{ 'sections.product-bundle.save' | t }} {{ pct }}%
                  {%- else -%}
                    {{ 'sections.product-bundle.save' | t }} <span class="saved-amount">{{ saving | money }}</span>
                  {%- endif -%}
                </span>
              {%- endif -%}
            </div>
          </div>
          {%- endunless -%}
          <button
            id="add-all-button-{{ section.id }}"
            {% if has_product and can_add_bundle %}
              {%- if b2b_bundle_blocked -%}
                disabled data-b2b-blocked="true"
              {%- else -%}
                {{ fb_atc_ended_attrs }}
                @click.prevent="handleAddToCart($el, '.x-products-list-container-{{ section.id }}', '.product-form:not(.oos)', '{{ settings.name_edt | default: "Note" }}')"
              {%- endif -%}
            {% else %}
              disabled
            {% endif %}
            class="button button-solid w-full relative disabled:cursor-not-allowed disabled:opacity-30 cursor-pointer flex gap-1 justify-center pt-3 pb-3 pl-6 pr-6 leading-normal text-center"
          >
            <div>
              <span :class="loading && 'invisible'">
                {% render 'button-label', button_label: atc_label, button_label_x_text: 'atcButtonLabel', button_text_class: 'is-focus-button:opacity-0', show_button_style: 'primary' %}
              </span>
              <div x-cloak x-show="loading" class="w-4 h-4 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
                {% render 'icon-alls', icon: 'icon-loading' %}
              </div>
            </div>
          </button>
          {%- if fb_summary_countdown != blank -%}
            <div class="flex justify-center md:pb-5">{{ fb_summary_countdown }}</div>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- elsif layout == 'storytelling' -%}
    {%- style -%}
      {%- if section.settings.background_color_light.alpha != 0.0 -%}
        .fixed-bundle-{{ section.id }} .fb-content,
        .fixed-bundle-{{ section.id }} .fb-list {
          background: rgb({{ section.settings.background_color_light.red }}, {{ section.settings.background_color_light.green }}, {{ section.settings.background_color_light.blue }});
        }
        .fixed-bundle-{{ section.id }} .fb-list {
          padding-top: 16px;
        }
        .fixed-bundle-{{ section.id }} .fb-product-list,
        .fixed-bundle-{{ section.id }} .fb-summary {
          padding-left: 24px;
          padding-right: 24px;
        }
      {%- endif -%}
      .dark .fixed-bundle-{{ section.id }} .fb-content,
      .dark .fixed-bundle-{{ section.id }} .fb-list {
        {%- if section.settings.background_color_dark.alpha != 0.0 -%}
          background: rgb({{ section.settings.background_color_dark.red }}, {{ section.settings.background_color_dark.green }}, {{ section.settings.background_color_dark.blue }});
        {%- else -%}
          background: transparent;
        {%- endif -%}
      }
      .dark .fixed-bundle-{{ section.id }} .fb-list {
        {%- if section.settings.background_color_dark.alpha != 0.0 -%}
          padding-top: 16px;
        {%- else -%}
          padding-top: 0;
        {%- endif -%}
      }
      .dark .fixed-bundle-{{ section.id }} .fb-product-list,
      .dark .fixed-bundle-{{ section.id }} .fb-summary {
        {%- if section.settings.background_color_dark.alpha != 0.0 -%}
          padding-left: 24px;
          padding-right: 24px;
        {%- else -%}
          padding-left: 0;
          padding-right: 0;
        {%- endif -%}
      }

      {%- if settings.edges_type == 'rounded_corners' -%}
        .fixed-bundle-{{ section.id }} .fb-hero-visual {
          overflow: hidden;
          {%- unless section.settings.background_color_light.alpha != 0.0 -%}
            border-radius: 0.375rem;
          {%- endunless -%}
        }
        .dark .fixed-bundle-{{ section.id }} .fb-hero-visual {
          {%- if section.settings.background_color_dark.alpha != 0.0 -%}
            border-radius: 0;
          {%- else -%}
            border-radius: 0.375rem;
          {%- endif -%}
        }
      {%- endif -%}

      @media (max-width: 767px) {
        .fixed-bundle-{{ section.id }} .fb-hero-visual,
        .fixed-bundle-{{ section.id }} .fb-product-list,
        .dark .fixed-bundle-{{ section.id }} .fb-product-list,
        .fixed-bundle-{{ section.id }} .fb-summary,
        .dark .fixed-bundle-{{ section.id }} .fb-summary {
          padding-left: 1.25rem;
          padding-right: 1.25rem;
        }
        .fixed-bundle-{{ section.id }} .fb-hero,
        .dark .fixed-bundle-{{ section.id }} .fb-hero,
        .fixed-bundle-{{ section.id }} .fb-content,
        .dark .fixed-bundle-{{ section.id }} .fb-content,
        .fixed-bundle-{{ section.id }} .fb-list,
        .dark .fixed-bundle-{{ section.id }} .fb-list,
        .fixed-bundle-{{ section.id }} .fb-summary,
        .dark .fixed-bundle-{{ section.id }} .fb-summary {
          background: transparent;
        }
        .fixed-bundle-{{ section.id }} .fb-content,
        .dark .fixed-bundle-{{ section.id }} .fb-content {
          padding-top: 0;
          padding-bottom: 1rem;
        }
        .fixed-bundle-{{ section.id }} .fb-list,
        .dark .fixed-bundle-{{ section.id }} .fb-list {
          padding-top: 0;
          padding-bottom: 0;
        }
        .x-products-list-container-{{ section.id }} {
          background: rgba(var(--colors-background));
          padding-top: 1.5rem;
        }
        {%- if section.settings.background_color_light.alpha != 0.0 -%}
          .x-products-list-container-{{ section.id }} {
            background: rgb({{ section.settings.background_color_light.red }}, {{ section.settings.background_color_light.green }}, {{ section.settings.background_color_light.blue }});
          }
        {%- endif -%}
        .dark .x-products-list-container-{{ section.id }} {
          {%- if section.settings.background_color_dark.alpha != 0.0 -%}
            background: rgb({{ section.settings.background_color_dark.red }}, {{ section.settings.background_color_dark.green }}, {{ section.settings.background_color_dark.blue }});
          {%- else -%}
            background: transparent;
          {%- endif -%}
        }
        .fixed-bundle-{{ section.id }} .fb-hero-visual {
          min-height: 0;
        }
        .fixed-bundle-{{ section.id }} .card-product > .fb-card-media {
          width: 50px;
          flex: none;
        }
        {%- if settings.edges_type == 'rounded_corners' -%}
          {%- if section.settings.background_color_light.alpha != 0.0 -%}
            .x-products-list-container-{{ section.id }} {
              overflow: hidden;
              border-radius: 10px;
            }
          {%- endif -%}
          {%- if section.settings.background_color_dark.alpha != 0.0 -%}
            .dark .x-products-list-container-{{ section.id }} {
              overflow: hidden;
              border-radius: 10px;
            }
          {%- endif -%}
        {%- endif -%}
      }

      @media (min-width: 768px) {
        .fixed-bundle-{{ section.id }} .card-product > .fb-card-media {
          width: 150px;
          flex: none;
        }
      }
    {%- endstyle -%}
    <div
      class="x-products-list-container-{{ section.id }}"
      {{ fb_countdown_attrs }}
    >
      <div class="fb-hero grid md:grid-cols-2 overflow-hidden pb-4 md:pb-0 mb-0 md:mb-6{% if settings.edges_type == 'rounded_corners' %} md:rounded-md{% endif %}">
        <div class="fb-hero-visual order-2 md:order-1 relative min-h-[200px] md:min-h-[350px]">
          {%- if section.settings.background_img != blank -%}
            {% # theme-check-disable ImgLazyLoading %}
            <img
              src="{{ section.settings.background_img | image_url: width: 1200 }}"
              alt="{{ section.settings.background_img.alt | escape }}"
              class="hidden md:block absolute inset-0 w-full h-full object-cover"
              loading="lazy"
              width="{{ section.settings.background_img.width }}"
              height="{{ section.settings.background_img.height }}"
            >
            {% # theme-check-enable ImgLazyLoading %}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'bg-[#c9c9c9] text-[#acacac] hidden md:block absolute inset-0 w-full h-full object-cover' }}
          {%- endif -%}
          <div class="hidden md:block">{{ fb_bundle_countdown }}</div>
          <div class="md:hidden relative">
            {%- if section.settings.background_img != blank -%}
              {% # theme-check-disable ImgLazyLoading %}
              <img
                src="{{ section.settings.background_img | image_url: width: 900 }}"
                alt="{{ section.settings.background_img.alt | escape }}"
                class="w-full h-auto{% if settings.edges_type == 'rounded_corners' %} rounded-md{% endif %}"
                loading="lazy"
                width="{{ section.settings.background_img.width }}"
                height="{{ section.settings.background_img.height }}"
              >
              {% # theme-check-enable ImgLazyLoading %}
            {%- else -%}
              {%- capture story_hero_placeholder_class -%}
                bg-[#c9c9c9] text-[#acacac] w-full h-auto{% if settings.edges_type == 'rounded_corners' %} rounded-md{% endif %}
              {%- endcapture -%}
              {{ 'image' | placeholder_svg_tag: story_hero_placeholder_class }}
            {%- endif -%}
            {{ fb_bundle_countdown }}
          </div>
        </div>
        <div class="fb-content order-1 md:order-2 bg-[rgba(var(--colors-background))] flex flex-col justify-center pt-6 pb-6 pl-5 pr-5 md:pt-10 md:pb-10 md:pl-10 md:pr-10">
          <div class="text-{{ heading_alignment }} rtl:text-{{ rtl_alignment }}">
            {%- if section.settings.subheading != blank -%}
              <div class="{% unless settings.disable_heading_animation %}overflow-hidden{% endunless %}"{% unless settings.disable_heading_animation %} x-intersect.once="$el.querySelector('.anm-move-up')?.classList.add('active-anm-heading')"{% endunless %}>
                <p class="text-[rgba(var(--colors-text))]{% unless settings.disable_heading_animation %} anm-move-up{% endunless %}">{{ section.settings.subheading }}</p>
              </div>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              {%- liquid
                assign heading_size = settings.heading_base_size | times: section.settings.heading_size | times: 0.000225
              -%}
              {% style %}
                .heading-{{ section.id }} {
                  font-size: {{ heading_size | times: 0.6 }}rem;
                }
                @media (min-width: 767px){
                  .heading-{{ section.id }} {
                    font-size: {{ heading_size }}rem;
                  }
                }
              {% endstyle %}
              <div class="heading-{{ section.id }} x-fixed-bundle-heading mt-5">
                {% render 'heading-highlight',
                  headingId: section.id,
                  heading: section.settings.heading,
                  highlight_type: section.settings.highlight_type,
                  color_heading_highlight_dark: section.settings.heading_highlight_color_dark,
                  color_heading_highlight_light: section.settings.heading_highlight_color_light,
                  is_intersect: true,
                  animation_heading: false,
                  class: 'h2 block leading-tight',
                  heading_tag: section.settings.heading_tag
                %}
              </div>
            {%- endif -%}
            {%- if section.settings.text != blank -%}
              <div class="text-[rgba(var(--colors-text))] mt-5 rte">{{ section.settings.text }}</div>
            {%- endif -%}
          </div>
        </div>
      </div>
      {% assign can_add_all = true %}
      {% assign b2b_bundle_blocked = false %}
      {% assign has_available = false %}
      <div class="fb-list bg-[rgba(var(--colors-background))]{% if settings.edges_type == 'rounded_corners' %} md:rounded-md{% endif %}">
      <div class="fb-product-list flex flex-col gap-3 md:gap-6 mb-4 md:mb-0">
        {%- for block in product_blocks -%}
          {% assign product = block.settings.product %}
          {%- if settings.b2b_enable_price_visibility -%}
            {%- capture b2b_price_hidden -%}
              {%- render 'b2b-price-hidden', product: product -%}
            {%- endcapture -%}
            {%- if b2b_price_hidden contains 'true' -%}
              {%- assign b2b_bundle_blocked = true -%}
            {%- endif -%}
          {%- else -%}
            {%- assign b2b_price_hidden = '' -%}
          {%- endif -%}
          {%- liquid
            assign qty = block.settings.quantity | default: 1 | at_least: 1

            assign unit_price = 0
            assign unit_discount = 0

            assign variant = null
            assign variant_selected = false
            if block.settings.variant_id != blank
              assign wanted_id = block.settings.variant_id | plus: 0
              assign variant = product.variants | where: 'id', wanted_id | first
              if variant != null
                assign variant_selected = true
              endif
            endif
            if variant == null
              assign variant = product.selected_or_first_available_variant
            endif

            if product != blank
              if variant.available
                assign has_available = true
              else
                assign can_add_all = false
              endif
            endif
            if variant.compare_at_price > variant.price
              assign unit_price = variant.compare_at_price
              assign unit_discount = variant.compare_at_price | minus: variant.price
            else
              assign unit_price = variant.price
            endif

            assign line_price = unit_price | times: qty
            assign line_discount = unit_discount | times: qty
            assign subtotal = subtotal | plus: line_price
            assign subtotal_discount = subtotal_discount | plus: line_discount

            assign line_selling = variant.price | times: qty
            assign selling_subtotal = selling_subtotal | plus: line_selling
            assign line_fixed_saving = discount_value | times: 100 | times: qty
            if line_fixed_saving > line_selling
              assign line_fixed_saving = line_selling
            endif
            assign fixed_item_saving = fixed_item_saving | plus: line_fixed_saving

            assign image = variant.featured_media | default: product.featured_media
          -%}
          {% if section.settings.oos_behavior == 'hide' and can_add_all == false %}
            {% style %}
              .fixed-bundle-{{ section.id }} {
                display: none !important;
              }
            {% endstyle %}
            {% break %}
          {% endif %}
          {% if product != blank %}
            {% assign has_product = true %}
          {% endif %}
          <div class="flex items-start gap-4 md:gap-6">
            {%- if section.settings.show_step_number == 'show' -%}
              <div class="hidden md:flex self-center flex-none w-11 h-11 min-w-11 rounded-full border border-solid items-center justify-center font-serif text-[rgba(var(--colors-heading))]">
                <span class="leading-none">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              </div>
            {%- endif -%}
            {% render 'card-product-fixed-bundle',
              card_product: product,
              variant: variant,
              variant_selected: variant_selected,
              block: block,
              section_id: section.id,
              block_id: block.id,
              qty: qty,
              image: image,
              ratio: ratio,
              oos_behavior: section.settings.oos_behavior,
              description: block.settings.description,
              category_label: block.settings.category_label,
              badge: block.settings.badge,
              layout: layout
            %}
          </div>
        {%- endfor -%}
      </div>
      {%- liquid
        if section.settings.unit == 'percentage'
          assign saving = selling_subtotal | times: pct | divided_by: 100 | floor
        else
          if section.settings.apply_discount_once_per_order
            assign saving = discount_value | times: 100
            if saving > selling_subtotal
              assign saving = selling_subtotal
            endif
          else
            assign saving = fixed_item_saving
          endif
        endif
        assign saving = saving | plus: subtotal_discount
        assign total = subtotal | minus: saving
        if total < 0
          assign total = 0
        endif

        assign can_add_bundle = can_add_all
        if section.settings.oos_behavior == 'partial'
          assign can_add_bundle = has_available
        endif

        unless has_product and can_add_bundle
          assign atc_label = sold_out_label
        endunless
      -%}
      <div
        x-data="xFixedBundle('{{ section.id }}', {% if settings.currency_code_enable %}'{{ shop.money_with_currency_format | escape }}'{% else %}'{{ shop.money_format | escape }}'{% endif %}, {{ discount_value }}, '{{ section.settings.unit }}', {{ section.settings.apply_discount_once_per_order }}, '{{ section.settings.oos_behavior }}', '{{ section.settings.atc_label | replace: "'", "\'" }}', {{ bundle_qty }}, '{{ sold_out_label_js }}')"
        class="fb-summary flex flex-col md:flex-row md:flex-wrap items-center justify-between relative border-t border-solid pt-4 pb-4 pl-4 pr-4 md:pt-5 md:pb-5 md:pl-0 md:pr-0 md:mt-4 gap-4 md:gap-5"
      >
        {%- unless b2b_bundle_blocked -%}
        <div class="fb-prices flex items-center w-full md:w-auto justify-{{ heading_alignment }}">
          <span class="fb-total-label hidden md:block md:mr-10 rtl:md:mr-0 rtl:md:ml-10 text-[120%] font-semibold">{{ 'sections.cart.total' | t }}</span>
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="fb-total-label md:hidden text-[120%] font-semibold">{{ 'sections.cart.total' | t }}:</span>
            <span class="fb-total font-semibold">{{ total | money }}</span>
            {%- if saving > 0 -%}
              <span class="fb-was">{{ subtotal | money }}</span>
              <span class="fb-save bg-[rgba(var(--colors-button))] text-[rgba(var(--colors-button-text))] rounded-full font-bold pt-1 pb-1 pl-3 pr-3">
                {%- if section.settings.unit == 'percentage' -%}
                  {{ 'sections.product-bundle.save' | t }} {{ pct }}%
                {%- else -%}
                  {{ 'sections.product-bundle.save' | t }} <span class="saved-amount">{{ saving | money }}</span>
                {%- endif -%}
              </span>
            {%- endif -%}
          </div>
        </div>
        {%- endunless -%}
        <div class="flex flex-col md:flex-row gap-2 items-center w-full md:w-auto">
          <button
            id="add-all-button-{{ section.id }}"
            {% if has_product and can_add_bundle %}
              {%- if b2b_bundle_blocked -%}
                disabled data-b2b-blocked="true"
              {%- else -%}
                {{ fb_atc_ended_attrs }}
                @click.prevent="handleAddToCart($el, '.x-products-list-container-{{ section.id }}', '.product-form:not(.oos)', '{{ settings.name_edt | default: "Note" }}')"
              {%- endif -%}
            {% else %}
              disabled
            {% endif %}
            class="button button-solid md:order-last relative disabled:cursor-not-allowed disabled:opacity-30 cursor-pointer w-full md:w-fit flex justify-center gap-1 pt-3 pb-3 pl-6 pr-6 leading-normal text-center"
          >
            <div>
              <span :class="loading && 'invisible'">
                {% render 'button-label', button_label: atc_label, button_label_x_text: 'atcButtonLabel', button_text_class: 'is-focus-button:opacity-0', show_button_style: 'primary' %}
              </span>
              <div x-cloak x-show="loading" class="w-4 h-4 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
                {% render 'icon-alls', icon: 'icon-loading' %}
              </div>
            </div>
          </button>
          {{ fb_summary_countdown }}
        </div>
      </div>
      </div>
    </div>
    {%- endif -%}
  </div>
</div>
<script src="{{ 'product-list.js' | asset_url }}" defer></script>
<script src="{{ 'fixed-bundle.js' | asset_url }}" defer></script>
{% schema %}
{
  "name": "t:sections.fixed-bundle.name",
  "tag": "section",
  "class": "section section-fixed-bundle",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.promotion-grid.blocks.promotion.settings.header.content",
      "options": [
        {
          "value": "conversion",
          "label": "t:sections.fixed-bundle.settings.layout.options__1.label"
        },
        {
          "value": "mixed",
          "label": "t:settings_schema.buttons.mixed"
        },
        {
          "value": "storytelling",
          "label": "t:categories.storytelling"
        }
      ],
      "default": "mixed"
    },
    {
      "type": "header",
      "content": "t:sections.collection-list.blocks.promotion_block.settings.content.label"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.all.text.subheading",
      "default": "Curated set"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.text.heading",
      "default": "The Hydration Ritual",
      "info": "t:settings_schema.typography.settings.heading_highlight_type.info"
    },
    {
      "type": "select",
      "id": "highlight_type",
      "default": "underline",
      "label": "t:settings_schema.typography.settings.heading_highlight_type.label",
      "options": [
        {
          "value": "underline",
          "label": "t:settings_schema.typography.settings.heading_highlight_type.option__1.label"
        },
        {
          "value": "font_highlight",
          "label": "t:settings_schema.typography.settings.heading_highlight_type.option__3.label"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 50,
      "max": 200,
      "unit": "%",
      "step": 10,
      "default": 100,
      "label": "t:sections.all.text.heading_size"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "default": "h2",
      "label": "t:sections.all.text.heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
