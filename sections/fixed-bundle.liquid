{%- liquid
  assign layout = section.settings.layout

  assign discount_value = section.settings.discount_amount | default: 0 | plus: 0 | at_least: 0
  assign pct = discount_value | at_most: 100

  assign subtotal = 0
  assign subtotal_discount = 0

  assign selling_subtotal = 0
  assign fixed_item_saving = 0

  assign text_size = settings.text_base_size | times: 0.00875

  case settings.product_image_ratio
    when 'square'
      assign ratio = '1/1'
    when 'portrait'
      assign ratio = '2/3'
    when 'landscape'
      assign ratio = '4/3'
    when 'wide'
      assign ratio = '16/9'
    when '3/4'
      assign ratio = '[3/4]'
  endcase

  assign product_blocks = section.blocks | where: 'type', 'product'
  assign countdown_block = section.blocks | where: 'type', 'countdown' | first

  assign bundle_qty = 0
  for product_block in product_blocks
    if product_block.settings.product == blank
      continue
    endif

    if section.settings.oos_behavior == 'partial'
      assign block_variant = null
      if product_block.settings.variant_id != blank
        assign wanted_block_variant = product_block.settings.variant_id | plus: 0
        assign block_variant = product_block.settings.product.variants | where: 'id', wanted_block_variant | first
      endif
      if block_variant == null
        assign block_variant = product_block.settings.product.selected_or_first_available_variant
      endif

      if block_variant.available == false
        continue
      endif
    endif

    assign block_qty = product_block.settings.quantity | default: 1 | at_least: 1
    assign bundle_qty = bundle_qty | plus: block_qty
  endfor

  assign atc_label = section.settings.atc_label
  if bundle_qty > 0
    assign atc_label = atc_label | append: ' (' | append: bundle_qty | append: ')'
  endif

  assign sold_out_label = 'products.product.sold_out' | t
  assign sold_out_label_js = sold_out_label | replace: "'", "\'"

  if settings.lang_direction contains request.locale.iso_code
    assign is_rtl = true
  else
    assign is_rtl = false
  endif

  assign heading_alignment = section.settings.heading_alignment
  if heading_alignment == 'left'
    assign rtl_alignment = 'right'
  elsif heading_alignment == 'right'
    assign rtl_alignment = 'left'
  else
    assign rtl_alignment = 'center'
  endif
-%}

{%- style -%}
  .fixed-bundle-{{ section.id }} {
    {% if section.settings.heading_color_light.alpha != 0.0 %}
      --colors-heading: {{ section.settings.heading_color_light.red }},{{ section.settings.heading_color_light.green }},{{ section.settings.heading_color_light.blue }};
    {% endif %}
    {% if section.settings.text_color_light.alpha != 0.0 %}
      --colors-text: {{ section.settings.text_color_light.red }},{{ section.settings.text_color_light.green }},{{ section.settings.text_color_light.blue }};
    {% endif %}
    {% if section.settings.button_light.alpha != 0.0 %}
      --colors-button: {{ section.settings.button_light.red }}, {{ section.settings.button_light.green }}, {{ section.settings.button_light.blue }};
    {% endif %}
    {% if section.settings.button_text_light.alpha != 0.0 %}
      --colors-button-text: {{ section.settings.button_text_light.red }}, {{ section.settings.button_text_light.green }}, {{ section.settings.button_text_light.blue }};
    {% endif %}
  }
  .dark .fixed-bundle-{{ section.id }} {
    {% if section.settings.heading_color_dark.alpha != 0.0 %}
      --colors-heading: {{ section.settings.heading_color_dark.red }},{{ section.settings.heading_color_dark.green }},{{ section.settings.heading_color_dark.blue }};
    {% else %}
      --colors-heading: {{ settings.colors_dark_heading.red }}, {{ settings.colors_dark_heading.green }}, {{ settings.colors_dark_heading.blue }};
    {% endif %}
    {% if section.settings.text_color_dark.alpha != 0.0 %}
      --colors-text: {{ section.settings.text_color_dark.red }},{{ section.settings.text_color_dark.green }},{{ section.settings.text_color_dark.blue }};
    {% else %}
      --colors-text: {{ settings.colors_dark_text.red }}, {{ settings.colors_dark_text.green }}, {{ settings.colors_dark_text.blue }};
    {% endif %}
    {% if section.settings.button_dark.alpha != 0.0 %}
      --colors-button: {{ section.settings.button_dark.red }}, {{ section.settings.button_dark.green }}, {{ section.settings.button_dark.blue }};
    {% else %}
      --colors-button: {{ settings.colors_dark_button.red }}, {{ settings.colors_dark_button.green }}, {{ settings.colors_dark_button.blue }};
    {% endif %}
    {% if section.settings.button_text_dark.alpha != 0.0 %}
      --colors-button-text: {{ section.settings.button_text_dark.red }}, {{ section.settings.button_text_dark.green }}, {{ section.settings.button_text_dark.blue }};
    {% else %}
      --colors-button-text: {{ settings.colors_dark_button_text.red }}, {{ settings.colors_dark_button_text.green }}, {{ settings.colors_dark_button_text.blue }};
    {% endif %}
  }

  #add-all-button-{{ section.id }}, #add-all-button-{{ section.id }}:before {
    {% if section.settings.button_light.alpha != 0.0 %}
      --colors-button: {{ section.settings.button_light.red }}, {{ section.settings.button_light.green }}, {{ section.settings.button_light.blue }};
    {% endif %}
    {% if section.settings.button_text_light.alpha != 0.0 %}
      --colors-button-text: {{ section.settings.button_text_light.red }}, {{ section.settings.button_text_light.green }}, {{ section.settings.button_text_light.blue }};
    {% endif %}
    {% if section.settings.button_hover_light.alpha != 0.0 %}
      --colors-button-hover: rgb({{ section.settings.button_hover_light.red }}, {{ section.settings.button_hover_light.green }}, {{ section.settings.button_hover_light.blue }});
    {% endif %}
    {% if section.settings.button_text_hover_light.alpha != 0.0 %}
      --colors-button-text-hover: {{ section.settings.button_text_hover_light.red }}, {{ section.settings.button_text_hover_light.green }}, {{ section.settings.button_text_hover_light.blue }};
    {% endif %}
  }

  .dark #add-all-button-{{ section.id }}, .dark #add-all-button-{{ section.id }}:before {
    {% if section.settings.button_dark.alpha != 0.0 %}
      --colors-button: {{ section.settings.button_dark.red }}, {{ section.settings.button_dark.green }}, {{ section.settings.button_dark.blue }};
    {% else %}
      --colors-button: {{ settings.colors_dark_button.red }}, {{ settings.colors_dark_button.green }}, {{ settings.colors_dark_button.blue }};
    {% endif %}
    {% if section.settings.button_text_dark.alpha != 0.0 %}
      --colors-button-text: {{ section.settings.button_text_dark.red }}, {{ section.settings.button_text_dark.green }}, {{ section.settings.button_text_dark.blue }};
    {% else %}
      --colors-button-text: {{ settings.colors_dark_button_text.red }}, {{ settings.colors_dark_button_text.green }}, {{ settings.colors_dark_button_text.blue }};
    {% endif %}
    {% if section.settings.button_hover_dark.alpha != 0.0 %}
      --colors-button-hover: rgb({{ section.settings.button_hover_dark.red }}, {{ section.settings.button_hover_dark.green }}, {{ section.settings.button_hover_dark.blue }});
    {% else %}
      --colors-button-hover: rgb({{ settings.colors_dark_button_hover.red }}, {{ settings.colors_dark_button_hover.green }}, {{ settings.colors_dark_button_hover.blue }});
    {% endif %}
    {% if section.settings.button_text_hover_dark.alpha != 0.0 %}
      --colors-button-text-hover: {{ section.settings.button_text_hover_dark.red }}, {{ section.settings.button_text_hover_dark.green }}, {{ section.settings.button_text_hover_dark.blue }};
    {% else %}
      --colors-button-text-hover: {{ settings.colors_dark_button_text_hover.red }}, {{ settings.colors_dark_button_text_hover.green }}, {{ settings.colors_dark_button_text_hover.blue }};
    {% endif %}
  }

  .section-padding-{{ section.id }} {
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }
  @media (min-width: 768px) {
    .section-padding-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  {%- unless settings.card_product_background_color_light.alpha != 0.0 -%}
    .fixed-bundle-{{ section.id }} .card-product.mini-card {
      padding: 0;
    }
  {%- endunless -%}
  .dark .fixed-bundle-{{ section.id }} .card-product.mini-card {
    {%- if settings.card_product_background_color_dark.alpha != 0.0 -%}
      padding: 1rem;
    {%- else -%}
      padding: 0;
    {%- endif -%}
  }

  .fixed-bundle-{{ section.id }} .card-product .x-variants-data {
    padding-left: 0;
    padding-right: 0;
  }

  .fixed-bundle-{{ section.id }} .fb-qty-badge {
    font-size: {{ text_size | times: 0.75 }}rem;
    bottom: -6px;
    {% if is_rtl %}
      left: -6px;
    {% else %}
      right: -6px;
    {% endif %}
  }

  .fixed-bundle-{{ section.id }} .fb-card-badge {
    max-width: calc(100% - 12px);
    background: rgb(var(--colors-heading));
    color: rgb(var(--colors-background));
    {%- if settings.edges_type == 'rounded_corners' -%}
      border-radius: 0.25rem;
    {%- endif -%}
  }

  @media (min-width: 768px) {
    .fixed-bundle-{{ section.id }} .fb-card-badge {
      top: 6px;
      {% if is_rtl %}
        right: 6px;
      {% else %}
        left: 6px;
      {% endif %}
    }
  }

  .fixed-bundle-{{ section.id }} .fb-variant,
  .fixed-bundle-{{ section.id }} .fb-line-price .fb-line-multiplier,
  .fixed-bundle-{{ section.id }} .fb-oos-label,
  .fixed-bundle-{{ section.id }} .fb-total {
    font-size: {{ text_size }}rem;
  }
  .fixed-bundle-{{ section.id }} .fb-variant-chips .fb-variant + .fb-variant::before {
    content: '\2022';
    display: inline-block;
    margin-left: 0.5rem;
    margin-right: 0.5rem;
    vertical-align: middle;
  }
  @media (min-width: 768px) {
    .fixed-bundle-{{ section.id }} .fb-variant-chips .fb-variant + .fb-variant::before {
      content: '';
      width: 1px;
      height: 1em;
      background: currentColor;
    }
  }

  .fixed-bundle-{{ section.id }} .fb-line-price .fb-line-unit::before {
    content: '\2022';
  }
  .fixed-bundle-{{ section.id }} .fb-line-price .fb-line-unit {
    font-size: {{ text_size | times: 0.8125 }}rem;
  }

  .fixed-bundle-{{ section.id }} .fb-total {
    color: rgb(var(--colors-price));
  }
  .fixed-bundle-{{ section.id }} .fb-was {
    color: rgba(var(--colors-price-sale), 0.5);
    font-size: {{ text_size | times: 0.875 }}rem;
    text-decoration: line-through;
  }
  @media (max-width: 767px) {
    .fixed-bundle-{{ section.id }} .x-pgw {
      padding-left: 0;
      padding-right: 0;
    }
  }
  {%- unless layout == 'conversion' -%}
    @media (min-width: 768px) {
      .fixed-bundle-{{ section.id }} .fb-line-price .fb-line-unit::before {
        display: none;
      }
      .fixed-bundle-{{ section.id }} .card-product-content {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        column-gap: 2rem;
        align-items: start;
      }
      .fixed-bundle-{{ section.id }} .card-product-info {
        grid-column: 1;
        grid-row: 1;
      }
      .fixed-bundle-{{ section.id }} .card-product-pricing {
        text-align: end;
        grid-column: 2;
        grid-row: 1;
      }
      .fixed-bundle-{{ section.id }} .card-product-actions {
        grid-column: 1;
        grid-row: 2;
      }
    }
  {%- endunless -%}
{%- endstyle -%}

{%- assign show_countdown = false -%}
{%- if countdown_block -%}
  {% liquid
    assign countdown_heading_rem = countdown_block.settings.text_size | times: settings.text_base_size | times: 0.000225
    assign countdown_text_rem = countdown_block.settings.text_size | times: settings.text_base_size | times: 0.0000875

    assign keep_countdown = false
    if countdown_block.settings.countdown_type == 'standard' and countdown_block.settings.end_behavior == 'keep'
      assign keep_countdown = true
    endif

    assign show_end_message = false
    if countdown_block.settings.countdown_type == 'standard' and countdown_block.settings.end_message != blank
      assign show_end_message = true
    endif

    assign countdown_ended = false
    if countdown_block.settings.countdown_type == 'standard'
      assign end_month = countdown_block.settings.end_month | plus: 0
      assign end_day = countdown_block.settings.end_day | plus: 0
      assign end_hour = countdown_block.settings.end_hour | plus: 0
      assign end_minute = countdown_block.settings.end_minute | plus: 0
      if end_month < 10
        assign end_month = '0' | append: end_month
      endif
      if end_day < 10
        assign end_day = '0' | append: end_day
      endif
      if end_hour < 10
        assign end_hour = '0' | append: end_hour
      endif
      if end_minute < 10
        assign end_minute = '0' | append: end_minute
      endif
      
      assign time_zone = countdown_block.settings.timezone
      
      assign time_zone_minute = '00'
      if time_zone contains '.5'
        assign time_zone = time_zone | split: '.' | first
        assign time_zone_minute = '30'
      endif

      assign time_zone = countdown_block.settings.timezone | plus: 0
      assign time_zone_sign = '+'
      if time_zone < 0
        assign time_zone_sign = ''
      endif

      assign end_date = countdown_block.settings.end_year | append: "-" | append: end_month | append: "-" | append: end_day | append: " " | append: end_hour | append: ":" | append: end_minute | append: ":00" | append: " " | append: time_zone_sign | append: time_zone | append: ":" | append: time_zone_minute
      assign end_date = end_date | date: "%s" | plus: 0
      assign current_date = "now" | date: "%s" | plus: 0

      if end_date <= current_date
        assign countdown_ended = true
      endif
    endif

    unless countdown_ended and keep_countdown == false and show_end_message == false
      assign show_countdown = true
    endunless

    if layout == 'mixed'
      assign countdown_overlay_radius_md = '10px'
    endif

    if countdown_block.settings.separator == 'none' and countdown_block.settings.timer_style == 'square' and countdown_block.settings.border_style == 'none' and countdown_block.settings.text_position == 'aside'
      assign text_position = 'aside'
    else
      assign text_position = 'below'
    endif
  %}
{%- endif -%}

{%- if section.settings.show_section_divider or section.settings.show_section_divider_mobile -%}
  {% render 'section-divider' %}
{%- endif -%}

{%- capture fb_countdown_attrs -%}
  {%- if show_countdown -%}
    x-data="{ countdownLoading: true, ended: {% if countdown_ended %}true{% else %}false{% endif %}, textLoad: '-', days: 0, hours: 0, mins: 0, secs: 0 }"
    x-intersect.once.margin.200px='$nextTick(() => {
      $store.xHelper.countdown({
        "id": "{{ countdown_block.id }}",
        "timezone": {{ countdown_block.settings.timezone | default: 0 }},
        "end_year": {{ countdown_block.settings.end_year | default: 0 }},
        "end_month": {{ countdown_block.settings.end_month | default: 0 }},
        "end_day": {{ countdown_block.settings.end_day | default: 0 }},
        "end_hour": {{ countdown_block.settings.end_hour | default: 0 }},
        "end_minute": {{ countdown_block.settings.end_minute | default: 0 }},
        "reset": {% if countdown_block.settings.countdown_type == 'evergreen' %}true{% else %}false{% endif %},
        "duration": {% if countdown_block.settings.interval_unit == 'day' %}{{ countdown_block.settings.countdown_interval | times: 86400000 }}{% else %}{{ countdown_block.settings.countdown_interval | times: 3600000 }}{% endif %}
      }, (canShow, s, m, h, d) => {
        if (!canShow) { ended = true; countdownLoading = false; days = 0; hours = 0; mins = 0; secs = 0; $dispatch("eurus:fixed-bundle:countdown-ended", { sectionId: "{{ section.id }}" }); return }
        days = d; hours = h; mins = m; secs = s; countdownLoading = false;
      })
    })'
  {%- endif -%}
{%- endcapture -%}

{%- capture fb_atc_ended_attrs -%}
  {%- if countdown_ended -%}
    disabled data-countdown-ended="true"
  {%- endif -%}
{%- endcapture -%}

{%- capture fb_bundle_countdown -%}
  {%- if layout != 'conversion' and show_countdown and countdown_block.settings.countdown_position != 'summary' -%}
    {% render 'fixed-bundle-countdown',
      countdown_block: countdown_block,
      countdown_heading_rem: countdown_heading_rem,
      countdown_text_rem: countdown_text_rem,
      text_position: text_position,
      keep_countdown: keep_countdown,
      show_end_message: show_end_message,
      countdown_ended: countdown_ended,
      overlay: true,
      overlay_radius_md: countdown_overlay_radius_md,
      heading_alignment: heading_alignment,
      rtl_alignment: rtl_alignment
    %}
  {%- endif -%}
{%- endcapture -%}

{%- capture fb_summary_countdown -%}
  {%- if show_countdown and countdown_block.settings.countdown_position != 'bundle' -%}
    {%- if layout == 'conversion' -%}
      {% style %}
      .fixed-bundle-countdown-summary-{{ section.id }} .text-countdown {
        color: rgba(var(--color-highlight));
        width: 100px;
        {% if section.settings.heading_highlight_color_light.alpha != 0.0 %}
          --color-highlight: {{ section.settings.heading_highlight_color_light.red }}, {{ section.settings.heading_highlight_color_light.green }}, {{ section.settings.heading_highlight_color_light.blue }};
        {% else %}
          --color-highlight: {{ settings.colors_heading_highlight.red }}, {{ settings.colors_heading_highlight.green }}, {{ settings.colors_heading_highlight.blue }};
        {% endif %}
      }
      .dark .fixed-bundle-countdown-summary-{{ section.id }} .text-countdown {
        {% if section.settings.heading_highlight_color_dark.alpha != 0.0 %}
          --color-highlight: {{ section.settings.heading_highlight_color_dark.red }}, {{ section.settings.heading_highlight_color_dark.green }}, {{ section.settings.heading_highlight_color_dark.blue }};
        {% else %}
          --color-highlight: {{ settings.colors_dark_heading_highlight.red }}, {{ settings.colors_dark_heading_highlight.green }}, {{ settings.colors_dark_heading_highlight.blue }};
        {% endif %}
      }
      {% endstyle %}
    {%- endif -%}
    <div class="fixed-bundle-countdown-summary-{{ section.id }} flex items-center gap-1 text-center">
      <div
        {%- unless countdown_ended %} :class="{ 'invisible': countdownLoading }"{% endunless %}
        class="{% unless countdown_ended %}invisible {% endunless %}flex gap-1{% unless layout == 'conversion' %} items-center text-[rgba(var(--colors-text))]{% endunless %}"
      >
        <span class="inline-block{% if layout == 'conversion' %} w-5 h-5{% else %} w-4 h-4{% endif %}">{% render 'icon-alls', icon: 'icon-countdown-clock' %}</span>
        {%- if countdown_ended -%}
          <span>{{ 'sections.fixed-bundle.promotion_ended' | t }}</span>
        {%- else -%}
          <span x-show="!ended" class="md:hidden">{{ 'sections.fixed-bundle.ends_in' | t }}</span>
          <span x-show="!ended" class="hidden md:block">{{ 'sections.fixed-bundle.bundle_price_ends_in' | t }}</span>
          <span x-show="ended" x-cloak>{{ 'sections.fixed-bundle.promotion_ended' | t }}</span>
        {%- endif -%}
      </div>
      {%- unless countdown_ended and keep_countdown == false -%}
        {%- if countdown_ended -%}
          <div class="font-bold {% if layout == 'conversion' %}text-countdown{% else %}text-[rgba(var(--colors-heading))]{% endif %}">00:00:00</div>
        {%- else -%}
          <div
            {% unless keep_countdown %}x-show="!ended"{% endunless %}
            :class="!countdownLoading && '{% if layout == 'conversion' %}text-countdown{% else %}text-[rgba(var(--colors-heading))]{% endif %}'"
            class="font-bold"
            x-text="countdownLoading ? textLoad : (days > 0 ? [days, hours, mins, secs] : [hours, mins, secs]).map(n => String(n).padStart(2, '0')).join(':')"
          ></div>
        {%- endif -%}
      {%- endunless -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

<div x-data="xProductsList('{{ section.id }}')" class="fixed-bundle-{{ section.id }} section-padding-{{ section.id }} relative">
  {%- if layout == 'conversion' -%}
    {% liquid 
      assign bg_image = section.settings.bg_image
      assign bg_image_mobile = section.settings.bg_image_mobile
    %}
    {%- if bg_image != blank or bg_image_mobile != blank -%}
      <span class="{%- if bg_image == blank and bg_image_mobile != blank -%}md:hidden {% endif %}absolute top-0 left-0 bottom-0 right-0 z-10 pointer-events-none image-treatment-overlay opacity-{{ section.settings.overlay_opacity }}"></span>
      {% # theme-check-disable ImgLazyLoading %}
      {%- if bg_image != blank -%}
        <img
          class="fb-section-bg{% if bg_image_mobile != blank %} hidden md:block{% endif %} absolute inset-0 w-full h-full object-cover object-center"
          srcset="{{ bg_image | image_url: width: 750 }} 750w,
            {{ bg_image | image_url: width: 1100 }} 1100w,
            {{ bg_image | image_url: width: 1500 }} 1500w,
            {{ bg_image | image_url: width: 2000 }} 2000w,
            {{ bg_image | image_url: width: 3000 }} 3000w"
          sizes="100vw"
          src="{{ bg_image | image_url: width: 2000 }}"
          {% if settings.enable_lazy_loading_image %}loading="lazy"{% else %}loading="eager"{% endif %}
          alt="{{ bg_image.alt | escape }}"
          width="{{ bg_image.width }}"
          height="{{ bg_image.height }}"
          style="object-position: {{ bg_image.presentation.focal_point }};"
        >
      {%- endif -%}
      {%- if bg_image_mobile != blank -%}
        <img
          class="fb-section-bg md:hidden absolute inset-0 w-full h-full object-cover object-center"
          srcset="{{ bg_image_mobile | image_url: width: 375 }} 375w,
            {{ bg_image_mobile | image_url: width: 750 }} 750w,
            {{ bg_image_mobile | image_url: width: 900 }} 900w"
          sizes="100vw"
          src="{{ bg_image_mobile | image_url: width: 900 }}"
          {% if settings.enable_lazy_loading_image %}loading="lazy"{% else %}loading="eager"{% endif %}
          alt="{{ bg_image_mobile.alt | escape }}"
          width="{{ bg_image_mobile.width }}"
          height="{{ bg_image_mobile.height }}"
          style="object-position: {{ bg_image_mobile.presentation.focal_point }};"
        >
      {%- endif -%}
      {% # theme-check-enable ImgLazyLoading %}
    {%- endif -%}
  {% endif %}
  <div class="relative x-pgw{% unless section.settings.full_width %} page-width{% endunless %} page-width-mobile z-20">
  {%- if layout == 'conversion' -%}
    {%- style -%}
      {%- if section.settings.background_color_light.alpha != 0.0 -%}
        .fixed-bundle-{{ section.id }} {
          background: rgb({{ section.settings.background_color_light.red }}, {{ section.settings.background_color_light.green }}, {{ section.settings.background_color_light.blue }});
        }
      {%- endif -%}
      .dark .fixed-bundle-{{ section.id }} {
        {%- if section.settings.background_color_dark.alpha != 0.0 -%}
          background: rgb({{ section.settings.background_color_dark.red }}, {{ section.settings.background_color_dark.green }}, {{ section.settings.background_color_dark.blue }});
        {%- else -%}
          background: transparent;
        {%- endif -%}
      }

      {%- if settings.card_product_background_color_light.alpha != 0.0 -%}
        .fixed-bundle-{{ section.id }} .fb-summary {
          background: rgb({{ settings.card_product_background_color_light.red }}, {{ settings.card_product_background_color_light.green }}, {{ settings.card_product_background_color_light.blue }});
        }
      {%- endif -%}
      .dark .fixed-bundle-{{ section.id }} .fb-summary {
        {%- if settings.card_product_background_color_dark.alpha != 0.0 -%}
          background: rgb({{ settings.card_product_background_color_dark.red }}, {{ settings.card_product_background_color_dark.green }}, {{ settings.card_product_background_color_dark.blue }});
        {%- else -%}
          background: transparent;
