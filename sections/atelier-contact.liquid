{%- liquid
  assign form_id = 'ContactForm-' | append: section.id
  assign contact_heading = section.settings.heading | default: page.title
  assign first_name_label = 'customer.register.first_name' | t
  assign last_name_label = 'customer.register.last_name' | t
  assign email_label = 'customer.email' | t
  assign phone_label = 'templates.contact.form.phone' | t
  assign message_label = 'templates.contact.form.message' | t
  assign button_label = 'templates.contact.form.send' | t
  assign success_message = 'templates.contact.form.post_success' | t
-%}
{%- style -%}
  #AtelierContact-{{ section.id }} {
    --contact-background: {{ section.settings.background_color_light }};
    --contact-color: {{ section.settings.text_color }};
    --contact-soft: {{ section.settings.soft_color }};
    --contact-accent: {{ section.settings.accent_color }};
  }
{%- endstyle -%}
<div id="AtelierContact-{{ section.id }}" class="atelier-contact">
  <div class="atelier-contact__intro">
    <div class="atelier-contact__page atelier-contact__reading">
      {% if section.settings.show_breadcrumbs %}
        <nav aria-label="{{ 'accessibility.breadcrumb' | t | escape }}" class="atelier-contact__breadcrumbs">
          <ol role="list">
            <li><a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a></li>
            <li><span aria-current="page">{{ contact_heading | escape }}</span></li>
          </ol>
        </nav>
      {% endif %}
      <header class="atelier-contact__head">
        <h1 class="atelier-contact__title">{{ contact_heading | escape }}</h1>
        {% if section.settings.text != blank %}
          <div class="atelier-contact__text rte">{{ section.settings.text }}</div>
        {% endif %}
      </header>
    </div>
  </div>
  <div class="atelier-contact__body">
    <div class="atelier-contact__page atelier-contact__narrow">
      {%- form 'contact', id: form_id, class: 'atelier-contact__form' -%}
        {%- if form.posted_successfully? -%}
          <div class="atelier-contact__notice" role="status" tabindex="-1" autofocus>
            {{ section.settings.success_message | default: success_message | escape }}
          </div>
        {%- elsif form.errors -%}
          <div class="atelier-contact__notice" role="alert" tabindex="-1" autofocus>
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}
        <div class="atelier-contact__fields">
          {%- for block in section.blocks -%}
            {%- liquid
              assign field_id = form_id | append: '-' | append: block.id
              assign field_label = block.settings.heading
              assign field_required = block.settings.mark_as_required
              assign field_type = 'text'
              assign field_name = field_label
              assign field_autocomplete = ''
              assign field_value = form[field_name]
              case block.type
                when 'name'
                  assign field_label = field_label | default: first_name_label
                  assign field_autocomplete = 'given-name'
                  assign field_value = field_value | default: customer.first_name
                when 'last_name'
                  assign field_label = field_label | default: last_name_label
                  assign field_autocomplete = 'family-name'
                  assign field_value = field_value | default: customer.last_name
                when 'email'
                  assign field_label = field_label | default: email_label
                  assign field_type = 'email'
                  assign field_name = 'email'
                  assign field_autocomplete = 'email'
                  assign field_required = true
                  assign field_value = form.email | default: customer.email
                when 'phone'
                  assign field_label = field_label | default: phone_label
                  assign field_type = 'tel'
                  assign field_name = 'phone'
                  assign field_autocomplete = 'tel'
                  assign field_value = form.phone | default: customer.phone
                when 'message'
                  assign field_label = field_label | default: message_label
                  assign field_name = 'body'
              endcase
              if field_name == blank
                assign field_name = field_label
              endif
            -%}
            <div class="atelier-contact__field{% if block.type == 'name' or block.type == 'last_name' or block.type == 'phone' %} atelier-contact__field--half{% endif %}" {{ block.shopify_attributes }}>
              <label class="atelier-contact__label" for="{{ field_id }}">
                {{ field_label | escape }}{% unless field_required %} <span class="atelier-contact__optional">{{ 'templates.contact.form.optional' | t }}</span>{% endunless %}
              </label>
              {%- if block.type == 'message' -%}
                <textarea class="atelier-contact__input atelier-contact__textarea" id="{{ field_id }}" name="contact[body]" rows="8"{% if field_required %} required{% endif %}>{{ form.body | escape }}</textarea>
              {%- else -%}
                <input
                  class="atelier-contact__input"
                  id="{{ field_id }}"
                  type="{{ field_type }}"
                  name="contact[{{ field_name | escape }}]"
                  value="{{ field_value | escape }}"
                  autocomplete="{{ field_autocomplete }}"
                  {% if field_type == 'email' %}
                    autocorrect="off" autocapitalize="off" spellcheck="false"
                    {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="{{ form_id }}-email-error"{% endif %}
                  {% endif %}
                  {% if field_required %}required{% endif %}
                >
                {% if field_type == 'email' and form.errors contains 'email' %}
                  <p class="atelier-contact__error" id="{{ form_id }}-email-error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
                {% endif %}
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
        <button type="submit" class="atelier-contact__submit"><span>{{ section.settings.button_label | default: button_label | escape }}</span></button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.contact-form.name",
  "tag": "section",
  "class": "section-atelier-contact",
  "disabled_on": { "groups": ["header", "footer", "aside"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.all.text.heading", "default": "Contact" },
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "t:settings_schema.search_navigation.show_breadcrumbs", "default": true },
    { "type": "richtext", "id": "text", "label": "t:sections.atelier_story_index.text" },
    { "type": "text", "id": "button_label", "label": "t:sections.all.button.label", "default": "Send" },
    { "type": "text", "id": "success_message", "label": "t:sections.featured-product.blocks.back_in_stock_alert.settings.text_success.label", "default": "Thanks for contacting us. We'll get back to you as soon as possible." },
    { "type": "color", "id": "background_color_light", "label": "t:sections.atelier_story_index.background_color", "default": "#0B0E28" },
    { "type": "color", "id": "text_color", "label": "t:sections.atelier_story_index.text_color", "default": "#F2F6FB" },
    { "type": "color", "id": "soft_color", "label": "t:sections.atelier_story_index.soft_color", "default": "#A9C3E2" },
    { "type": "color", "id": "accent_color", "label": "t:atelier_footer.accent_color", "default": "#6E9BFF" }
  ],
  "blocks": [
    {
      "type": "name", "name": "t:sections.contact-form.blocks.name.name", "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.contact-form.blocks.name.settings.field_label.label", "default": "First name" },
        { "type": "checkbox", "id": "mark_as_required", "label": "t:sections.contact-form.blocks.name.settings.mark_as_required.label", "default": true }
      ]
    },
    {
      "type": "last_name", "name": "t:atelier_contact.last_name", "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.contact-form.blocks.name.settings.field_label.label", "default": "Last name" },
        { "type": "checkbox", "id": "mark_as_required", "label": "t:sections.contact-form.blocks.name.settings.mark_as_required.label", "default": false }
      ]
    },
    {
      "type": "email", "name": "t:sections.contact-form.blocks.email.name", "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.contact-form.blocks.name.settings.field_label.label", "default": "Email" }
      ]
    },
    {
      "type": "phone", "name": "t:sections.contact-form.settings.phone_nummber.label", "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.contact-form.blocks.name.settings.field_label.label", "default": "Telephone" },
        { "type": "checkbox", "id": "mark_as_required", "label": "t:sections.contact-form.blocks.name.settings.mark_as_required.label", "default": false }
      ]
    },
    {
      "type": "message", "name": "t:sections.contact-form.blocks.message.name", "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "t:sections.contact-form.blocks.name.settings.field_label.label", "default": "Message" },
        { "type": "checkbox", "id": "mark_as_required", "label": "t:sections.contact-form.blocks.name.settings.mark_as_required.label", "default": true }
      ]
    }
  ],
  "presets": [{
    "name": "t:sections.contact-form.name",
    "category": "t:categories.forms",
    "blocks": [{ "type": "name" }, { "type": "last_name" }, { "type": "email" }, { "type": "phone" }, { "type": "message" }]
  }]
}
{% endschema %}
