{%- liquid
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font
  assign video_source = section.settings.video_file_url
  for source in section.settings.video.sources
    if source.mime_type == 'video/mp4'
      assign video_source = source.url
      break
    endif
  endfor
  assign poster = section.settings.image | default: section.settings.video.preview_image
  assign image_loading = 'lazy'
  if section.index <= 2
    assign image_loading = 'eager'
  endif
  assign poster_url = section.settings.poster_url
  if poster != blank
    assign poster_url = poster | image_url: width: 1600
  endif
-%}
{% style %}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}
  #atelier-media-story-{{ section.id }} {
    --media-story-heading-font: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --media-story-heading-weight: {{ heading_font.weight }};
    --media-story-body-font: {{ body_font.family }}, {{ body_font.fallback_families }};
    --media-story-body-weight: {{ body_font.weight }};
    --media-story-background: {{ section.settings.background_color }};
    --media-story-text: {{ section.settings.text_color }};
    --media-story-soft: {{ section.settings.soft_color }};
    --media-story-accent: {{ section.settings.accent_color }};
    --media-story-button: {{ section.settings.button_color }};
    --media-story-button-text: {{ section.settings.button_text_color }};
    --media-story-ratio: {{ section.settings.video_ratio }};
    --media-story-mobile-ratio: {{ section.settings.video_ratio_mobile }};
    --media-story-top: {{ section.settings.padding_top }}px;
    --media-story-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}
<div id="atelier-media-story-{{ section.id }}" class="atelier-media-story atelier-media-story--{{ section.settings.layout }}">
  <div class="atelier-media-story__page">
    <div class="atelier-media-story__inner">
      <div class="atelier-media-story__media"
        {% if video_source != blank %}
          x-data="xAtelierMediaStory" data-video-src="{{ video_source | escape }}" data-autoplay="{{ section.settings.enable_video_autoplay }}"
        {% endif %}
      >
        {%- if poster != blank -%}
          {{ poster | image_url: width: 1600 | image_tag: widths: '360, 540, 720, 960, 1200, 1600', sizes: '(min-width: 1720px) 920px, (min-width: 990px) 55vw, 100vw', loading: image_loading, class: 'atelier-media-story__poster', alt: '' }}
        {%- elsif poster_url != blank -%}
          <img class="atelier-media-story__poster" src="{{ poster_url | escape }}" width="1600" height="2000" alt="" loading="{{ image_loading }}">
        {%- endif -%}
        {%- if video_source != blank -%}
          <video id="atelier-media-story-video-{{ section.id }}" class="atelier-media-story__video" x-ref="video" playsinline muted loop preload="none"
            {% if poster_url != blank %}poster="{{ poster_url | escape }}"{% endif %}
            aria-label="{{ section.settings.video_alt_text | escape }}"
            @playing="playing = true" @pause="playing = false" @ended="playing = false"
          ></video>
          <button class="atelier-media-story__toggle" type="button" x-cloak @click="toggleVideo()"
            aria-controls="atelier-media-story-video-{{ section.id }}"
            aria-label="{{ 'accessibility.play_video' | t | escape }}"
            :aria-label="playing ? {{ 'accessibility.pause_video' | t | json | escape }} : {{ 'accessibility.play_video' | t | json | escape }}"
            :aria-pressed="playing"
          >
            <svg x-show="!playing" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M8 5.4v13.2L19 12Z" stroke-linejoin="round"/></svg>
            <svg x-show="playing" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M9 5v14M15 5v14" stroke-linecap="round"/></svg>
          </button>
        {%- endif -%}
      </div>
      <div class="atelier-media-story__body">
        {%- if section.settings.eyebrow != blank -%}
          <p class="atelier-media-story__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="atelier-media-story__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="atelier-media-story__text">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <ol class="atelier-media-story__steps" role="list">
            {%- for block in section.blocks -%}
              <li class="atelier-media-story__step" {{ block.shopify_attributes }}>
                <span class="atelier-media-story__number" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
                <div class="atelier-media-story__step-body">
                  <span class="atelier-media-story__step-title">{{ block.settings.title | escape }}</span>
                  {%- if block.settings.text != blank -%}<span class="atelier-media-story__step-text">{{ block.settings.text | escape }}</span>{%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ol>
        {%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <div class="atelier-media-story__buttons">
            <a class="atelier-media-story__button" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.atelier_media_story.name",
  "tag": "section",
  "class": "section-atelier-media-story",
  "disabled_on": { "groups": ["header", "footer", "aside"] },
  "settings": [
    { "type": "select", "id": "layout", "label": "t:sections.atelier_media_story.layout", "default": "overlap", "options": [
      { "value": "overlap", "label": "t:sections.atelier_media_story.overlap" },
      { "value": "split", "label": "t:sections.atelier_media_story.split" }
    ] },
    { "type": "font_picker", "id": "heading_font", "default": "oswald_n7", "label": "t:sections.atelier_story_index.heading_font" },
    { "type": "font_picker", "id": "body_font", "default": "archivo_n4", "label": "t:sections.atelier_story_index.body_font" },
    { "type": "text", "id": "eyebrow", "label": "t:sections.atelier_story_index.eyebrow" },
    { "type": "text", "id": "heading", "label": "t:sections.atelier_media_story.heading" },
    { "type": "richtext", "id": "text", "label": "t:sections.atelier_story_index.text" },
    { "type": "video", "id": "video", "label": "t:sections.atelier_media_story.video" },
    { "type": "url", "id": "video_file_url", "label": "t:sections.atelier_media_story.video_file_url", "info": "t:sections.atelier_media_story.video_file_url_info" },
    { "type": "image_picker", "id": "image", "label": "t:sections.atelier_media_story.poster" },
    { "type": "url", "id": "poster_url", "label": "t:sections.atelier_media_story.poster_url" },
    { "type": "text", "id": "video_alt_text", "label": "t:sections.atelier_media_story.video_alt_text" },
    { "type": "checkbox", "id": "enable_video_autoplay", "default": true, "label": "t:sections.atelier_media_story.autoplay" },
    { "type": "select", "id": "video_ratio", "label": "t:sections.atelier_media_story.video_ratio", "default": "4 / 5", "options": [
      { "value": "4 / 5", "label": "t:sections.atelier_media_story.portrait" },
      { "value": "16 / 9", "label": "t:sections.atelier_media_story.landscape" },
      { "value": "1 / 1", "label": "t:sections.atelier_media_story.square" }
    ] },
    { "type": "select", "id": "video_ratio_mobile", "label": "t:sections.atelier_media_story.video_ratio_mobile", "default": "4 / 5", "options": [
      { "value": "4 / 5", "label": "t:sections.atelier_media_story.portrait" },
      { "value": "16 / 9", "label": "t:sections.atelier_media_story.landscape" },
      { "value": "1 / 1", "label": "t:sections.atelier_media_story.square" }
    ] },
    { "type": "text", "id": "button_label", "label": "t:sections.atelier_media_story.button_label" },
    { "type": "url", "id": "button_link", "label": "t:sections.atelier_story_index.link" },
    { "type": "color", "id": "background_color", "default": "#101740", "label": "t:sections.atelier_story_index.background_color" },
    { "type": "color", "id": "text_color", "default": "#F2F6FB", "label": "t:sections.atelier_story_index.text_color" },
    { "type": "color", "id": "soft_color", "default": "#A9C3E2", "label": "t:sections.atelier_story_index.soft_color" },
    { "type": "color", "id": "accent_color", "default": "#6E9BFF", "label": "t:sections.atelier_story_index.accent_color" },
    { "type": "color", "id": "button_color", "default": "#F2F6FB", "label": "t:sections.atelier_media_story.button_color" },
    { "type": "color", "id": "button_text_color", "default": "#101740", "label": "t:sections.atelier_media_story.button_text_color" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 92, "label": "t:sections.atelier_story_index.padding_top" },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 92, "label": "t:sections.atelier_story_index.padding_bottom" }
  ],
  "blocks": [{
    "type": "step", "name": "t:sections.atelier_media_story.step", "settings": [
      { "type": "text", "id": "title", "label": "t:sections.atelier_story_index.title" },
      { "type": "text", "id": "text", "label": "t:sections.atelier_story_index.text" }
    ]
  }],
  "presets": [
    {
      "name": "t:sections.atelier_media_story.commission",
      "settings": {
        "layout": "overlap", "eyebrow": "t:sections.atelier_media_story.defaults.commission_eyebrow", "heading": "t:sections.atelier_media_story.defaults.commission_heading", "text": "t:sections.atelier_media_story.defaults.commission_text",
        "button_label": "t:sections.atelier_media_story.defaults.button_label", "button_link": "/pages/design-your-ring"
      },
      "blocks": [
        { "type": "step", "settings": { "title": "t:sections.atelier_media_story.defaults.step_1_title", "text": "t:sections.atelier_media_story.defaults.step_1_text" } },
        { "type": "step", "settings": { "title": "t:sections.atelier_media_story.defaults.step_2_title", "text": "t:sections.atelier_media_story.defaults.step_2_text" } },
        { "type": "step", "settings": { "title": "t:sections.atelier_media_story.defaults.step_3_title", "text": "t:sections.atelier_media_story.defaults.step_3_text" } }
      ]
    },
    {
      "name": "t:sections.atelier_media_story.workshop",
      "settings": {
        "layout": "split", "eyebrow": "t:sections.atelier_media_story.defaults.workshop_eyebrow", "heading": "t:sections.atelier_media_story.defaults.workshop_heading", "text": "t:sections.atelier_media_story.defaults.workshop_text",
        "video_ratio": "16 / 9", "video_ratio_mobile": "16 / 9", "background_color": "#0B0E28", "padding_top": 132, "padding_bottom": 132
      }
    }
  ]
}
{% endschema %}
