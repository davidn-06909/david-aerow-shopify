    "atelier_correspondence": {
      "type": "testimonials",
      "name": "Correspondence",
      "blocks": {
        "claire": {
          "type": "testimonial",
          "settings": {
            "icon_star": "5_star",
            "title": "",
            "text": "<p>The knife-edge band catches light in a way the photographs could not show. Resized once, free, in four days.</p>",
            "author": "Claire D. — Paris",
            "author_note": "",
            "related_link_label": "The Aevow Solitaire, Knife Edge",
            "related_link": "/products/the-aevow-solitaire"
          }
        },
        "tom_ilse": {
          "type": "testimonial",
          "settings": {
            "icon_star": "5_star",
            "title": "",
            "text": "<p>We chose the eternal bands together at the atelier. The engraving inside is exactly her handwriting — they scanned it from a card.</p>",
            "author": "Tom and Ilse — Amsterdam",
            "author_note": "",
            "related_link_label": "The Eternal Bands — Pair",
            "related_link": "/products/the-eternal-bands"
          }
        },
        "mei": {
          "type": "testimonial",
          "settings": {
            "icon_star": "4_star",
            "title": "",
            "text": "<p>The ring care plan is the reason I still wear it every day: cleaned, tightened, checked, twice a year, without asking.</p>",
            "author": "Mei L. — Singapore",
            "author_note": "",
            "related_link_label": "Ring Care Plan",
            "related_link": ""
          }
        }
      },
      "block_order": [
        "claire",
        "tom_ilse",
        "mei"
      ],
      "settings": {
