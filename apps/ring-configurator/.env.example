SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://your-app.onrender.com
SCOPES=read_products,read_inventory,read_orders,write_app_proxy
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aevow_ring?schema=public
# Optional direct connection for Prisma schema migrations; runtime stays pooled.
DATABASE_URL_UNPOOLED=
CONFIGURATION_SIGNING_SECRET=
PREVIEW_STORAGE=database
PILOT_MANIFEST_PATH=config/pilot.local.json
# Hosting can supply this JSON directly instead of a secret file.
PILOT_MANIFEST_JSON=
# Numeric or GraphQL location ID; blank uses Shopify's primary/default location.
PILOT_FULFILLMENT_LOCATION_ID=
# Optional one-time setup override; never chooses an arbitrary active location.
PILOT_SETUP_LOCATION_ID=
# Blank serves public versioned GLBs from the app's own CORS-enabled resource.
ASSET_BASE_URL=
# R2 is optional future storage; database mode requires none of these values.
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aevow-ring-pilot
R2_PUBLIC_URL=https://your-public-r2-domain
# Only enable for visual QA; this never enables commerce or saving.
ENABLE_READ_ONLY_PREVIEW=false
# Only an explicitly allowed Shopify partner development store can issue quotes.
ENABLE_PURCHASES=false
PILOT_ALLOWED_SHOP=your-development-store.myshopify.com
# Enable only for a SingleMerchant app installed in the same Dev Dashboard org.
CLIENT_CREDENTIALS_AUTH=false
# Durable order processing; enable only on the reviewed hosted development app.
ENABLE_OPERATIONS=false
