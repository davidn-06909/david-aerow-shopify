generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model Session {
  id String @id
  shop String
  state String
  isOnline Boolean @default(false)
  scope String?
  expires DateTime?
  accessToken String
  userId BigInt?
  firstName String?
  lastName String?
  email String?
  accountOwner Boolean @default(false)
  locale String?
  collaborator Boolean? @default(false)
  emailVerified Boolean? @default(false)
  refreshToken String?
  refreshTokenExpires DateTime?
  @@index([shop])
}
model Quote {
  id String @id @default(uuid())
  shop String
  snapshot Json
  signature String
  requestId String?
  requestHash String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  designs Design[]
  @@index([shop, expiresAt])
  @@unique([shop, requestId])
}
model Design {
  id String @id @default(uuid())
  shop String
  quoteId String
  quote Quote @relation(fields: [quoteId], references: [id])
  snapshot Json
  previewUrl String?
  previewData Bytes?
  previewMime String?
  createdAt DateTime @default(now())
  orders OrderDesign[]
  @@index([shop, createdAt])
}
model WebhookReceipt {
  id String @id
  shop String
  topic String
  payload Json
  status String @default("pending")
  attempts Int @default(0)
  lastError String?
  processedAt DateTime?
  createdAt DateTime @default(now())
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  leaseToken String?
  consecutiveFailures Int @default(0)
  @@index([status, createdAt])
  @@index([shop, status, nextAttemptAt])
}
model OrderDesign {
  id String @id @default(uuid())
  shop String
  orderId String
  designId String
  design Design @relation(fields: [designId], references: [id])
  configurationId String
  status String
  discrepancies Json
  createdAt DateTime @default(now())
  @@unique([shop, orderId, configurationId])
}

// Published manifests are immutable; only the tenant's active pointer changes.
model CatalogState {
  shop String @id
  draft Json
  revision Int @default(1)
  activeVersion String
  updatedAt DateTime @updatedAt
}
model CatalogRelease {
  id String @id @default(uuid())
  shop String
  manifest Json
  report Json
  action String
  actor String
  restoredFrom String?
  createdAt DateTime @default(now())
  @@index([shop, createdAt])
}

// Mutable projection; the original designs and append-only audits are preserved.
model ConfiguredOrder {
  id String @id @default(uuid())
  shop String
  orderId String
  name String
  paymentState String
  cancelled Boolean @default(false)
  sourceUpdatedAt DateTime
  synchronizedAt DateTime @default(now())
  verification String
  digest String
  version Int @default(1)
  facts Json
  settingIds String[] @default([])
  audits OrderAuditRun[]
  actions MerchantOrderAction[]
  @@unique([shop, orderId])
  @@index([shop, synchronizedAt])
  @@index([shop, verification, synchronizedAt])
}

model OrderAuditRun {
  id String @id @default(uuid())
  configuredOrderId String
  configuredOrder ConfiguredOrder @relation(fields: [configuredOrderId], references: [id])
  source String
  version Int
  digest String
  verification String
  evidence Json
  createdAt DateTime @default(now())
  @@index([configuredOrderId, createdAt])
  @@unique([configuredOrderId, version])
}

model OperationAction {
  id String @id @default(uuid())
  shop String
  requestId String
  actor String
  intent String
  target String
  createdAt DateTime @default(now())
  @@unique([shop, requestId])
  @@index([shop, createdAt])
}

model MerchantOrderAction {
  id String @id @default(uuid())
  shop String
  requestId String
  configuredOrderId String
  configuredOrder ConfiguredOrder @relation(fields: [configuredOrderId], references: [id])
  actor String
  auditId String
  decision String
  reason String
  createdAt DateTime @default(now())
  @@unique([shop, requestId])
  @@index([configuredOrderId, createdAt])
}

model JobCheckpoint {
  shop String
  kind String
  checkpoint Json?
  leaseUntil DateTime?
  leaseToken String?
  lastSuccessAt DateTime?
  lastError String?
  updatedAt DateTime @updatedAt
  @@id([shop, kind])
}

// Historical membership survives catalog removal and removed line properties.
model ManagedComponent {
  shop String
  kind String
  referenceId String
  @@id([shop, kind, referenceId])
}

model RequestBucket {
  shop String
  key String
  window DateTime
  count Int @default(1)
  expiresAt DateTime
  @@id([shop, key, window])
  @@index([expiresAt])
}
