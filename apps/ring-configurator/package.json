{
  "name": "@aevow/ring-configurator",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "shopify app dev",
    "dev:server": "node --env-file-if-exists=.env ./node_modules/@react-router/dev/bin.js dev",
    "build": "react-router build",
    "build:storefront": "vite build --config vite.storefront.config.ts && node scripts/copy-storefront.mjs",
    "models": "tsx scripts/generate-models.ts",
    "start": "node --env-file-if-exists=.env ./node_modules/@react-router/serve/bin.js ./build/server/index.js",
    "setup": "prisma generate && npm run db:migrate",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate-database.mjs",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "vitest run",
    "deploy": "npm run build:storefront && shopify app deploy",
    "webhooks:retry": "node --env-file-if-exists=.env --import tsx scripts/retry-webhooks.ts",
    "test:database": "tsx tests/database.integration.ts",
    "dev:postgres": "node --env-file-if-exists=.env --import tsx scripts/local-postgres.ts",
    "seed:development": "node --env-file-if-exists=.env --import tsx scripts/seed-development.ts",
    "connect:installed": "node --env-file-if-exists=.env --import tsx scripts/connect-installed-app.ts",
    "setup:commerce": "node --env-file-if-exists=.env --import tsx scripts/prepare-pilot-commerce.ts",
    "build:netlify": "node scripts/build-netlify.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.922.0",
    "@prisma/client": "^6.19.0",
    "@react-router/fs-routes": "7.18.2",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "@shopify/app-bridge-react": "^4.2.4",
    "@shopify/shopify-app-react-router": "^3.0.1",
    "@shopify/shopify-app-session-storage-prisma": "^11.0.0",
    "isbot": "^5.1.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "7.18.2",
    "three": "^0.185.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@netlify/vite-plugin-react-router": "^4.0.0",
    "@react-router/dev": "7.18.2",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.25",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.185.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^3.2.4"
  }
}
