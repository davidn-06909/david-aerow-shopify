{%- liquid
  assign heading_size = block.settings.heading_size | times: settings.heading_base_size | times: 0.000225

  assign heading_alignment = block.settings.heading_alignment
  if heading_alignment == 'left'
    assign rtl_alignment = 'right'
    assign form_alignment = 'mr-auto rtl:ml-auto rtl:mr-0'
  elsif heading_alignment == 'right'
    assign rtl_alignment = 'left'
    assign form_alignment = 'ml-auto rtl:mr-auto rtl:ml-0'
  else
    assign rtl_alignment = 'center'
    assign form_alignment = 'ml-auto mr-auto'
  endif

  assign email_label = block.settings.email_label
  if email_label == blank
    assign email_label = 'newsletter.label' | t
  endif

  assign button_label = block.settings.button_label
  if button_label == blank
    assign button_label = 'templates.contact.form.send' | t
  endif

  assign form_id = 'QuizEmailForm-' | append: block.id
  assign error_id = 'QuizEmailFormError-' | append: block.id
  assign input_id = 'QuizEmailFormInput-' | append: block.id

  if settings.enable_lazy_loading_image 
    assign loading="lazy"
  else 
    assign loading="eager"
  endif
-%}
{%- style -%}
  .quiz-email-form-{{ block.id }} {
    {% if block.settings.background_color_light.alpha != 0.0 %}
      background: {{ block.settings.background_color_light }};
    {% else %}
      background: transparent;
    {% endif %}
    {% if block.settings.heading_color_light.alpha != 0.0 %}
      --colors-heading: {{ block.settings.heading_color_light.red }},{{ block.settings.heading_color_light.green }},{{ block.settings.heading_color_light.blue }};
    {% else %}
      --colors-heading: {{ settings.colors_heading.red }},{{ settings.colors_heading.green }},{{ settings.colors_heading.blue }};
    {% endif %}
    {% if block.settings.text_color_light.alpha != 0.0 %}
      --colors-text: {{ block.settings.text_color_light.red }},{{ block.settings.text_color_light.green }},{{ block.settings.text_color_light.blue }};
    {% else %}
      --colors-text: {{ settings.colors_text.red }},{{ settings.colors_text.green }},{{ settings.colors_text.blue }};
    {% endif %}
  }
  .dark .quiz-email-form-{{ block.id }} {
    {% if block.settings.background_color_dark.alpha != 0.0 %}
      background: {{ block.settings.background_color_dark }};
    {% else %}
      background: transparent;
    {% endif %}
    {% if block.settings.heading_color_dark.alpha != 0.0 %}
      --colors-heading: {{ block.settings.heading_color_dark.red }},{{ block.settings.heading_color_dark.green }},{{ block.settings.heading_color_dark.blue }};
    {% else %}
      --colors-heading: {{ settings.colors_dark_heading.red }},{{ settings.colors_dark_heading.green }},{{ settings.colors_dark_heading.blue }};
    {% endif %}
    {% if block.settings.text_color_dark.alpha != 0.0 %}
      --colors-text: {{ block.settings.text_color_dark.red }},{{ block.settings.text_color_dark.green }},{{ block.settings.text_color_dark.blue }};
    {% else %}
      --colors-text: {{ settings.colors_dark_text.red }},{{ settings.colors_dark_text.green }},{{ settings.colors_dark_text.blue }};
    {% endif %}
  }
  .heading-{{ block.id }} {
    font-size: {{ heading_size | times: 0.6 }}rem;
  }
  .quiz-email-form__header-{{ block.id }} {
    text-align: {{ heading_alignment }};
  }
  [dir="rtl"] .quiz-email-form__header-{{ block.id }} {
    text-align: {{ rtl_alignment }};
  }
  .button-quiz-{{ block.id }}, .button-quiz-{{ block.id }} *:before, .button-quiz-{{ block.id }}:before {
    {% if block.settings.button_light.alpha != 0.0 %}
      --colors-button: {{ block.settings.button_light.red }},{{ block.settings.button_light.green }},{{ block.settings.button_light.blue }};
    {% endif %}
    {% if block.settings.button_text_light.alpha != 0.0 %}
      --colors-button-text: {{ block.settings.button_text_light.red }},{{ block.settings.button_text_light.green }},{{ block.settings.button_text_light.blue }};
    {% endif %}
    {% if block.settings.button_hover_light.alpha != 0.0 %}
      --colors-button-hover: rgb({{ block.settings.button_hover_light.red }},{{ block.settings.button_hover_light.green }},{{ block.settings.button_hover_light.blue }});
    {% endif %}
    {% if block.settings.button_text_hover_light.alpha != 0.0 %}
      --colors-button-text-hover: {{ block.settings.button_text_hover_light.red }},{{ block.settings.button_text_hover_light.green }},{{ block.settings.button_text_hover_light.blue }};
    {% endif %}
    {% if block.settings.textlink_color_light.alpha != 0.0 %}
      --colors-text-link: {{ block.settings.textlink_color_light.red }},{{ block.settings.textlink_color_light.green }},{{ block.settings.textlink_color_light.blue }};
    {% endif %}
  }
  .dark .button-quiz-{{ block.id }}, .dark .button-quiz-{{ block.id }} *:before, .dark .button-quiz-{{ block.id }}:before {
    {% if block.settings.button_dark.alpha != 0.0 %}
      --colors-button: {{ block.settings.button_dark.red }},{{ block.settings.button_dark.green }},{{ block.settings.button_dark.blue }};
    {% else %}
      --colors-button: {{ settings.colors_dark_button.red }},{{ settings.colors_dark_button.green }},{{ settings.colors_dark_button.blue }};
    {% endif %}
    {% if block.settings.button_text_dark.alpha != 0.0 %}
      --colors-button-text: {{ block.settings.button_text_dark.red }},{{ block.settings.button_text_dark.green }},{{ block.settings.button_text_dark.blue }};
    {% else %}
      --colors-button-text: {{ settings.colors_dark_button_text.red }},{{ settings.colors_dark_button_text.green }},{{ settings.colors_dark_button_text.blue }};
    {% endif %}
    {% if block.settings.button_hover_dark.alpha != 0.0 %}
      --colors-button-hover: rgb({{ block.settings.button_hover_dark.red }},{{ block.settings.button_hover_dark.green }},{{ block.settings.button_hover_dark.blue }});
    {% else %}
      --colors-button-hover: rgb({{ settings.colors_dark_button_hover.red }},{{ settings.colors_dark_button_hover.green }},{{ settings.colors_dark_button_hover.blue }});
    {% endif %}
    {% if block.settings.button_text_hover_dark.alpha != 0.0 %}
      --colors-button-text-hover: {{ block.settings.button_text_hover_dark.red }},{{ block.settings.button_text_hover_dark.green }},{{ block.settings.button_text_hover_dark.blue }};
    {% else %}
      --colors-button-text-hover: {{ settings.colors_dark_button_text_hover.red }},{{ settings.colors_dark_button_text_hover.green }},{{ settings.colors_dark_button_text_hover.blue }};
    {% endif %}
    {% if block.settings.textlink_color_dark.alpha != 0.0 %}
      --colors-text-link: {{ block.settings.textlink_color_dark.red }},{{ block.settings.textlink_color_dark.green }},{{ block.settings.textlink_color_dark.blue }};
    {% else %}
      --colors-text-link: {{ settings.colors_dark_text_link.red }},{{ settings.colors_dark_text_link.green }},{{ settings.colors_dark_text_link.blue }};
    {% endif %}
  }
  @media screen and (min-width: 768px) {
    .heading-{{ block.id }} {
      font-size: {{ heading_size }}rem;
    }
  }
{%- endstyle -%}
<div
  x-data="{ qId: '{{ block.id }}' }"
  x-cloak
  x-show="qId === currentQuestionId"
  x-transition:enter="transition-opacity duration-500 ease-in-out delay-200"
  x-transition:enter-start="opacity-0"
  x-transition:enter-end="opacity-100"
  x-transition:leave="!absolute inset-0 transition-opacity duration-200 ease-in-out"
  x-transition:leave-start="opacity-100"
  x-transition:leave-end="opacity-0"
  data-block-id="{{ block.id }}"
  data-block-type="email-form"
  data-success-message="{{ block.settings.success_message | escape }}"
  data-question-id="{{ block.id }}"
  data-question-type="single"
  class="relative quiz-question quiz-email-form quiz-email-form-{{ block.id }} w-full grow flex flex-col gap-6{% if block.settings.image_position == 'left' %} md:flex-row{% else %} md:flex-row-reverse{% endif %} {% if section.settings.full_width_mobile %} pl-5 pr-5{% else %} pl-0 pr-0{% endif %}{% if section.settings.full_width %} md:pl-10 md:pr-10{% endif %} x-pgw page-width"
  {{ block.shopify_attributes }}
>
  {% liquid
    assign image = block.settings.image
    assign image_mobile = block.settings.image_mobile | default: image
  %}
  {% if image != blank or image_mobile != blank %}
    <div class="quiz-email-form__img grow quiz-email-form__img-{{ block.id }} relative w-full md:w-1/2{% if image == blank %} block md:hidden{% endif %}{% if settings.edges_type == 'rounded_corners' %} rounded-md overflow-hidden{% endif %}">
      {%- if image != blank -%}
        <img
          class="{% if image_mobile != blank %} hidden md:block{% endif %} absolute inset-0 w-full h-full object-cover object-center"
          srcset="{{ image | image_url: width: 375 }} 375w,
            {{ image | image_url: width: 500 }} 500w,
            {{ image | image_url: width: 750 }} 750w,
            {{ image | image_url: width: 1100 }} 1100w,
            {{ image | image_url: width: 1500 }} 1500w"
          sizes="50vw"
          src="{{ image | image_url: width: 1500 }}"
          loading="{{ loading }}"
          alt="{{ image.alt | escape }}"
          width="{{ image.width }}"
          height="{{ image.height }}"
          style="object-position: {{ image.presentation.focal_point }};"
        >
      {%- endif -%}
      {%- if image_mobile != blank -%}
        <img
          class="md:hidden absolute inset-0 w-full h-full object-cover object-center"
          srcset="{{ image_mobile | image_url: width: 375 }} 375w,
            {{ image_mobile | image_url: width: 375 }} 500w,
            {{ image_mobile | image_url: width: 750 }} 750w,
            {{ image_mobile | image_url: width: 900 }} 900w"
          sizes="100vw"
          src="{{ image_mobile | image_url: width: 900 }}"
          loading="{{ loading }}"
          alt="{{ image_mobile.alt | escape }}"
          width="{{ image_mobile.width }}"
          height="{{ image_mobile.height }}"
          style="object-position: {{ image_mobile.presentation.focal_point }};"
        >
      {%- endif -%}
    </div>
  {% endif %}
  <div class="quiz-email-content-container flex flex-col grow w-full{% if image != blank %} md:w-1/2{% endif %}">
    <div class="quiz-email-form__header quiz-email-form__header-{{ block.id }} mt-5 mb-5">
      {%- if block.settings.heading != blank -%}
        <div class="heading-{{ block.id }} text-[rgba(var(--colors-heading))]">
          {% render 'heading-highlight',
            headingId: block.id,
            heading: block.settings.heading,
            highlight_type: block.settings.highlight_type,
            color_heading_highlight_light: block.settings.heading_highlight_color_light,
            color_heading_highlight_dark: block.settings.heading_highlight_color_dark,
            class: 'h2 block leading-tight',
            heading_tag: block.settings.heading_tag,
            animation_heading: true,
            run_on_intersect: true
          %}
        </div>
      {%- endif -%}
      {%- if block.settings.text != blank -%}
        <div class="rte mt-2 text-[rgb(var(--colors-text))]">{{ block.settings.text }}</div>
      {%- endif -%}
    </div>
    <div class="flex h-0 grow items-center">
      <div class="w-full max-h-full overflow-y-auto scrollbar-body pl-1 pr-1">
        <div @submit.capture.prevent="submitEmailForm($event, '{{ block.id }}')" class="quiz-email-form__form w-full max-w-xl {{ form_alignment }}">
          {%- form 'contact', id: form_id, class: 'eurus' -%}
            <div>
              <label class="block mb-2 text-[rgb(var(--colors-text))]" for="{{ input_id }}">
                {{- email_label -}}
                <span aria-hidden="true">*</span>
              </label>
              <input
                id="{{ input_id }}"
                type="email"
                name="contact[email]"
                x-init="emailValue = $el.value"
                @input="emailValue = $el.value"
                class="w-full pl-5 pr-5 lg:pl-6 lg:pr-6 pt-3 pb-3 md:pt-3.5 md:pb-3.5 border focus:outline-none focus:border-current input bg-transparent{% if settings.edges_type == 'rounded_corners' %} !rounded-md{% endif %}"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                placeholder="{{ 'customer.email' | t }}"
                autocomplete="email"
                autocapitalize="off"
                autocorrect="off"
                aria-required="true"
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="{{ error_id }}"
                  autofocus
                {% endif %}
                required
              >
              {%- if form.errors -%}
                <p
                  id="{{ error_id }}"
                  class="flex items-center pl-4 pr-4 pt-3 pb-3 mt-3 bg-[rgba(var(--color-error),0.2)] selection:bg-[rgba(var(--color-error),0.4)]"
                  role="alert"
                  aria-live="assertive"
                >
                  <span class="text-[rgba(var(--color-error))] inline-block w-5 mr-2 rtl:mr-0 rtl:ml-2">
                    {% render 'icon-alls', icon: 'icon-error' %}
                  </span>
                  {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
                </p>
              {%- endif -%}
              <div class="button-quiz-{{ block.id }} mt-5 w-full flex justify-{{ heading_alignment }} rtl:justify-{{ rtl_alignment }}">
                <div class="flex flex-col w-fit">
                  <button
                    type="submit"
                    :disabled="!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(emailValue.trim()) || emailSubmitting"
                    class="button button-solid relative w-fit self-center disabled:cursor-not-allowed disabled:opacity-30 cursor-pointer pt-3 pb-3 pl-6 pr-6 leading-normal text-center font-semibold"
                  >
                    <span :class="emailSubmitting && 'invisible'">
                      {% render 'button-label', button_label: button_label, show_button_style: 'primary' %}
                    </span>
                    <div x-show="emailSubmitting" class="w-4 h-4 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
                      {% render 'icon-alls', icon: 'icon-loading' %}
                    </div>
                  </button>
                  {%- if block.settings.skip_button_label != blank -%}
                    <div class="button-quiz-{{ block.id }} mt-2 flex self-center text-center">
                      <div
                        role="button"
                        tabindex="0"
                        @click.prevent="skipEmailForm('{{ block.id }}')"
                        @keydown.enter.prevent="$el.click()"
                        @keydown.space.prevent="$el.click()"
                        class="button-link relative w-fit leading-normal cursor-pointer empty:hidden text-[rgb(var(--colors-text-link))]"
                      >
                        <span :class="emailSkipping && 'invisible'">{{ block.settings.skip_button_label }}</span>
                        <div x-show="emailSkipping" class="w-4 h-4 absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
                          {% render 'icon-alls', icon: 'icon-loading' %}
                        </div>
                      </div>
                    </div>
                  {%- endif -%}
                </div>
              </div>
            </div>
            {%- if section.settings.heading != blank -%}
              <input type="hidden" name="contact[quiz_submission]" value="{{ section.settings.heading | escape }}">
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>
    </div>
    {%- if block.settings.note != blank -%}
      <div class="rte mt-2 text-[rgb(var(--colors-text))] text-{{ heading_alignment }} rtl:text-{{ rtl_alignment }}">{{ block.settings.note }}</div>
    {%- endif -%}
  </div>
</div>
{% schema %}
{
  "name": "t:sections.quiz.blocks.email_form.name",
  "class": "quiz-block",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.quiz.blocks.email_form.settings.paragraph.content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.all.image.label"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:sections.promotion-banner.settings.image_mobile.label"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:sections.text-column-image.settings.image_position_desktop.label",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.content_alignment.options__1.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.content_alignment.options__3.label"
        }
      ],
      "default": "left",
      "info": "t:sections.main-collection-product-grid.settings.desktop_image_width.info"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.text.heading",
      "info": "t:settings_schema.typography.settings.heading_highlight_type.info"
    },
    {
      "type": "select",
      "id": "highlight_type",
      "default": "underline",
      "label": "t:settings_schema.typography.settings.heading_highlight_type.label",
      "options": [
        {
          "value": "underline",
          "label": "t:settings_schema.typography.settings.heading_highlight_type.option__1.label"
        },
        {
          "value": "font_highlight",
          "label": "t:settings_schema.typography.settings.heading_highlight_type.option__3.label"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 50,
      "max": 200,
      "step": 10,
      "unit": "%",
      "label": "t:sections.all.text.heading_size",
      "default": 100
    },
    {
      "type": "select",
      "id": "heading_tag",
      "default": "h2",
      "label": "t:sections.all.text.heading_tag",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "p",
          "label": "p"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "default": "center",
      "label": "t:sections.all.text.heading_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.content_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.content_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.content_alignment.options__3.label"
        }
      ]
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings_schema.seo.business_description.label"
    },
    {
      "type": "text",
      "id": "email_label",
      "default": "Email",
      "label": "t:sections.quiz.blocks.email_form.settings.email_label.label"
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Submit",
      "label": "t:sections.all.button.label"
    },
    {
      "type": "text",
      "id": "skip_button_label",
      "default": "No thanks, just show me my results",
      "label": "t:sections.quiz.blocks.email_form.settings.skip_button_label.label"
    },
    {
      "type": "text",
      "id": "success_message",
      "default": "Thanks — we have received your answers.",
      "label": "t:sections.featured-product.blocks.back_in_stock_alert.settings.text_success.label"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "t:sections.quiz.settings.note.label",
      "default": "<p>We will only use your email to follow up about your quiz results.</p>"
    },
    {
      "type": "header",
      "content": "t:settings_schema.colors.name"
    },
    {
      "type": "color",
      "id": "background_color_light",
      "default": "rgba(0,0,0,0)",
      "label": "t:sections.all.background.background_color_light"
    },
    {
      "type": "color",
      "id": "heading_color_light",
      "default": "rgba(0,0,0,0)",
      "label": "t:sections.all.text.color_heading_light"
    },
    {
      "type": "color",
      "id": "heading_highlight_color_light",
      "default": "rgba(0,0,0,0)",
      "label": "t:sections.all.text.color_heading_highlight_light"
    },
    {
      "type": "color",
      "id": "text_color_light",
      "default": "rgba(0,0,0,0)",
      "label": "t:sections.all.text.color"
    },
    {
      "type": "color",
      "id": "button_light",
      "label": "t:sections.all.button.primary_button_light",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "button_text_light",
      "label": "t:sections.all.button.primary_button_text_light",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "button_hover_light",
      "label": "t:sections.all.button.primary_button_hover_light",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "button_text_hover_light",
      "label": "t:sections.all.button.primary_button_hover_text_light",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "textlink_color_light",
      "label": "t:sections.main-collection-banner.block.textlink_color_light",
      "default": "rgba(0,0,0,0)"
    },
    {
      "type": "color",
      "id": "background_color_dark",
      "default": "rgba(0,0,0,0)",
      "label": "t:sections.all.background.background_color_dark",
      "visible_if": "{{ settings.theme_mode_enabled }}"
    },
    {
      "type": "color",
      "id": "heading_color_dark",
      "default": "rgba(0,0,0,0)",
      "label": "t:sections.all.text.color_heading_dark",
      "visible_if": "{{ settings.theme_mode_enabled }}"
    },
    {
      "type": "color",
      "id": "heading_highlight_color_dark",
      "default": "rgba(0,0,0,0)",
      "label": "t:sections.all.text.color_heading_highlight_dark",
      "visible_if": "{{ settings.theme_mode_enabled }}"
    },
    {
      "type": "color",
      "id": "text_color_dark",
      "default": "rgba(0,0,0,0)",
      "label": "t:sections.all.text.color_dark",
      "visible_if": "{{ settings.theme_mode_enabled }}"
    },
    {
      "type": "color",
      "id": "button_dark",
      "label": "t:sections.all.button.primary_button_dark",
      "default": "rgba(0,0,0,0)",
      "visible_if": "{{ settings.theme_mode_enabled }}"
    },
    {
      "type": "color",
      "id": "button_text_dark",
      "label": "t:sections.all.button.primary_button_text_dark",
      "default": "rgba(0,0,0,0)",
      "visible_if": "{{ settings.theme_mode_enabled }}"
    },
    {
      "type": "color",
      "id": "button_hover_dark",
      "label": "t:sections.all.button.primary_button_hover_dark",
      "default": "rgba(0,0,0,0)",
      "visible_if": "{{ settings.theme_mode_enabled }}"
    },
    {
      "type": "color",
      "id": "button_text_hover_dark",
      "label": "t:sections.all.button.primary_button_hover_text_dark",
      "default": "rgba(0,0,0,0)",
      "visible_if": "{{ settings.theme_mode_enabled }}"
    },
    {
